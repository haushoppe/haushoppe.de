# Cloudflare Pages header rules (ASCII only - non-ASCII comments break the parser).
# Only the hashed, content-addressed build assets get immutable long caching: their file name
# changes whenever the content changes, so a stale copy is impossible. Everything else
# (logo.svg, favicon.svg, /media/*, /js/* - all STABLE names) keeps the Pages default
# (max-age=0, must-revalidate) so edits show up immediately instead of being stuck in the
# browser cache for days. HTML also keeps that default.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
