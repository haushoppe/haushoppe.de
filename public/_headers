# Cloudflare Pages header rules (ASCII only - non-ASCII comments broke the parser and
# invalidated the whole file). Hashed build assets are immutable -> cache 1 year, so the
# browser stops re-validating every asset on each navigation. HTML keeps the default
# (max-age=0, must-revalidate).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800

/logo.svg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# Stable-named public JS is content-versioned via ?v=<hash> (see docs/cache-busting.md), so a
# changed file gets a new URL. Immutable 1-year cache is therefore safe and needs no purge.
/js/*
  Cache-Control: public, max-age=31536000, immutable
