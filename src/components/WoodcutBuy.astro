---
// Direktkauf-Box für Holzschnitte (fester Preis 785 EUR, versandkostenfrei). Rendert PayPal Smart
// Buttons, die die Bestellung server-seitig über die Cloudflare-Functions anlegen und abbuchen —
// der API-Key bleibt geschützt. „Möglichst wenig Klicks": PayPal erhebt die Lieferadresse selbst
// (GET_FROM_FILE), Zahlung + Adresse landen im PayPal-Konto (keine Bestätigungsmail).
//
// Graceful Degradation: Ohne konfigurierte Functions/Keys (z. B. lokaler `astro preview`, e2e-
// Server) liefert /api/paypal/config kein enabled -> die Buttons erscheinen nicht, der darunter
// liegende E-Mail-CTA bleibt der Kaufweg. Die Box selbst wird immer server-seitig gerendert.
import { WOODCUT_PRICE_EUR } from '../lib/pricing';

interface Props {
  slug: string;
  lang?: 'de' | 'en';
  title?: string;
}
const { slug, lang = 'de', title = '' } = Astro.props;
const price = `${WOODCUT_PRICE_EUR} €`;
const t =
  lang === 'en'
    ? {
        heading: 'Buy this woodcut',
        note: 'incl. 7% VAT · free shipping',
        dachNote: 'Shipping currently only within Germany, Austria and Switzerland.',
        dach: 'Shipping is currently only available within Germany, Austria and Switzerland. Nothing has been charged.',
        secure: 'Secure payment via PayPal or card. PayPal shares your shipping address with us.',
        // Rechtlich zentral: Vertragsschluss erst mit Versand (die Bestätigung ist keine Annahme).
        contract: 'The contract of sale is concluded only upon shipment of the goods.',
        thanks: 'Thank you! We have received your order. You will get a confirmation by email.',
        failed: 'Payment could not be completed. Please try again or enquire by email.',
        withdrawal: 'Right of withdrawal',
        terms: 'Terms',
        privacy: 'Privacy',
        hrefWithdrawal: '/right-of-withdrawal/',
        hrefTerms: '/terms/',
        hrefPrivacy: '/privacy/',
      }
    : {
        heading: 'Diesen Holzschnitt kaufen',
        note: 'inkl. 7 % MwSt · versandkostenfrei',
        dachNote: 'Versand aktuell nur innerhalb von Deutschland, Österreich und der Schweiz.',
        dach: 'Der Versand ist aktuell nur innerhalb von Deutschland, Österreich und der Schweiz möglich. Es wurde nichts abgebucht.',
        secure: 'Sichere Zahlung mit PayPal oder Karte. PayPal übermittelt uns Ihre Lieferadresse.',
        contract: 'Der Kaufvertrag kommt erst mit dem Versand der Ware zustande.',
        thanks: 'Vielen Dank! Ihre Bestellung ist bei uns eingegangen. Sie erhalten eine Bestätigung per E-Mail.',
        failed: 'Die Zahlung konnte nicht abgeschlossen werden. Bitte erneut versuchen oder per E-Mail anfragen.',
        withdrawal: 'Widerrufsrecht',
        terms: 'AGB',
        privacy: 'Datenschutz',
        hrefWithdrawal: '/widerruf/',
        hrefTerms: '/agb/',
        hrefPrivacy: '/datenschutz/',
      };
---

<section class="wc-buy" data-testid="paypal-buy" data-slug={slug} data-lang={lang} data-title={title}>
  <h2 class="wc-buy__heading">{t.heading}</h2>
  <p class="wc-buy__price" data-testid="artwork-price">
    {price}
    <span class="wc-buy__note">{t.note}</span>
  </p>
  <div class="wc-buy__buttons" data-testid="paypal-buttons"></div>
  <p class="wc-buy__fineprint">{t.secure} {t.dachNote} {t.contract}</p>
  <p class="wc-buy__links">
    <a href={t.hrefWithdrawal}>{t.withdrawal}</a> · <a href={t.hrefTerms}>{t.terms}</a> · <a href={t.hrefPrivacy}>{t.privacy}</a>
  </p>
  <p class="wc-buy__status" data-testid="paypal-status" role="status" hidden></p>
</section>

<script define:vars={{ slug, lang, title, thanksMsg: t.thanks, failedMsg: t.failed, dachMsg: t.dach }}>
  (function () {
    let section = null;
    try {
      section = document.querySelector('.wc-buy[data-slug="' + CSS.escape(slug) + '"]');
    } catch (e) {
      // sehr alter Browser ohne CSS.escape -> Fallback auf die (einzige) Box der Seite
    }
    if (!section) section = document.querySelector('.wc-buy');
    if (!section) return;
    const mount = section.querySelector('.wc-buy__buttons');
    const statusEl = section.querySelector('.wc-buy__status');
    const showStatus = function (msg, ok) {
      statusEl.textContent = msg;
      statusEl.hidden = false;
      statusEl.classList.toggle('is-ok', !!ok);
      statusEl.classList.toggle('is-err', !ok);
    };

    // Server-Config holen (Client-ID + sandbox/live). Fehlt sie (keine Functions/kein Key),
    // bleibt die Box ohne Buttons — der E-Mail-CTA darunter übernimmt.
    fetch('/api/paypal/config')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (cfg) {
        if (!cfg || !cfg.enabled || !cfg.clientId) return;
        const params = new URLSearchParams({
          'client-id': cfg.clientId,
          currency: cfg.currency || 'EUR',
          intent: 'capture',
          components: 'buttons',
        });
        const sdk = document.createElement('script');
        sdk.src = 'https://www.paypal.com/sdk/js?' + params.toString();
        sdk.onload = renderButtons;
        document.head.appendChild(sdk);
      })
      .catch(function () {});

    function renderButtons() {
      if (!window.paypal || !window.paypal.Buttons) return;
      window.paypal
        .Buttons({
          style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'paypal' },
          createOrder: function () {
            return fetch('/api/paypal/create-order', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ slug: slug, title: title, lang: lang }),
            })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                if (!d || !d.id) throw new Error('create failed');
                return d.id;
              });
          },
          onApprove: function (data) {
            return fetch('/api/paypal/capture-order', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ orderID: data.orderID, lang: lang }),
            })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                // COMPLETED ODER PENDING (z. B. eCheck) = Bestellung aufgegeben -> Danke.
                if (d && (d.status === 'COMPLETED' || d.status === 'PENDING')) {
                  mount.hidden = true;
                  showStatus(thanksMsg, true);
                } else if (d && d.error === 'shipping_country') {
                  showStatus(dachMsg, false);
                } else {
                  showStatus(failedMsg, false);
                }
              })
              .catch(function () { showStatus(failedMsg, false); });
          },
          onError: function () { showStatus(failedMsg, false); },
        })
        .render(mount);
    }
  })();
</script>

<style>
  /* Kauf-Box: ruhige, eckige Karte mit Hairline, damit die (goldenen) PayPal-Buttons wirken. */
  .wc-buy {
    max-width: 420px;
    margin: 1.75rem auto 0;
    padding: 1.4rem 1.5rem 1.5rem;
    border: 1px solid var(--ink, #111);
    text-align: center;
  }
  .wc-buy__heading {
    margin: 0 0 0.35rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.15rem;
  }
  .wc-buy__price {
    margin: 0 0 1.1rem;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .wc-buy__note {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--fs-xs);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #6a6a6a;
  }
  /* Reserviert etwas Höhe, damit beim Nachladen der Buttons nichts springt. */
  .wc-buy__buttons {
    min-height: 3rem;
  }
  /* Kleingedrucktes (Zahlung, Versandraum, Vertragsschluss) als EIN Absatz, eine Größe. */
  .wc-buy__fineprint {
    margin: 0.9rem 0 0;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: #6a6a6a;
  }
  .wc-buy__links {
    margin: 0.5rem 0 0;
    font-size: var(--fs-xs);
  }
  .wc-buy__links a {
    color: #4a4a4a;
    text-decoration: underline;
  }
  .wc-buy__status {
    margin: 0.9rem 0 0;
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .wc-buy__status.is-ok {
    color: #1a7f37;
  }
  .wc-buy__status.is-err {
    color: #b42318;
  }
</style>
