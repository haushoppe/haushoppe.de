---
// Direktkauf-Box für Holzschnitte in zwei Ausführungen: ungerahmt (785 EUR) oder fertig gerahmt
// im HALBE-Museumsrahmen (1000 EUR), beides versandkostenfrei. Die Ausführung wählt der Käufer
// über zwei Auswahl-Karten; die gewählte Variante geht als Schlüssel an create-order, der Server
// setzt den Betrag aus seiner Preistabelle (keine Preis-Manipulation vom Client möglich).
// Rendert PayPal Smart Buttons über die Cloudflare-Functions — der API-Key bleibt geschützt.
// PayPal erhebt die Lieferadresse selbst (GET_FROM_FILE), Zahlung + Adresse landen im PayPal-Konto.
//
// Button-Lösung (§ 312j Abs. 3, 4 BGB): Die Bestellung gibt ausschließlich der eigene Button
// „Zahlungspflichtig bestellen" ab. Der PayPal-Button gibt nur die Zahlung frei (SDK mit
// commit=false, PayPal beschriftet seinen Abschluss dann mit „Weiter"); abgebucht wird erst mit dem
// eigenen Button. Ohne diese Beschriftung käme mit Verbrauchern kein wirksamer Vertrag zustande.
// In dieser Kassen-Stufe, unmittelbar vor dem Button, steht die EU-Mitteilung zur gesetzlichen
// Gewährleistung als vollständige Grafik (Art. 246a § 1 Abs. 1 Nr. 11 EGBGB, „in hervorgehobener
// Weise"; Gestaltung DVO (EU) 2025/1960). Bewusst nicht hinter einem Link: Die DVO erlaubt die
// verschachtelte Anzeige nur für das GARAN-Label (Erwägungsgrund 14), nicht für die Mitteilung.
// Die Box wird dafür breiter, damit der Text der Grafik lesbar bleibt.
//
// Graceful Degradation: Ohne konfigurierte Functions/Keys (z. B. lokaler `astro preview`, e2e-
// Server) liefert /api/paypal/config kein enabled -> die Buttons erscheinen nicht, der darunter
// liegende E-Mail-CTA bleibt der Kaufweg. Die Box selbst wird immer server-seitig gerendert.
import { woodcutPrice } from '../lib/pricing';
import GuaranteeNotice from './GuaranteeNotice.astro';

interface Props {
  slug: string;
  lang?: 'de' | 'en';
  title?: string;
  // Testmodus für die versteckte Seite /testkauf/: eine einzige Variante „Testprodukt" zu 0,01 €.
  // Preis und Bezeichnung setzt der Server (TEST_PRODUCT in functions/api/paypal/_paypal.js).
  test?: boolean;
}
const { slug, lang = 'de', title = '', test = false } = Astro.props;
const price = woodcutPrice(lang);
const t =
  lang === 'en'
    ? {
        heading: 'Buy this woodcut',
        note: 'incl. 7% VAT · free shipping within Germany · delivery within 7 days',
        legend: 'Choose your version',
        unframed: 'Unframed',
        unframedDesc: 'The woodcut, numbered and hand-signed',
        framed: 'Framed',
        framedDesc: 'The woodcut, numbered and hand-signed. High-quality HALBE® frame: aluminium magnetic frame, museum glass, acid-free passe-partout. Ready to hang.',
        dachNote: 'Online orders currently ship to addresses in Germany only. For other countries, please email us at team@haushoppe.de.',
        dach: 'We can currently only ship online orders to addresses in Germany. Nothing has been charged. For delivery to another country, please email us at team@haushoppe.de.',
        secure: 'Secure payment via PayPal or card. PayPal shares your shipping address with us.',
        // Rechtlich zentral: Vertragsschluss erst mit Versand (die Bestätigung ist keine Annahme).
        contract: 'The contract of sale is concluded only upon shipment of the goods.',
        confirmIntro: 'Payment approved. Nothing has been charged yet. Your order:',
        order: 'Order with obligation to pay',
        cancel: 'Cancel or change version',
        declined: 'This payment method was declined. Nothing has been charged. Please choose another payment method via PayPal.',
        thanks: 'Thank you! We have received your order. You will get a confirmation by email.',
        failed: 'Payment could not be completed. Please try again or enquire by email.',
        withdrawal: 'Right of withdrawal',
        terms: 'Terms',
        privacy: 'Privacy',
        hrefWithdrawal: '/right-of-withdrawal/',
        hrefTerms: '/terms/',
        hrefPrivacy: '/privacy/',
      }
    : {
        heading: 'Diesen Holzschnitt kaufen',
        note: 'inkl. 7 % MwSt · versandkostenfrei innerhalb Deutschlands · Lieferung innerhalb von 7 Tagen',
        legend: 'Ausführung wählen',
        unframed: 'Ungerahmt',
        unframedDesc: 'Der Holzschnitt, nummeriert und handsigniert',
        framed: 'Gerahmt',
        framedDesc: 'Der Holzschnitt, nummeriert und handsigniert. Hochwertiger Rahmen von HALBE®: Alu-Magnetrahmen, Museumsglas, säurefreies Passepartout. Fertig zum Aufhängen.',
        dachNote: 'Online-Bestellung derzeit nur mit Lieferadresse in Deutschland. Für andere Länder schreiben Sie uns bitte an team@haushoppe.de.',
        dach: 'Online-Bestellungen können wir derzeit nur an Lieferadressen in Deutschland versenden. Es wurde nichts abgebucht. Für eine Lieferung in ein anderes Land schreiben Sie uns bitte an team@haushoppe.de.',
        secure: 'Sichere Zahlung mit PayPal oder Karte. PayPal übermittelt uns Ihre Lieferadresse.',
        contract: 'Der Kaufvertrag kommt erst mit dem Versand der Ware zustande.',
        confirmIntro: 'Zahlung freigegeben. Es wurde noch nichts abgebucht. Ihre Bestellung:',
        order: 'Zahlungspflichtig bestellen',
        cancel: 'Abbrechen oder Ausführung ändern',
        declined: 'Die Zahlungsart wurde abgelehnt. Es wurde nichts abgebucht. Bitte wählen Sie über PayPal eine andere Zahlungsart.',
        thanks: 'Vielen Dank! Ihre Bestellung ist bei uns eingegangen. Sie erhalten eine Bestätigung per E-Mail.',
        failed: 'Die Zahlung konnte nicht abgeschlossen werden. Bitte erneut versuchen oder per E-Mail anfragen.',
        withdrawal: 'Widerrufsrecht',
        terms: 'AGB',
        privacy: 'Datenschutz',
        hrefWithdrawal: '/widerruf/',
        hrefTerms: '/agb/',
        hrefPrivacy: '/datenschutz/',
      };
---

<section class="wc-buy" data-testid="paypal-buy" data-slug={slug} data-lang={lang} data-title={title}>
  <h2 class="wc-buy__heading">{t.heading}</h2>
  <div class="wc-buy__pricing" data-testid="artwork-price">
    <fieldset class="wc-buy__variants">
      <legend class="visually-hidden">{t.legend}</legend>
      {test ? (
      <label class="wc-buy__variant">
        <input class="wc-buy__variant-input" type="radio" name={`wc-variant-${slug}`} value="test" checked />
        <span class="wc-buy__variant-body">
          <span class="wc-buy__variant-head">
            <span class="wc-buy__variant-name">{lang === 'en' ? 'Test product' : 'Testprodukt'}</span>
            <span class="wc-buy__variant-price">{lang === 'en' ? '0.01 €' : '0,01 €'}</span>
          </span>
          <span class="wc-buy__variant-desc">{lang === 'en' ? 'Test order to check the purchase flow. Will not be shipped.' : 'Testbestellung zum Prüfen des Kaufablaufs. Wird nicht versendet.'}</span>
        </span>
      </label>
      ) : (<>
      <label class="wc-buy__variant">
        <input class="wc-buy__variant-input" type="radio" name={`wc-variant-${slug}`} value="unframed" checked />
        <span class="wc-buy__variant-body">
          <span class="wc-buy__variant-head">
            <span class="wc-buy__variant-name">{t.unframed}</span>
            <span class="wc-buy__variant-price">{price.amount}</span>
          </span>
          <span class="wc-buy__variant-desc">{t.unframedDesc}</span>
        </span>
      </label>
      <label class="wc-buy__variant">
        <input class="wc-buy__variant-input" type="radio" name={`wc-variant-${slug}`} value="framed" />
        <span class="wc-buy__variant-body">
          <span class="wc-buy__variant-head">
            <span class="wc-buy__variant-name">{t.framed}</span>
            <span class="wc-buy__variant-price">{price.amountFramed}</span>
          </span>
          <span class="wc-buy__variant-desc">{t.framedDesc}</span>
        </span>
      </label>
      </>)}
    </fieldset>
    <p class="wc-buy__note">{t.note}</p>
  </div>
  <div class="wc-buy__buttons" data-testid="paypal-buttons"></div>
  <div class="wc-buy__confirm" data-testid="paypal-confirm" hidden>
    <p class="wc-buy__confirm-intro">{t.confirmIntro}</p>
    <p class="wc-buy__summary" data-testid="paypal-summary"></p>
    <div class="wc-buy__guarantee">
      <GuaranteeNotice lang={lang} />
    </div>
    <button type="button" class="btn btn--dark wc-buy__order" data-testid="paypal-order">{t.order}</button>
    <button type="button" class="wc-buy__cancel" data-testid="paypal-cancel">{t.cancel}</button>
  </div>
  <p class="wc-buy__fineprint">{t.secure} {t.dachNote} {t.contract}</p>
  <p class="wc-buy__links">
    <a href={t.hrefWithdrawal}>{t.withdrawal}</a> · <a href={t.hrefTerms}>{t.terms}</a> · <a href={t.hrefPrivacy}>{t.privacy}</a>
  </p>
  <p class="wc-buy__status" data-testid="paypal-status" role="status" hidden></p>
</section>

{/* data-astro-rerun: der ClientRouter dedupliziert Inline-Skripte über den Textinhalt — ohne das
    Attribut liefe das Skript beim erneuten Besuch derselben Werk-Seite (View Transition) nicht
    und die Kaufbox bliebe ohne Buttons. */}
<script define:vars={{ slug, lang, title, thanksMsg: t.thanks, failedMsg: t.failed, dachMsg: t.dach, declinedMsg: t.declined, noteText: t.note }} data-astro-rerun>
  (function () {
    let section = null;
    try {
      section = document.querySelector('.wc-buy[data-slug="' + CSS.escape(slug) + '"]');
    } catch (e) {
      // sehr alter Browser ohne CSS.escape -> Fallback auf die (einzige) Box der Seite
    }
    if (!section) section = document.querySelector('.wc-buy');
    if (!section) return;
    const mount = section.querySelector('.wc-buy__buttons');
    const confirmEl = section.querySelector('.wc-buy__confirm');
    const summaryEl = section.querySelector('.wc-buy__summary');
    const orderBtn = section.querySelector('.wc-buy__order');
    const cancelBtn = section.querySelector('.wc-buy__cancel');
    const radios = section.querySelectorAll('.wc-buy__variant-input');
    const statusEl = section.querySelector('.wc-buy__status');
    const showStatus = function (msg, ok) {
      statusEl.textContent = msg;
      statusEl.hidden = false;
      statusEl.classList.toggle('is-ok', !!ok);
      statusEl.classList.toggle('is-err', !ok);
    };

    // Server-Config holen (Client-ID + sandbox/live). Fehlt sie (keine Functions/kein Key),
    // bleibt die Box ohne Buttons — der E-Mail-CTA darunter übernimmt. Ist das SDK schon geladen
    // (Rückkehr per View Transition), direkt rendern statt es erneut einzuhängen.
    function boot() {
      fetch('/api/paypal/config')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (cfg) {
        if (!cfg || !cfg.enabled || !cfg.clientId) return;
        if (window.paypal && window.paypal.Buttons) {
          renderButtons();
          return;
        }
        const params = new URLSearchParams({
          'client-id': cfg.clientId,
          currency: cfg.currency || 'EUR',
          intent: 'capture',
          // Nur Freigabe: PayPal beschriftet seinen Abschluss mit „Weiter" statt „Jetzt bezahlen",
          // die Bestellung gibt danach der eigene Button ab (Button-Lösung, siehe Kopfkommentar).
          commit: 'false',
          components: 'buttons',
        });
        const sdk = document.createElement('script');
        sdk.src = 'https://www.paypal.com/sdk/js?' + params.toString();
        sdk.onload = renderButtons;
        document.head.appendChild(sdk);
      })
      .catch(function () {});
    }

    // Das PayPal-SDK (~44 KiB) erst laden, wenn die Kaufbox in Sichtweite kommt: Besucher, die nie
    // dorthin scrollen, holen es gar nicht. rootMargin startet es kurz vorher.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(function (entries) {
        for (let i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) { io.disconnect(); boot(); return; }
        }
      }, { rootMargin: '400px 0px' });
      io.observe(section);
    } else {
      boot();
    }

    // Freigegebene PayPal-Bestellung. Solange sie offen ist, ist die Ausführung gesperrt, weil der
    // Betrag der Freigabe feststeht.
    let approvedId = null;
    function setApproved(on) {
      section.classList.toggle('is-checkout', on);
      mount.hidden = on;
      confirmEl.hidden = !on;
      orderBtn.disabled = false;
      for (let i = 0; i < radios.length; i++) radios[i].disabled = on;
      if (on) {
        const sel = section.querySelector('.wc-buy__variant-input:checked');
        const card = sel ? sel.closest('.wc-buy__variant') : null;
        const name = card ? card.querySelector('.wc-buy__variant-name').textContent : '';
        const price = card ? card.querySelector('.wc-buy__variant-price').textContent : '';
        const q = lang === 'en' ? ['“', '”'] : ['„', '“'];
        summaryEl.textContent = q[0] + title + q[1] + ', ' + name + ': ' + price + ' (' + noteText + ')';
        statusEl.hidden = true;
      } else {
        approvedId = null;
      }
    }
    cancelBtn.addEventListener('click', function () { setApproved(false); });

    orderBtn.addEventListener('click', function () {
      if (!approvedId) return;
      orderBtn.disabled = true;
      fetch('/api/paypal/capture-order', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ orderID: approvedId, lang: lang }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          // COMPLETED ODER PENDING (z. B. eCheck) = Bestellung aufgegeben -> Danke.
          if (d && (d.status === 'COMPLETED' || d.status === 'PENDING')) {
            confirmEl.hidden = true;
            mount.hidden = true;
            showStatus(thanksMsg, true);
            return;
          }
          // Nichts abgebucht: zurück zur Auswahl, damit ein neuer Versuch möglich ist.
          setApproved(false);
          if (d && d.error === 'instrument_declined') showStatus(declinedMsg, false);
          else if (d && d.error === 'shipping_country') showStatus(dachMsg, false);
          else showStatus(failedMsg, false);
        })
        .catch(function () {
          setApproved(false);
          showStatus(failedMsg, false);
        });
    });

    function renderButtons() {
      if (!window.paypal || !window.paypal.Buttons) return;
      if (mount.childElementCount) return; // schon gerendert (doppelter Aufruf)
      window.paypal
        .Buttons({
          style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'paypal' },
          createOrder: function () {
            // Die im Moment des Kaufs gewählte Ausführung; der Server übersetzt den Schlüssel
            // in den Preis (Fallback server-seitig: ungerahmt).
            const sel = section.querySelector('.wc-buy__variant-input:checked');
            return fetch('/api/paypal/create-order', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ slug: slug, title: title, lang: lang, variant: sel ? sel.value : 'unframed' }),
            })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                if (!d || !d.id) throw new Error('create failed');
                return d.id;
              });
          },
          onApprove: function (data) {
            // Zahlung freigegeben, noch NICHT abgebucht. Erst das Lieferland prüfen, dann die
            // Kassen-Stufe (Zusammenfassung + eigener Bestellbutton). Scheitert die Prüfung technisch,
            // geht es trotzdem weiter: capture-order prüft das Land vor der Abbuchung erneut.
            return fetch('/api/paypal/check-order', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ orderID: data.orderID }),
            })
              .then(function (r) { return r.json(); })
              .catch(function () { return null; })
              .then(function (d) {
                if (d && d.country && d.allowed === false) {
                  showStatus(dachMsg, false);
                  return;
                }
                approvedId = data.orderID;
                setApproved(true);
              });
          },
          onError: function () { showStatus(failedMsg, false); },
        })
        .render(mount);
    }
  })();
</script>

<style>
  /* Kauf-Box: ruhige, eckige Karte mit Hairline, damit die (goldenen) PayPal-Buttons wirken. */
  .wc-buy {
    max-width: 420px;
    margin: 1.75rem auto 0;
    padding: 1.4rem 1.5rem 1.5rem;
    border: 1px solid var(--ink, #111);
    text-align: center;
  }
  .wc-buy__heading {
    margin: 0 0 1rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.15rem;
  }
  /* Zwei Auswahl-Karten (ungerahmt/gerahmt): linksbündige Zeilen mit Radio, Name + Preis in
     einer Kopfzeile, kurze Beschreibung darunter. Die gewählte Karte bekommt die dunkle Kante. */
  .wc-buy__variants {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    padding: 0;
    border: 0;
  }
  .wc-buy__variant {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.75rem 0.9rem;
    border: 1px solid #c9c9c9;
    text-align: left;
    cursor: pointer;
  }
  .wc-buy__variant:has(.wc-buy__variant-input:checked) {
    border-color: var(--ink, #111);
    box-shadow: inset 0 0 0 1px var(--ink, #111);
  }
  .wc-buy__variant-input {
    margin: 0.2rem 0 0;
    accent-color: var(--ink, #111);
    flex: none;
  }
  .wc-buy__variant-body {
    flex: 1;
  }
  .wc-buy__variant-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }
  .wc-buy__variant-name {
    font-weight: 600;
  }
  .wc-buy__variant-price {
    font-weight: 600;
    font-size: 1.1rem;
    white-space: nowrap;
  }
  .wc-buy__variant-desc {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--fs-xs);
    line-height: 1.45;
    color: #6a6a6a;
  }
  .wc-buy__note {
    margin: 0 0 1.1rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.02em;
    color: #6a6a6a;
  }
  /* Reserviert etwas Höhe, damit beim Nachladen der Buttons nichts springt. Eigener Stacking-Context
     (isolation): der von PayPal im iframe gesetzte hohe z-index bleibt darin gefangen und kann den
     sticky Header nicht mehr überdecken. Der Checkout-Popup hängt an <body> und bleibt frei oben. */
  .wc-buy__buttons {
    min-height: 3rem;
    isolation: isolate;
  }
  /* Kleingedrucktes (Zahlung, Versandraum, Vertragsschluss) als EIN Absatz, eine Größe. */
  /* Kassen-Stufe: breiter, damit die EU-Mitteilung (A4-Grafik) lesbar groß erscheint. */
  .wc-buy.is-checkout {
    max-width: 640px;
  }
  .wc-buy__guarantee {
    margin: 0.4rem 0;
  }
  .wc-buy__confirm {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    text-align: left;
  }
  .wc-buy__confirm-intro,
  .wc-buy__summary {
    margin: 0;
  }
  .wc-buy__summary {
    font-weight: 600;
  }
  .wc-buy__order {
    width: 100%;
  }
  .wc-buy__cancel {
    justify-self: center;
    padding: 0.2rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--fs-xs, 0.8rem);
    text-decoration: underline;
    cursor: pointer;
  }
  .wc-buy__variant-input:disabled + .wc-buy__variant-body {
    opacity: 0.55;
  }
  .wc-buy__fineprint {
    margin: 0.9rem 0 0;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: #6a6a6a;
  }
  .wc-buy__links {
    margin: 0.5rem 0 0;
    font-size: var(--fs-xs);
  }
  .wc-buy__links a {
    color: #4a4a4a;
    text-decoration: underline;
  }
  .wc-buy__status {
    margin: 0.9rem 0 0;
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .wc-buy__status.is-ok {
    color: #1a7f37;
  }
  .wc-buy__status.is-err {
    color: #b42318;
  }
</style>
