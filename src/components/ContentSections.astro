---
// Schlanker, semantischer Renderer für die einfachen Textseiten (Vita, Kontakt).
// Ersetzt den alten Gutenberg/Stackable-Aufbau durch saubere <h2>/<ul>/<p> — der
// Inhalt liegt editierbar in src/data/{vita,kontakt}.json.
interface Section {
  heading?: string;
  center?: boolean;
  legend?: string;
  subtitle?: string;
  lines?: string[];
  paragraphs?: string[];
  map?: string;
}
interface Props {
  hero?: { src: string; alt: string };
  title?: string;
  sections: Section[];
}
const { hero, title, sections } = Astro.props;
---

<div class="cp">
  {
    hero && (
      <div class="cp-hero">
        <img src={hero.src} alt={hero.alt} loading="eager" decoding="async" />
      </div>
    )
  }
  {title && <h1 class="entry-title">{title}</h1>}

  {
    sections.map((s) => (
      <section class:list={['cp-section', s.center && 'cp-section--center']}>
        {s.heading && <h2>{s.heading}</h2>}
        {s.subtitle && <p class="cp-subtitle">{s.subtitle}</p>}
        {s.legend && <p class="cp-legend" set:html={s.legend} />}
        {s.lines && (
          <ul class="cp-lines">
            {s.lines.map((l) => (
              <li set:html={l} />
            ))}
          </ul>
        )}
        {
          s.map ? (
            <div class="cp-dir">
              <div class="cp-dir__text">{s.paragraphs && s.paragraphs.map((p) => <p set:html={p} />)}</div>
              <div class="cp-map">
                <iframe
                  src={s.map}
                  title="Karte"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                />
              </div>
            </div>
          ) : (
            s.paragraphs && s.paragraphs.map((p) => <p set:html={p} />)
          )
        }
      </section>
    ))
  }
</div>

<style>
  .cp {
    max-width: 1100px;
    margin: 0 auto;
  }
  .cp-hero img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    display: block;
    border-radius: 2px;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .entry-title {
    margin: 0 0 1.5rem;
  }
  .cp-section {
    margin: 0 0 2.5rem;
  }
  .cp-section h2 {
    margin: 0 0 0.85rem;
  }
  .cp-subtitle {
    font-style: italic;
    color: #5f574d;
    margin: 0 0 1rem;
  }
  .cp-legend {
    margin: 0 0 0.9rem;
  }
  .cp-lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cp-lines li {
    margin: 0 0 0.35rem;
    line-height: 1.55;
  }
  .cp-lines li :global(strong) {
    display: inline-block;
    min-width: 5.5rem;
  }
  /* Zentrierte Blöcke (Kontakt: Öffnungszeiten, Adresse). */
  .cp-section--center {
    text-align: center;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
  .cp-section--center .cp-lines li {
    margin-bottom: 0.2rem;
  }
  .cp-section--center .cp-lines li :global(strong) {
    min-width: 0;
  }
  /* Anfahrt + Karte nebeneinander (wie live). */
  .cp-dir {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }
  .cp-dir__text p:first-child {
    margin-top: 0;
  }
  .cp-map {
    position: relative;
    aspect-ratio: 4 / 3;
    min-height: 320px;
  }
  .cp-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 2px;
  }
  @media (max-width: 720px) {
    .cp-dir {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .cp-lines li :global(strong) {
      display: block;
      min-width: 0;
    }
  }
</style>
