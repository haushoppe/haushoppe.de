---
// Stilisiertes „offenes Feuer verboten"-Zeichen: eine Flamme (mit typischer innerer Locke,
// klar als Feuer lesbar) im Verbotskreis. Monochrom (eine Farbe, Linien-Icon).
interface Props { label?: string; }
const { label = 'Offenes Feuer verboten' } = Astro.props;
---

<svg class="nofire" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={label}>
  <!-- Flamme, skaliert/zentriert (Basis-Icon im 24er-Raster) -->
  <g transform="translate(25.85 22.4) scale(2.3)" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
  </g>
  <!-- Verbotszeichen: Kreis + Querstrich -->
  <g fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round">
    <circle cx="50" cy="50" r="43.5" />
    <line x1="19.2" y1="19.2" x2="80.8" y2="80.8" />
  </g>
</svg>

<style>
  .nofire {
    display: block;
    width: 100%;
    height: 100%;
    color: #1a1a1a;
  }
</style>
