      fill="currentColor"
      fill-rule="evenodd"
      d="M41 3 C 51 19 61 34 62 51 C 66 42 71 33 76 33 C 84 40 89 55 85 72
         C 81 90 70 101 60 103 C 53 104 47 104 41 103 C 29 101 18 91 15 73
         C 12 61 14 42 25 26 C 31 16 37 8 41 3 Z
         M52 47 C 45 58 41 70 42 80 C 43 89 51 92 57 86 C 62 81 61 70 57 62
         C 55 57 53 52 52 47 Z"
    />
  </g>
</svg>

<style>
