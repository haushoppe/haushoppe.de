---
// Kleine In-Content-Slideshow: überblendet automatisch, mit Bildunterschrift + Punkten.
// Startet von allein; Pause bei Hover; respektiert prefers-reduced-motion (dann kein Autoplay,
// Punkte funktionieren weiter). Bilder als astro:assets (AVIF/WebP, responsiv).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CarouselArrow from './CarouselArrow.astro';

interface Slide { src: ImageMetadata; alt: string; caption?: string; }
interface Props { slides: Slide[]; interval?: number; lang?: 'de' | 'en'; }
const { slides, interval = 4500, lang = 'de' } = Astro.props;
const t = lang === 'en'
  ? { role: 'Image gallery', prev: 'Previous', next: 'Next', pick: (i: number, n: number) => `Image ${i} of ${n}` }
  : { role: 'Bildergalerie', prev: 'Zurück', next: 'Weiter', pick: (i: number, n: number) => `Bild ${i} von ${n}` };
---

<div class="slideshow" data-slideshow data-testid="slideshow" data-interval={interval} aria-roledescription={t.role}>
  <div class="slideshow__frame">
    {slides.map((s, i) => (
      <figure class="slideshow__slide" data-slide style={`opacity:${i === 0 ? 1 : 0}`} aria-hidden={i === 0 ? 'false' : 'true'}>
        <Image src={s.src} alt={s.alt} widths={[480, 820, 1200]} sizes="(max-width: 860px) 92vw, 800px" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        {s.caption && <figcaption class="slideshow__caption" data-testid="slideshow-caption">{s.caption}</figcaption>}
      </figure>
    ))}
    {slides.length > 1 && <CarouselArrow dir="prev" class="slideshow__arrow slideshow__arrow--prev" label={t.prev} data-ss-prev />}
    {slides.length > 1 && <CarouselArrow dir="next" class="slideshow__arrow slideshow__arrow--next" label={t.next} data-ss-next />}
  </div>
  <div class="slideshow__dots">
    {slides.map((_, i) => (
      <button type="button" class="carousel-dot" data-dot data-testid="slideshow-dot" aria-label={t.pick(i + 1, slides.length)} aria-current={i === 0 ? 'true' : 'false'} />
    ))}
  </div>
</div>

<script>
  function initSlideshows() {
    document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((root) => {
      if ((root as any).__ss) return;
      (root as any).__ss = true;
      const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
      if (slides.length < 2) return;
      const interval = Number(root.dataset.interval) || 4500;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let idx = 0;
      let timer: number | undefined;
      function show(n: number) {
        idx = (n + slides.length) % slides.length;
        slides.forEach((s, i) => {
          s.style.opacity = i === idx ? '1' : '0';
          s.setAttribute('aria-hidden', i === idx ? 'false' : 'true');
        });
        dots.forEach((d, i) => d.setAttribute('aria-current', i === idx ? 'true' : 'false'));
      }
      function stop() { if (timer) { clearInterval(timer); timer = undefined; } }
      function start() { if (reduced) return; stop(); timer = window.setInterval(() => show(idx + 1), interval); }
      dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
      root.querySelector<HTMLElement>('[data-ss-prev]')?.addEventListener('click', () => { show(idx - 1); start(); });
      root.querySelector<HTMLElement>('[data-ss-next]')?.addEventListener('click', () => { show(idx + 1); start(); });
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      show(0);
      start();
    });
  }
  if (!(window as any).__ssInit) {
    (window as any).__ssInit = true;
    document.addEventListener('astro:page-load', initSlideshows);
    initSlideshows();
  }
</script>

<style>
  .slideshow {
    margin: 1.5rem 0;
  }
  .slideshow__frame {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #ececec;
  }
  .slideshow__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    transition: opacity 0.7s ease;
  }
  .slideshow__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .slideshow__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 1.6rem 1rem 0.7rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0));
    color: #fff;
    font-size: var(--fs-sm);
    line-height: 1.4;
  }
  .slideshow__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  /* Pfeile über dem Bild, vertikal zentriert; runde Optik kommt aus <CarouselArrow>. */
  .slideshow__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
  }
  .slideshow__arrow--prev {
    left: 10px;
  }
  .slideshow__arrow--next {
    right: 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .slideshow__slide {
      transition: none;
    }
  }
</style>
