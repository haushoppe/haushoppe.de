---
// Kleine In-Content-Slideshow: überblendet automatisch, mit Bildunterschrift + Punkten.
// Startet von allein; Pause bei Hover; respektiert prefers-reduced-motion (dann kein Autoplay,
// Punkte funktionieren weiter). Bilder als astro:assets (WebP, responsiv).
// Lazy: nur das aktive und das nächste Bild werden geladen, die übrigen erst beim Aufblättern
// (die Slides liegen gestapelt „im Viewport", daher greift natives loading="lazy" hier nicht).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CarouselArrow from './CarouselArrow.astro';

interface Slide { src: ImageMetadata; alt: string; caption?: string; }
interface Props { slides: Slide[]; interval?: number; lang?: 'de' | 'en'; }
const { slides, interval = 4500, lang = 'de' } = Astro.props;
const t = lang === 'en'
  ? { role: 'Image gallery', prev: 'Previous', next: 'Next', pick: (i: number, n: number) => `Image ${i} of ${n}` }
  : { role: 'Bildergalerie', prev: 'Zurück', next: 'Weiter', pick: (i: number, n: number) => `Bild ${i} von ${n}` };

const SIZES = '(max-width: 860px) 92vw, 800px';
const rendered = await Promise.all(
  slides.map(async (s) => {
    const img = await getImage({ src: s.src, widths: [480, 820, 1200], sizes: SIZES, format: 'webp' });
    return { alt: s.alt, caption: s.caption, src: img.src, srcset: img.srcSet?.attribute ?? '', w: s.src.width, h: s.src.height };
  }),
);
---

<div class="slideshow" data-slideshow data-testid="slideshow" data-interval={interval} aria-roledescription={t.role}>
  <div class="slideshow__frame">
    {rendered.map((r, i) => (
      <figure class="slideshow__slide" data-slide style={`opacity:${i === 0 ? 1 : 0}`} aria-hidden={i === 0 ? 'false' : 'true'}>
        <img
          class="slideshow__img"
          src={i === 0 ? r.src : undefined}
          srcset={i === 0 ? r.srcset : undefined}
          data-src={r.src}
          data-srcset={r.srcset}
          sizes={SIZES}
          width={r.w}
          height={r.h}
          alt={r.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
        />
        {r.caption && <figcaption class="slideshow__caption" data-testid="slideshow-caption">{r.caption}</figcaption>}
      </figure>
    ))}
    {slides.length > 1 && <CarouselArrow dir="prev" class="slideshow__arrow slideshow__arrow--prev" label={t.prev} data-ss-prev />}
    {slides.length > 1 && <CarouselArrow dir="next" class="slideshow__arrow slideshow__arrow--next" label={t.next} data-ss-next />}
  </div>
  <div class="slideshow__dots">
    {rendered.map((_, i) => (
      <button type="button" class="carousel-dot" data-dot data-testid="slideshow-dot" aria-label={t.pick(i + 1, slides.length)} aria-current={i === 0 ? 'true' : 'false'} />
    ))}
  </div>
  <div class="visually-hidden" aria-live="polite" data-ss-status></div>
</div>

<style>
  .slideshow {
    margin: 1.5rem 0;
  }
  .slideshow__frame {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #ececec;
    /* Horizontales Wischen blättert (JS); vertikales Wischen scrollt die Seite. */
    touch-action: pan-y;
  }
  .slideshow__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    transition: opacity 0.7s ease;
  }
  .slideshow__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .slideshow__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 1.6rem 1rem 0.7rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0));
    color: #fff;
    font-size: var(--fs-sm);
    line-height: 1.4;
  }
  .slideshow__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  /* Pfeile über dem Bild, vertikal zentriert; runde Optik kommt aus <CarouselArrow>. */
  .slideshow__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
  }
  .slideshow__arrow--prev {
    left: 10px;
  }
  .slideshow__arrow--next {
    right: 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .slideshow__slide {
      transition: none;
    }
  }
</style>
