---
// Generischer, vollbreiter Banner (lockert Inhalte auf / Seiten-Hero). Liefert AVIF/WebP +
// responsive über astro:assets — kein rohes JPG mehr (gut für Lighthouse). Bild per `name`
// (Datei in src/assets/banners/) oder direkt als ImageMetadata. `hero` = oben auf der Seite
// (eager, kein oberer Abstand); ohne = Inhalts-Banner (lazy, Abstand oben+unten).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { bannerImage } from '../lib/banner-images';

interface Props {
  name?: string;
  image?: ImageMetadata;
  alt: string;
  hero?: boolean;
}
const { name, image, alt, hero = false } = Astro.props;
const img = image ?? (name ? bannerImage(name) : undefined);
if (!img) throw new Error(`Banner: Bild nicht gefunden (name="${name}")`);
---

<figure class:list={['banner', hero && 'banner--hero']}>
  <Picture
    src={img}
    formats={['avif', 'webp']}
    widths={[768, 1200, 1600]}
    sizes="100vw"
    alt={alt}
    loading={hero ? 'eager' : 'lazy'}
    decoding="async"
  />
</figure>

<style>
  .banner {
    margin-block: clamp(1.5rem, 4vw, 2.5rem);
  }
  /* Seiten-Hero: nur unten Abstand. */
  .banner--hero {
    margin-top: 0;
  }
  .banner :global(img) {
    width: 100%;
    height: clamp(200px, 30vw, 420px);
    object-fit: cover;
    display: block;
  }
</style>
