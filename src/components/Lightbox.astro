---
// Schlanke Vanilla-Lightbox zum Vergrößern von Inhalts-Bildern — ersetzt das alte Fancybox,
// ohne Plugin/jQuery. Bindet an Bilder in .acq (kunst-erwerben: Hero, Porträt, Auftrags-
// Beispiele) und an den Vita-Hero (.cp-hero). BEWUSST NICHT auf der Werk-Detailseite —
// dort sind die Bilder ohnehin groß genug. Verlinkte Bilder werden ausgelassen (navigieren).
interface Props {
  lang?: 'de' | 'en';
}
const { lang = 'de' } = Astro.props;
const closeLabel = lang === 'en' ? 'Close' : 'Schließen';
---

<div id="lightbox" class="lightbox" hidden transition:persist>
  <button type="button" class="lightbox__close" data-lb-close aria-label={closeLabel}>&times;</button>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
</div>

<script is:inline>
  (function () {
    var SEL = '.acq-portrait img, .acq-gallery img, .art-figure img';
    var lb = document.getElementById('lightbox');
    if (!lb) return;
    var lbImg = lb.querySelector('.lightbox__img');
    var lbCap = lb.querySelector('.lightbox__caption');

    function open(img) {
      // data-full = große Version (von <Img>); sonst das aktuell geladene Bild.
      lbImg.src = img.dataset.full || img.currentSrc || img.src;
      lbImg.alt = img.alt || '';
      lbCap.textContent = img.alt || '';
      lbCap.style.display = img.alt ? '' : 'none';
      lb.hidden = false;
      document.documentElement.style.overflow = 'hidden';
    }
    function close() {
      lb.hidden = true;
      lbImg.removeAttribute('src');
      document.documentElement.style.overflow = '';
    }

    // Zoombare Bilder markieren (Tastaturfokus; Cursor kommt aus dem CSS). Läuft bei jedem
    // View-Transition-Wechsel neu, weil der Seiteninhalt (und damit die Bilder) getauscht wird.
    function mark() {
      var imgs = document.querySelectorAll(SEL);
      for (var i = 0; i < imgs.length; i++) {
        var im = imgs[i];
        if (im.closest('a')) continue; // verlinkte Bilder: normal navigieren
        im.dataset.lb = '1';
        im.tabIndex = 0;
        im.setAttribute('role', 'button');
      }
    }
    document.addEventListener('astro:page-load', mark);

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (t && t.dataset && t.dataset.lb) {
        open(t);
        return;
      }
      // Klick irgendwo im offenen Overlay (Bild, Backdrop, Schließen, Caption) schließt.
      if (!lb.hidden && (t === lb || lb.contains(t))) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !lb.hidden) {
        close();
        return;
      }
      var t = e.target;
      if ((e.key === 'Enter' || e.key === ' ') && t && t.dataset && t.dataset.lb) {
        e.preventDefault();
        open(t);
      }
    });
  })();
</script>

<style is:global>
  /* Zoombare Inhalts-Bilder (Porträt + Auftrags-Galerien + Werk-Detail; Banner NICHT). */
  .acq-portrait img,
  .acq-gallery img,
  .art-figure img {
    cursor: zoom-in;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    padding: 4vmin;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    max-height: 100%;
  }
  .lightbox__img {
    max-width: 92vw;
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
    cursor: zoom-out;
  }
  .lightbox__caption {
    color: #ddd;
    font-size: 0.85rem;
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    background: none;
    border: 0;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }
</style>
