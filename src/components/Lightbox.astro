---
// Schlanke Vanilla-Lightbox zum Vergrößern von Inhalts-Bildern — ersetzt das alte Fancybox,
// ohne Plugin/jQuery. Bindet an Bilder in .acq (kunst-erwerben) und die Werk-Detailseite
// (.art-figure). Verlinkte Bilder werden ausgelassen (navigieren). Auf Werk-Detailseiten
// blättern Vor/Zurück-Knöpfe + Pfeiltasten durch die Werke (Ordinals übersprungen).
import CarouselArrow from './CarouselArrow.astro';
interface Props {
  lang?: 'de' | 'en';
}
const { lang = 'de' } = Astro.props;
const closeLabel = lang === 'en' ? 'Close' : 'Schließen';
const prevLabel = lang === 'en' ? 'Previous artwork' : 'Vorheriges Werk';
const nextLabel = lang === 'en' ? 'Next artwork' : 'Nächstes Werk';
---

<div id="lightbox" class="lightbox" hidden transition:persist>
  <button type="button" class="lightbox__close" data-lb-close aria-label={closeLabel}>&times;</button>
  <CarouselArrow dir="prev" class="lightbox__nav lightbox__nav--prev" label={prevLabel} size={48} data-lb-nav="prev" hidden />
  <CarouselArrow dir="next" class="lightbox__nav lightbox__nav--next" label={nextLabel} size={48} data-lb-nav="next" hidden />
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
</div>

<script is:inline data-cfasync="false">
  (function () {
    var SEL = '.acq-portrait img, .acq-gallery img, .art-figure img';
    var lb = document.getElementById('lightbox');
    if (!lb) return;
    var lbImg = lb.querySelector('.lightbox__img');
    var lbCap = lb.querySelector('.lightbox__caption');
    var navBtns = lb.querySelectorAll('.lightbox__nav');

    // Vor/Zurück-Knöpfe nur zeigen, wenn die aktuelle Seite eine Bild-Kette hat (Werk-Detail
    // trägt data-lb-prev/next; auf Kunst-Erwerben o. Ä. gibt es keine -> Knöpfe aus).
    function updateNav() {
      var has = !!document.querySelector('[data-lb-prev]');
      for (var i = 0; i < navBtns.length; i++) navBtns[i].hidden = !has;
    }

    function open(img) {
      // data-full = große Version (von <Img>); sonst das aktuell geladene Bild.
      lbImg.src = img.dataset.full || img.currentSrc || img.src;
      lbImg.alt = img.alt || '';
      lbCap.textContent = img.alt || '';
      lbCap.style.display = img.alt ? '' : 'none';
      lb.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      updateNav();
    }
    function close() {
      lb.hidden = true;
      lbImg.removeAttribute('src');
      document.documentElement.style.overflow = '';
    }

    // Zoombare Bilder markieren (Tastaturfokus; Cursor kommt aus dem CSS). Läuft bei jedem
    // View-Transition-Wechsel neu, weil der Seiteninhalt (und damit die Bilder) getauscht wird.
    function mark() {
      var imgs = document.querySelectorAll(SEL);
      for (var i = 0; i < imgs.length; i++) {
        var im = imgs[i];
        if (im.closest('a')) continue; // verlinkte Bilder: normal navigieren
        im.dataset.lb = '1';
        im.tabIndex = 0;
        im.setAttribute('role', 'button');
      }
    }
    // Nach jedem (Client-)Seitenwechsel Bilder neu markieren. War die Lightbox dabei offen
    // (Pfeiltasten-Blättern durch die Werke), auf das Bild der neuen Seite umstellen — die
    // persistente Lightbox zeigte sonst das alte Bild. Zielseite ohne Bild -> schließen.
    document.addEventListener('astro:page-load', function () {
      mark();
      if (lb.hidden) return;
      updateNav();
      var main = document.querySelector('.art-figure img');
      if (main) {
        lbImg.src = main.dataset.full || main.currentSrc || main.src;
        lbImg.alt = main.alt || '';
        lbCap.textContent = main.alt || '';
        lbCap.style.display = main.alt ? '' : 'none';
      } else {
        close();
      }
    });

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (t && t.dataset && t.dataset.lb) {
        open(t);
        return;
      }
      // Klick irgendwo im offenen Overlay schließt — außer auf die Vor/Zurück-Knöpfe.
      if (!lb.hidden && (t === lb || lb.contains(t)) && !(t.closest && t.closest('[data-lb-nav]'))) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !lb.hidden) {
        close();
        return;
      }
      var t = e.target;
      if ((e.key === 'Enter' || e.key === ' ') && t && t.dataset && t.dataset.lb) {
        e.preventDefault();
        open(t);
      }
    });
  })();
</script>

<style is:global>
  /* Zoombare Inhalts-Bilder (Porträt + Auftrags-Galerien + Werk-Detail; Banner NICHT). */
  .acq-portrait img,
  .acq-gallery img,
  .art-figure img {
    cursor: zoom-in;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    padding: 4vmin;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    max-height: 100%;
  }
  .lightbox__img {
    max-width: 92vw;
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
    cursor: zoom-out;
  }
  .lightbox__caption {
    color: #ddd;
    font-size: 0.85rem;
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    background: none;
    border: 0;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }
  /* Vor/Zurück — Optik/Hover/Hidden kommen aus <CarouselArrow> (Größe via size=48); hier nur die
     Position an den Rändern, vertikal zentriert. Nur auf Werk-Detailseiten sichtbar. */
  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__nav--prev {
    left: clamp(0.5rem, 2.5vw, 1.75rem);
  }
  .lightbox__nav--next {
    right: clamp(0.5rem, 2.5vw, 1.75rem);
  }
</style>
