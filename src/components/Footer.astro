---
// Footer: dunkler Balken mit Marken-Spalte + Link-Spalten (Folgen, Galerie, Rechtliches) und
// einer schlichten Legal-Zeile unten. Aufbau an haushoppe-its orientiert. Adresse/Telefon
// stehen auf Kontakt + Impressum; hier nur ein Kontakt-Link.
import { socials } from '../data/site';
import { getCollection } from 'astro:content';

interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
const t =
  lang === 'en'
    ? { follow: 'Follow', gallery: 'Gallery', legal: 'Legal', tag: 'Fine art gallery on the Baltic coast. Paintings and multi-coloured woodcuts by Olaf Hoppe.', kontakt: 'Contact', vita: 'Vita' }
    : { follow: 'Folgen', gallery: 'Galerie', legal: 'Rechtliches', tag: 'Galerie für Bildende Kunst an der Ostseeküste. Gemälde und mehrfarbige Holzschnitte von Olaf Hoppe.', kontakt: 'Kontakt', vita: 'Vita' };

const galleryLinks = [
  { href: lang === 'en' ? '/contact/' : '/kontakt/', label: t.kontakt },
  { href: '/vita/', label: t.vita },
];

// Widerrufsfunktion (§ 356a BGB): dezenter Link am Ende der Rechtliches-Spalte.
const withdrawHref = lang === 'en' ? '/withdraw/' : '/widerruf-erklaeren/';
const withdrawLabel = lang === 'en' ? 'Withdraw from contract' : 'Vertrag widerrufen';

// Standalone-Seiten mit placement:'footer' (Impressum, Datenschutz, AGB, Widerruf) in stabiler
// Reihenfolge (getCollection() ist sonst instabil je Build).
const footerPages = (await getCollection('pages'))
  .filter((p) => p.data.standalone && p.data.placement === 'footer' && p.data.path && p.id.endsWith(`-${lang}`))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((p) => ({ href: `/${p.data.path}/`, label: p.data.navLabel || p.data.title }));

// Monochrome Inline-SVG-Icons (currentColor), à la haushoppe-its — kein farbiger Kreis mehr.
const icons: Record<string, string> = {
  Instagram:
    '<rect x="4" y="4" width="16" height="16" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17" cy="7" r="1.2" fill="currentColor"/>',
  YouTube:
    '<path fill="currentColor" d="M22 8.2a2.6 2.6 0 0 0-1.8-1.8C18.6 6 12 6 12 6s-6.6 0-8.2.4A2.6 2.6 0 0 0 2 8.2 27 27 0 0 0 1.7 12 27 27 0 0 0 2 15.8a2.6 2.6 0 0 0 1.8 1.8C5.4 18 12 18 12 18s6.6 0 8.2-.4a2.6 2.6 0 0 0 1.8-1.8c.3-1.3.3-2.5.3-3.8s0-2.5-.3-3.8ZM10 15V9l5 3-5 3Z"/>',
};
const domain = lang === 'en' ? 'haushoppe.art' : 'haushoppe.de';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__wordmark">HAUS HOPPE</span>
      <p class="site-footer__tag">{t.tag}</p>
    </div>

    <nav class="site-footer__col" aria-label={t.follow}>
      <p class="site-footer__heading">{t.follow}</p>
      {
        socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener nofollow" class="site-footer__iconlink">
            <span class="site-footer__ico">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.name]} />
            </span>
            <span>{s.name}</span>
          </a>
        ))
      }
    </nav>

    <nav class="site-footer__col" aria-label={t.gallery}>
      <p class="site-footer__heading">{t.gallery}</p>
      {galleryLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <nav class="site-footer__col" aria-label={t.legal}>
      <p class="site-footer__heading">{t.legal}</p>
      {footerPages.map((p) => <a href={p.href}>{p.label}</a>)}
      <a href={withdrawHref} class="site-footer__withdraw-link" data-testid="withdraw-button">{withdrawLabel}</a>
    </nav>
  </div>

  <div class="site-footer__baseline">
    <span>© {year} Olaf Hoppe · HAUS HOPPE</span>
    <span>{domain}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer-bg);
    color: rgba(255, 255, 255, 0.82);
    margin-top: clamp(2rem, 6vw, 4rem);
  }
  .site-footer__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--pad) 1.5rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .site-footer__inner {
      grid-template-columns: 1.7fr 1fr 1fr 1fr;
      gap: 2rem;
    }
  }
  .site-footer__wordmark {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: #fff;
  }
  .site-footer__tag {
    margin: 0.6rem 0 0;
    max-width: 26rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  .site-footer__col {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .site-footer__heading {
    margin: 0 0 0.3rem;
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.5);
  }
  .site-footer__col a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .site-footer__col a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Icon + Label eng nebeneinander (Flexbox), Icon monochrom, Hover -> weiß. */
  .site-footer__iconlink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-footer__ico {
    display: inline-flex;
    color: rgba(255, 255, 255, 0.55);
  }
  .site-footer__ico svg {
    width: 1.1em;
    height: 1.1em;
    display: block;
  }
  .site-footer__iconlink:hover .site-footer__ico {
    color: #fff;
  }
  /* Widerrufsfunktion (§ 356a BGB): dezent abgesetzt (dünner Rahmen), nicht dominant. */
  .site-footer__withdraw-link {
    margin-top: 0.35rem;
    justify-self: start;
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 0.2em 0.7em;
  }
  .site-footer__withdraw-link:hover {
    border-color: #fff;
    text-decoration: none;
  }
  .site-footer__baseline {
    max-width: var(--container);
    margin-inline: auto;
    padding: 1.1rem var(--pad) 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: var(--fs-xs);
  }
</style>
