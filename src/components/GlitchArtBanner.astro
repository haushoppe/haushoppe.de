---
// „Angeber"-Banner oben auf der Kategorie „Digitale Kunst": kurzer Loop-Clip von der Ausstellung
// der Glitch-Art durch die Bitcoin Art Society in Hongkong (Bitcoin Conf Asia / Bitcoin Summit /
// Runes Asia 2025). Stummes Autoplay + Loop; falls der Browser das Autoplay verweigert (Standbild
// sonst wie ein Bild), erscheint ein Play-Button. Ein zweiter Button schaltet den Ton dazu. Bei
// prefers-reduced-motion kein Autoplay, sondern native Steuerung.
interface Props {
  lang?: 'de' | 'en';
}
const { lang = 'de' } = Astro.props;
const src = '/media/glitch-hong-kong-2025.mp4';
const poster = '/media/glitch-hong-kong-2025.jpg';
const creditHref = 'https://www.bitcoinartsociety.com/';
const t =
  lang === 'en'
    ? {
        label: 'Our glitch art exhibited in Hong Kong',
        play: 'Play video',
        soundOn: 'Sound on',
        soundOff: 'Sound off',
        capA: 'In 2025 our glitch art travelled to Hong Kong. The ',
        credit: 'Bitcoin Art Society',
        capB: ' showed it at Bitcoin Conf Asia, Bitcoin Summit and Runes Asia. Digital art, too, looks best on a real wall. Exhibitions end, the blockchain preserves forever.',
      }
    : {
        label: 'Unsere Glitch-Art, ausgestellt in Hongkong',
        play: 'Video abspielen',
        soundOn: 'Ton an',
        soundOff: 'Ton aus',
        capA: '2025 reiste unsere Glitch-Art nach Hongkong. Die ',
        credit: 'Bitcoin Art Society',
        capB: ' zeigte sie auf der Bitcoin Conf Asia, dem Bitcoin Summit und Runes Asia. Auch Digitale Kunst wirkt am besten auf einer echten Wand. Ausstellungen enden, die Blockchain bewahrt für immer.',
      };
---

<figure class="gav" data-testid="glitch-video">
  <div class="gav__frame">
    <video class="gav__video" src={src} poster={poster} autoplay muted loop playsinline preload="metadata" aria-label={t.label}></video>
    <button type="button" class="gav__play" data-gav-play aria-label={t.play} hidden>
      <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </button>
    <button type="button" class="gav__sound" data-gav-sound aria-pressed="false">{t.soundOn}</button>
  </div>
  <figcaption class="gav__caption">
    {t.capA}<a href={creditHref} target="_blank" rel="noopener nofollow">{t.credit}</a>{t.capB}
  </figcaption>
</figure>

<script define:vars={{ soundOn: t.soundOn, soundOff: t.soundOff }}>
  (function () {
    const fig = document.querySelector('.gav[data-testid="glitch-video"]');
    if (!fig) return;
    const v = fig.querySelector('.gav__video');
    const btn = fig.querySelector('[data-gav-sound]');
    const playBtn = fig.querySelector('[data-gav-play]');
    // Reduce-Motion: nicht automatisch abspielen, stattdessen native Steuerung.
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay');
      v.controls = true;
      try { v.pause(); } catch (e) {}
      if (btn) btn.hidden = true;
      if (playBtn) playBtn.hidden = true;
      return;
    }
    // Play-Button spiegelt den Zustand: sichtbar wenn das Video steht, weg sobald es läuft.
    function sync() { if (playBtn) playBtn.hidden = !v.paused; }
    v.addEventListener('play', sync);
    v.addEventListener('pause', sync);
    sync();
    if (playBtn) {
      playBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        v.play().catch(function () {});
      });
    }
    function toggleSound() {
      v.muted = !v.muted;
      if (!v.muted) v.play().catch(function () {});
      if (btn) {
        btn.textContent = v.muted ? soundOn : soundOff;
        btn.setAttribute('aria-pressed', v.muted ? 'false' : 'true');
      }
    }
    // Klick auf den Clip: steht er, wird abgespielt; läuft er, wird der Ton umgeschaltet. Der
    // Ton-Button und der Credit-Link behalten ihr eigenes Verhalten; der Play-Button ebenso.
    fig.addEventListener('click', function (e) {
      if (e.target.closest('a') || e.target.closest('[data-gav-play]')) return;
      if (e.target.closest('[data-gav-sound]')) { toggleSound(); return; }
      if (v.paused) { v.play().catch(function () {}); } else { toggleSound(); }
    });
  })();
</script>

<style>
  .gav {
    max-width: 900px;
    /* Abstand nach oben, damit das Video nicht am letzten Thumbnail klebt. */
    margin: clamp(2rem, 5vw, 3rem) auto clamp(1.75rem, 4vw, 2.5rem);
    padding-inline: 15px;
  }
  .gav__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
    cursor: pointer;
  }
  .gav__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Play-Button: mittig, erscheint nur wenn das Video steht (macht klar: es ist ein Video). */
  .gav__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .gav__play svg {
    margin-left: 3px; /* Dreieck optisch zentrieren */
  }
  .gav__play:hover,
  .gav__play:focus-visible {
    background: rgba(0, 0, 0, 0.75);
  }
  /* Entstummen-Button unten rechts, dezent über dem Clip. */
  .gav__sound {
    position: absolute;
    bottom: 10px;
    right: 10px;
    z-index: 2;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.55);
    font: inherit;
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.42em 0.85em;
    cursor: pointer;
  }
  .gav__sound:hover,
  .gav__sound:focus-visible {
    background: rgba(0, 0, 0, 0.82);
  }
  .gav__caption {
    cursor: pointer;
    margin-top: 0.7rem;
    font-size: var(--fs-sm);
    line-height: 1.5;
    /* Heller Grauton: der Banner steht immer auf der schwarzen Digitale-Kunst-Seite. */
    color: #c9c9c9;
    text-align: center;
  }
  .gav__caption a {
    color: #fff;
    text-decoration: underline;
  }
</style>
