---
// „Kunst Erwerben" / „Acquire Art" — Rahmen (Hero + Titel) + Layout-CSS. Der Inhalt (Portrait,
// Intro-Prosa, Akkordeon) kommt als <slot/> aus der MDX-Seite (content/pages/acquire-<lang>.mdx).
interface Props {
  content: { title: string; hero: { src: string; alt: string } };
}
const { content } = Astro.props;
---

<article class="acq">
  <div class="acq-hero">
    <img src={content.hero.src} alt={content.hero.alt} loading="eager" decoding="async" />
  </div>
  <div class="acq-body">
    <h1 class="entry-title">{content.title}</h1>
    <slot />
  </div>
</article>

<style>
  .acq {
    max-width: 1100px;
    margin: 0 auto;
  }
  .acq-hero img {
    width: 100%;
    height: auto;
    max-height: 460px;
    object-fit: cover;
    object-position: center 35%;
    display: block;
    border-radius: 2px;
  }
  .acq-body {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }
  .acq-body :global(p) {
    margin: 0 0 1rem;
  }
  /* Portrait: rechts neben der Intro-Prosa (float), räumt vor dem Akkordeon auf. */
  .acq-body :global(.acq-portrait) {
    float: right;
    width: 46%;
    max-width: 440px;
    margin: 0.3rem 0 1rem 1.75rem;
  }
  .acq-body :global(.acq-portrait img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }
  .acq-body :global(.acq-portrait figcaption) {
    font-size: 0.85rem;
    color: #6b6b6b;
    text-align: center;
    margin-top: 0.5rem;
  }
  .acq-body :global(h2) {
    clear: both;
    margin: 1.75rem 0 1.25rem;
  }
  /* Akkordeon aus nativen <details> — grauer Balken + Titel, Chevron dreht beim Öffnen. */
  .acq-body :global(.acq-accordion) {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .acq-body :global(.acq-item) {
    border-radius: 2px;
    overflow: hidden;
  }
  .acq-body :global(.acq-item summary) {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #a4adba;
    color: #fff;
    padding: 0.95rem 1.4rem;
    font-family: 'Merriweather', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 700;
    transition: background 0.15s ease;
  }
  .acq-body :global(.acq-item summary::-webkit-details-marker) {
    display: none;
  }
  .acq-body :global(.acq-item summary::after) {
    content: '';
    width: 0.62em;
    height: 0.62em;
    border-right: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    flex: none;
    margin-top: -0.2em;
  }
  .acq-body :global(.acq-item[open] summary::after) {
    transform: rotate(-135deg);
    margin-top: 0.15em;
  }
  .acq-body :global(.acq-item summary:hover) {
    background: #949eac;
  }
  .acq-body :global(.acq-panel) {
    padding: 1.25rem 1.4rem 1.5rem;
    background: rgba(164, 173, 186, 0.08);
  }
  .acq-body :global(.acq-panel p:last-child) {
    margin-bottom: 0;
  }
  .acq-body :global(.acq-contact) {
    font-style: normal;
    line-height: 1.7;
  }
  .acq-body :global(.acq-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .acq-body :global(.acq-gallery img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
    display: block;
  }
  @media (max-width: 720px) {
    .acq-body :global(.acq-portrait) {
      float: none;
      width: 100%;
      max-width: 420px;
      margin: 0 auto 1.25rem;
    }
  }
</style>
