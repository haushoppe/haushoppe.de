---
// Eigene Werk-Galerie (justified Layout + Kategorie-Filter + Infinite Scroll). Vollständig
// eigener Code/Benennung — kein WordPress-/Visual-Portfolio-Erbe. Beim Build werden für ALLE
// Werke die AVIF/WebP-URLs (feste Höhe 480 → flache/breite Werke bekommen automatisch genug
// Breite aus dem hochauflösenden Original, statt bei fester Breite hochskaliert zu werden) via
// getImage() vorberechnet; nur die ersten BATCH
// Kacheln kommen als HTML (schnelle Mobil-FCP), der Rest steckt als kompakte JSON-Daten in der
// Seite und wird von /js/gallery.js beim Scrollen nachgebaut. Der Filter arbeitet über ALLE Werke.
import { getImage } from 'astro:assets';
import type { GalleryItem, FilterCat } from '../lib/artworks';
interface Props {
  items: GalleryItem[];
  cats: FilterCat[];
  allLabel?: string;
}
const { items, cats, allLabel = 'Alle' } = Astro.props;

const BATCH = 36;
// Kompakte Kacheldaten mit vorberechneten Bild-URLs (kurze Keys sparen Bytes):
// u=URL · t=Titel · c=Kategorien · w/h=Maße · n=Nummer · a=avif · p=webp
const data = await Promise.all(
  items.map(async (it) => {
    const [a, p] = await Promise.all([
      getImage({ src: it.image, format: 'avif', height: 480 }),
      getImage({ src: it.image, format: 'webp', height: 480 }),
    ]);
    return { u: it.detailUrl, t: it.title, c: it.categorySlugs.join(' '), w: it.w, h: it.h, n: it.number, a: a.src, p: p.src };
  }),
);
const initial = data.slice(0, BATCH);
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="gallery" data-gallery data-gap="15" data-row-height="200" data-batch={BATCH} data-pagefind-ignore>
  <div class="gallery__filter">
    <a href="#" class="gallery__filter-btn is-active" data-cat="*">{allLabel}</a>
    {cats.map((c) => (
      <a href="#" class="gallery__filter-btn" data-cat={c.slug}>{c.name} <span class="gallery__filter-count">{c.count}</span></a>
    ))}
  </div>

  <div class="gallery__grid">
    {initial.map((d, i) => (
      <article class="gallery__item" data-cats={d.c} data-w={d.w} data-h={d.h}>
        <a href={d.u} class="gallery__link" aria-label={d.t}>
          <picture class="gallery__thumb">
            <source srcset={d.a} type="image/avif" />
            <source srcset={d.p} type="image/webp" />
            <img src={d.p} width={d.w} height={d.h} alt="" loading={i < 8 ? 'eager' : 'lazy'} fetchpriority={i < 4 ? 'high' : undefined} />
          </picture>
          <span class="gallery__overlay">
            <span class="gallery__title">{d.t}</span>
            {d.n && <span class="gallery__number">{d.n}</span>}
          </span>
        </a>
      </article>
    ))}
  </div>

  <div class="gallery__sentinel" aria-hidden="true"></div>
  <script type="application/json" class="gallery__data" set:html={dataJson}></script>
</div>

<script is:inline src="/js/gallery.js"></script>

<style is:global>
  /* ── Werk-Galerie (eigenes Stylesheet) ───────────────────────────────────── */
  .gallery {
    position: relative;
    /* Außenabstand = Abstand der Werke zueinander (data-gap), damit die Kacheln nicht am
       Fensterrand kleben. Fängt zugleich den Sub-Pixel-Überstand des Justified-Layouts ab. */
    padding-inline: 15px;
  }
  /* Kategorie-Filter */
  .gallery__filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 0 auto 1.75rem;
  }
  .gallery__filter-btn {
    display: block;
    background: #f7f7f7;
    color: #6c7781;
    padding: 0.7em 1.3em;
    font-size: 0.9em;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.015em;
    text-decoration: none;
    transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
  }
  .gallery__filter-btn:hover {
    background: #e8e8e8;
    color: #4b4b4b;
  }
  .gallery__filter-btn.is-active {
    background: #c0c0c0;
    color: #fff;
    cursor: default;
  }
  .gallery__filter-count {
    font-size: 0.6em;
    vertical-align: super;
    margin-left: 0.3em;
  }
  /* Justified-Raster (Positionen setzt gallery.js absolut). Fade-in, wenn fertig gelegt. */
  .gallery__grid {
    position: relative;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  .gallery.is-ready .gallery__grid {
    opacity: 1;
  }
  .gallery__item {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
  }
  .gallery__link,
  .gallery__thumb,
  .gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gallery__link {
    text-decoration: none;
    color: inherit;
  }
  .gallery__thumb img {
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }
  .gallery__item:hover .gallery__thumb img {
    transform: scale(1.05);
  }
  /* Hover-Overlay: Bild blendet zu Schwarz, Titel + Nummer erscheinen (gestaffelt). */
  .gallery__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    padding: 1.5em;
    text-align: center;
    color: #fff;
    background: #000;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  .gallery__item:hover .gallery__overlay {
    opacity: 1;
  }
  .gallery__overlay > * {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .gallery__item:hover .gallery__overlay > * {
    opacity: 1;
    transform: none;
  }
  .gallery__item:hover .gallery__number {
    transition-delay: 0.07s;
  }
  .gallery__title {
    font-family: 'Merriweather', Georgia, 'Times New Roman', serif;
    font-size: 1.3em;
    line-height: 1.3;
  }
  .gallery__number {
    font-size: 0.9em;
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }
  .gallery__sentinel {
    height: 1px;
  }
</style>
