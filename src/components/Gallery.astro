---
// Visual-Portfolio-Galerie (justified Layout + Kategorie-Filter + Infinite Scroll wie im
// Original), DE & EN. Beim Build werden für ALLE Werke die AVIF/WebP-URLs (Galerie-Breite
// 480px) via getImage() vorberechnet. Nur die ersten BATCH Kacheln kommen als HTML (schnelle
// Mobil-FCP); der Rest steckt als kompakte JSON-Daten in der Seite und wird von
// /js/vp-justified.js beim Scrollen nachgebaut. Der Filter arbeitet über ALLE Werke.
import { getImage } from 'astro:assets';
import type { GalleryItem, FilterCat } from '../lib/artworks';
interface Props {
  items: GalleryItem[];
  cats: FilterCat[];
  allLabel?: string;
}
const { items, cats, allLabel = 'Alle' } = Astro.props;

const BATCH = 36;
// Kompakte Kacheldaten mit vorberechneten Bild-URLs (kurze Keys sparen Bytes im JSON):
// u=URL · t=Titel · c=Kategorien · w/h=Maße · n=Nummer · a=avif · p=webp
const data = await Promise.all(
  items.map(async (it) => {
    const [a, p] = await Promise.all([
      getImage({ src: it.image, format: 'avif', width: 480 }),
      getImage({ src: it.image, format: 'webp', width: 480 }),
    ]);
    return { u: it.detailUrl, t: it.title, c: it.categorySlugs.join(' '), w: it.w, h: it.h, n: it.number, a: a.src, p: p.src };
  }),
);
const initial = data.slice(0, BATCH);
// `<` escapen, damit ein Titel den <script>-Block nicht sprengen kann.
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="wp-block-visual-portfolio" data-pagefind-ignore>
  <div
    class="vp-portfolio vp-uid-hh vp-id-gallery"
    data-vp-layout="justified"
    data-vp-items-gap="15"
    data-vp-justified-row-height="200"
    data-vp-justified-row-height-tolerance="0.25"
    data-vp-justified-last-row="left"
    data-vp-batch={BATCH}
  >
    <div class="vp-portfolio__filter-wrap">
      <div class="vp-filter vp-filter__style-default">
        <div class="vp-filter__item vp-filter__item-active"><a href="#" data-vp-filter="*">{allLabel}</a></div>
        {cats.map((c) => (
          <div class="vp-filter__item">
            <a href="#" data-vp-filter={c.slug}>{c.name} <span class="vp-filter__item-count">{c.count}</span></a>
          </div>
        ))}
      </div>
    </div>

    <div class="vp-portfolio__items-wrap">
      <div class="vp-portfolio__items vp-portfolio__items-style-fade vp-portfolio__items-show-overlay-hover">
        {initial.map((d, i) => (
          <article class="vp-portfolio__item-wrap" data-vp-filter={d.c} data-w={d.w} data-h={d.h}>
            <figure class="vp-portfolio__item">
              <div class="vp-portfolio__item-img-wrap">
                <div class="vp-portfolio__item-img">
                  <a href={d.u} aria-label={d.t}>
                    <picture>
                      <source srcset={d.a} type="image/avif" />
                      <source srcset={d.p} type="image/webp" />
                      <img src={d.p} width={d.w} height={d.h} alt="" loading={i < 8 ? 'eager' : 'lazy'} fetchpriority={i < 4 ? 'high' : undefined} />
                    </picture>
                  </a>
                </div>
              </div>
              <figcaption class="vp-portfolio__item-overlay vp-portfolio__item-overlay-text-align-center">
                <div class="vp-portfolio__item-meta-wrap vp-portfolio__custom-scrollbar">
                  <a href={d.u} tabindex="-1" class="vp-portfolio__item-meta" aria-label={d.t}>
                    <h2 class="vp-portfolio__item-meta-title">{d.t}</h2>
                    {d.n && (
                      <div class="vp-portfolio__item-meta-inline">
                        <div class="vp-portfolio__item-meta-part vp-portfolio__item-meta-date">
                          <span class="vp-portfolio__item-meta-part-text">{d.n}</span>
                        </div>
                      </div>
                    )}
                  </a>
                </div>
              </figcaption>
            </figure>
          </article>
        ))}
      </div>
    </div>

    <div class="vp-portfolio__sentinel" aria-hidden="true"></div>
    <script type="application/json" class="vp-portfolio__data" set:html={dataJson}></script>
  </div>
</div>

<script is:inline src="/js/vp-justified.js"></script>

<style is:global>
  .vp-portfolio__item-img,
  .vp-portfolio__item-img > a,
  .vp-portfolio__item-img > a > picture,
  .vp-portfolio__item-img > a > picture > img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  /* Filter zentriert + umbrechend wie live (statt linksbündig full-width). */
  .vp-portfolio__filter-wrap .vp-filter,
  .vp-filter {
    justify-content: center;
    flex-wrap: wrap;
    row-gap: 10px;
    margin: 0 auto 1.75rem;
  }
  .vp-portfolio__sentinel {
    height: 1px;
  }
</style>
