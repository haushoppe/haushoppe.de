---
// Eigene Werk-Galerie. ALLE (der Kategorie zugehörigen) Werke stehen server-seitig im HTML — so
// ist die Galerie OHNE JS vollständig sichtbar (einfaches CSS-Raster, s. u.) und crawlbar (SEO).
// Der Kategorie-Filter sind ECHTE Links auf eigene URLs (/werke/<kat>/): sichtbarer Seitenwechsel,
// kein SPA-Zustand; mit ClientRouter als sanfter Übergang. Das Galerie-Skript (src/scripts/gallery.js,
// via Astro gebündelt) ist reine Veredelung: Justified-Layout + Infinite Scroll (blendet die zunächst
// versteckten Kacheln beim Scrollen ein).
// Beim Build werden je Werk responsive AVIF/WebP-Sätze (Höhen 240+480 im Grid, 560+1000 im Highlight) vorberechnet.
import { getImage } from 'astro:assets';
import type { GalleryItem, FilterCat } from '../lib/artworks';
interface Props {
  items: GalleryItem[];
  cats: FilterCat[];
  allLabel?: string;
  base: string; // Galerie-Wurzel der Sprache: '/werke' oder '/artwork'
  activeCat?: string; // '*' = Alle, sonst Kategorie-Slug
  heading?: string; // Seiten-h1 (SR-only) — Heading-Hierarchie/SEO ohne visuelle Änderung
  total?: number; // Gesamtzahl aller Werke — als Zahl am „Alle"-Button
  dark?: boolean; // dunkles Theme + REVEALED-Logo (nur Kategorie Digitale Kunst)
}
const { items, cats, allLabel = 'Alle', base, activeCat = '*', heading, total, dark = false } = Astro.props;
// Marker „online kaufbar" + Highlight-CTA „Weiterlesen" pro Sprache (Sprache = Galerie-Wurzel).
const buyLabel = base === '/artwork' ? 'buy online' : 'online kaufen';
const moreLabel = base === '/artwork' ? 'Read more' : 'Weiterlesen';
// Responsive Bildbreiten: Grid-Kacheln sind ~200px (Justified/No-JS-Raster), die Highlight-Kachel läuft mobil voll, sonst bis ~700px.
const GRID_SIZES = '(max-width: 700px) 45vw, 240px';
const HL_SIZES = '(max-width: 720px) 100vw, 700px';

// Highlights nehmen oben die volle Breite ein (eigene Kachel), getrennt vom Justified-Grid —
// gallery.js fasst nur .gallery__grid an, die Highlight-Kacheln bleiben statisch stehen.
const highlightItems = items.filter((it) => it.highlight);
const gridItems = items.filter((it) => !it.highlight);

// Grid-Kacheln mit vorberechneten Bild-URLs (u=URL · t=Titel · c=Kategorien · w/h=Maße · n=Nummer).
const data = await Promise.all(
  gridItems.map(async (it) => {
    const [a2, a4, p2, p4] = await Promise.all([
      getImage({ src: it.image, format: 'avif', height: 240 }),
      getImage({ src: it.image, format: 'avif', height: 480 }),
      getImage({ src: it.image, format: 'webp', height: 240 }),
      getImage({ src: it.image, format: 'webp', height: 480 }),
    ]);
    const w2 = Math.round((240 * it.w) / it.h);
    const w4 = Math.round((480 * it.w) / it.h);
    return { u: it.detailUrl, t: it.title, c: it.categorySlugs.join(' '), w: it.w, h: it.h, n: it.number, avif: `${a2.src} ${w2}w, ${a4.src} ${w4}w`, webp: `${p2.src} ${w2}w, ${p4.src} ${w4}w`, p: p4.src, b: it.buyable };
  }),
);
// Highlight-Kacheln mit größerem Bild (breiter dargestellt).
const hlData = await Promise.all(
  highlightItems.map(async (it) => {
    const [a5, a10, p5, p10] = await Promise.all([
      getImage({ src: it.image, format: 'avif', width: 560 }),
      getImage({ src: it.image, format: 'avif', width: 1000 }),
      getImage({ src: it.image, format: 'webp', width: 560 }),
      getImage({ src: it.image, format: 'webp', width: 1000 }),
    ]);
    return { u: it.detailUrl, t: it.title, c: it.categorySlugs.join(' '), intro: it.intro, w: it.w, h: it.h, n: it.number, avif: `${a5.src} 560w, ${a10.src} 1000w`, webp: `${p5.src} 560w, ${p10.src} 1000w`, p: p10.src, b: it.buyable };
  }),
);
---

<div class:list={['gallery', dark && 'gallery--dark']} data-gallery data-gap="15" data-row-height="200" data-batch="36" data-pagefind-ignore>
  {heading && <h1 class="visually-hidden">{heading}</h1>}
  <nav class="gallery__filter" aria-label={allLabel}>
    <a href={`${base}/`} class:list={['gallery__filter-btn', activeCat === '*' && 'is-active']} aria-current={activeCat === '*' ? 'page' : undefined} data-testid="gallery-filter">{allLabel} {typeof total === 'number' && <span class="gallery__filter-count">{total}</span>}</a>
    {cats.map((c) => (
      <a href={`${base}/${c.slug}/`} class:list={['gallery__filter-btn', activeCat === c.slug && 'is-active']} aria-current={activeCat === c.slug ? 'page' : undefined} data-testid="gallery-filter">{c.name} <span class="gallery__filter-count">{c.count}</span></a>
    ))}
  </nav>

  {dark && (
    <div class="gallery__logo" aria-hidden="true">
      <iframe src="https://ordinals.com/content/d279c3692719664d36a34621577fe1ee2939950e8a914a9bf150bb723d8feb80i0" title="REVEALED" loading="lazy" tabindex="-1" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin"></iframe>
    </div>
  )}

  {hlData.length > 0 && (
    <div class="gallery__highlights">
      {hlData.map((d) => (
        <article class="gallery__highlight" data-testid="gallery-item" data-cats={d.c}>
          <a href={d.u} class="gallery__highlight-media">
            {d.b && <span class="gallery__buy" data-testid="gallery-buy">{buyLabel}</span>}
            <picture>
              <source srcset={d.avif} sizes={HL_SIZES} type="image/avif" />
              <source srcset={d.webp} sizes={HL_SIZES} type="image/webp" />
              <img src={d.p} width={d.w} height={d.h} alt="" loading="eager" fetchpriority="high" sizes={HL_SIZES} />
            </picture>
            <span class="gallery__overlay">
              <span class="gallery__title">{d.t}</span>
              {d.n && <span class="gallery__number">{d.n}</span>}
            </span>
          </a>
          <div class="gallery__highlight-body">
            <h2 class="gallery__highlight-title">{d.t}</h2>
            {d.intro && <p class="gallery__highlight-intro">{d.intro}</p>}
            <a href={d.u} class="gallery__highlight-cta btn btn--dark">{moreLabel}<span class="visually-hidden"> {d.t}</span></a>
          </div>
        </article>
      ))}
    </div>
  )}

  {/* ALLE Werke server-seitig — ohne JS ein CSS-Raster (voll sichtbar + crawlbar). Mit JS
      versteckt gallery.js zunächst alles jenseits der ersten Charge und blendet beim Scrollen
      weiter ein (Infinite Scroll ohne Nachbau). */}
  <div class="gallery__grid">
    {data.map((d, i) => (
      <article class="gallery__item" data-testid="gallery-item" data-cats={d.c} data-w={d.w} data-h={d.h}>
        {d.b && <span class="gallery__buy" data-testid="gallery-buy">{buyLabel}</span>}
        <a href={d.u} class="gallery__link">
          <picture class="gallery__thumb">
            <source srcset={d.avif} sizes={GRID_SIZES} type="image/avif" />
            <source srcset={d.webp} sizes={GRID_SIZES} type="image/webp" />
            <img src={d.p} width={d.w} height={d.h} alt="" loading={i < 8 ? 'eager' : 'lazy'} sizes={GRID_SIZES} />
          </picture>
          <span class="gallery__overlay">
            <span class="gallery__title">{d.t}</span>
            {d.n && <span class="gallery__number">{d.n}</span>}
          </span>
        </a>
      </article>
    ))}
  </div>

  <div class="gallery__sentinel" aria-hidden="true"></div>
</div>

{/* gallery.js wird global im BaseLayout geladen (nicht hier), damit sein astro:page-load-
    Listener schon beim ersten Vollladen registriert ist und nach JEDER View-Transition feuert —
    ein seiten-eigenes <script src> wird beim Einswappen nicht zuverlässig ausgeführt. */}

<style is:global>
  /* ── Werk-Galerie (eigenes Stylesheet) ───────────────────────────────────── */
  .gallery {
    position: relative;
    /* Außenabstand = Abstand der Werke zueinander (data-gap), damit die Kacheln nicht am
       Fensterrand kleben. Fängt zugleich den Sub-Pixel-Überstand des Justified-Layouts ab. */
    padding-inline: 15px;
  }
  /* Kategorie-Filter */
  .gallery__filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 0 auto 1.75rem;
  }
  .gallery__filter-btn {
    display: block;
    border: 0;
    cursor: pointer;
    background: #f7f7f7;
    /* dunkler Blaugrau: AA-Kontrast auf #f7f7f7 (war #6c7781, 4.26:1). */
    color: #565f67;
    padding: 0.7em 1.3em;
    font-family: inherit;
    font-size: 0.9em;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.015em;
    text-decoration: none;
    transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
  }
  .gallery__filter-btn:hover {
    background: #e8e8e8;
    color: #4b4b4b;
  }
  .gallery__filter-btn.is-active {
    /* gefüllter dunkler Chip = klarer „aktiv"-Zustand mit hohem Kontrast (war #fff auf #c0c0c0, 1.81:1). */
    background: var(--ink, #1a1a1a);
    color: #fff;
    cursor: default;
  }
  .gallery__filter-count {
    font-size: 0.6em;
    vertical-align: super;
    margin-left: 0.3em;
  }
  /* REVEALED-Collection-Logo (animierte On-Chain-Inschrift) über den Thumbnails, nur dunkle Kategorie. */
  .gallery__logo {
    width: min(360px, 70%);
    aspect-ratio: 4 / 1;
    margin: 0 auto 1.75rem;
  }
  .gallery__logo iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #000;
  }
  /* Dunkle Kategorie (Digitale Kunst): Filter-Reiter hell auf Schwarz. */
  .gallery--dark .gallery__filter-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #cfcfcf;
  }
  .gallery--dark .gallery__filter-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }
  .gallery--dark .gallery__filter-btn.is-active {
    background: #f4f4f4;
    color: #000;
  }
  /* ── Highlight-Kachel: volle Breite oben, Bild links, Intro + „Weiterlesen" rechts. Liegt
     außerhalb von .gallery__grid, wird also nicht vom Justified-Layout angefasst. ──────────── */
  .gallery__highlights {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 15px;
  }
  .gallery__highlight {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .gallery__highlight-media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .gallery__highlight-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }
  .gallery__highlight-media:hover img {
    transform: scale(1.05);
  }
  .gallery__highlight-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.2;
    margin: 0 0 0.7rem;
    color: var(--ink);
  }
  .gallery__highlight-intro {
    color: var(--text, #4b4f58);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 1.4rem;
    max-width: 42rem;
  }
  /* CTA nutzt die gemeinsame Button-Basis (.btn .btn--dark); hier nur der nachgestellte Pfeil. */
  .gallery__highlight-cta::after {
    content: '→';
  }
  @media (max-width: 720px) {
    .gallery__highlight {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
    .gallery__highlight-media {
      aspect-ratio: 3 / 2;
    }
  }
  /* Progressive Enhancement: OHNE JS ein einfaches, sofort sichtbares Raster — die serverseitig
     gerenderte erste Charge steht so IMMER im Bild, unabhängig von View-Transition-Timing oder
     Browser. Sobald gallery.js gelaufen ist (.is-ready), wird auf das absolute Justified-Layout
     umgeschaltet. */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 15px;
  }
  .gallery__item {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  /* JS-veredelt: Justified-Layout (gallery.js setzt Breite/Höhe/Position der Kacheln absolut). */
  .gallery.is-ready .gallery__grid {
    display: block;
    position: relative;
  }
  .gallery.is-ready .gallery__item {
    position: absolute;
    top: 0;
    left: 0;
    aspect-ratio: auto;
  }
  .gallery__link,
  .gallery__thumb,
  .gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gallery__link {
    text-decoration: none;
    color: inherit;
  }
  .gallery__thumb img {
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }
  .gallery__item:hover .gallery__thumb img {
    transform: scale(1.05);
  }
  /* „online kaufbar"-Marker: kleine eckige Pill oben links, immer sichtbar (z-index über dem
     Hover-Overlay). pointer-events:none, damit der Klick weiter auf den Werk-Link geht. */
  .gallery__buy {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 3;
    background: rgba(255, 255, 255, 0.7);
    color: #1a1a1a;
    font-size: var(--fs-3xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.35em 0.6em;
    white-space: nowrap;
    pointer-events: none;
  }
  /* Hover-Overlay: Bild blendet zu Schwarz, Titel + Nummer erscheinen (gestaffelt). */
  .gallery__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    padding: 1.5em;
    text-align: center;
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  .gallery__item:hover .gallery__overlay,
  .gallery__highlight-media:hover .gallery__overlay {
    opacity: 1;
  }
  .gallery__overlay > * {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .gallery__item:hover .gallery__overlay > *,
  .gallery__highlight-media:hover .gallery__overlay > * {
    opacity: 1;
    transform: none;
  }
  .gallery__item:hover .gallery__number,
  .gallery__highlight-media:hover .gallery__number {
    transition-delay: 0.07s;
  }
  .gallery__title {
    font-family: var(--serif);
    font-size: 1.3em;
    line-height: 1.3;
  }
  .gallery__number {
    font-size: 0.9em;
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }
  .gallery__sentinel {
    height: 1px;
  }
</style>
