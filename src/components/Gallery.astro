---
// Wiederverwendbare Visual-Portfolio-Galerie (justified Layout + Kategorie-Filter), DE & EN.
import { Picture } from 'astro:assets';
import type { GalleryItem, FilterCat } from '../lib/artworks';
interface Props {
  items: GalleryItem[];
  cats: FilterCat[];
  allLabel?: string;
}
const { items, cats, allLabel = 'Alle' } = Astro.props;
---

<div class="wp-block-visual-portfolio" data-pagefind-ignore>
  <div
    class="vp-portfolio vp-uid-hh vp-id-gallery"
    data-vp-layout="justified"
    data-vp-items-gap="15"
    data-vp-justified-row-height="200"
    data-vp-justified-row-height-tolerance="0.25"
    data-vp-justified-last-row="left"
  >
    <div class="vp-portfolio__filter-wrap">
      <div class="vp-filter vp-filter__style-default">
        <div class="vp-filter__item vp-filter__item-active"><a href="#" data-vp-filter="*">{allLabel}</a></div>
        {cats.map((c) => (
          <div class="vp-filter__item">
            <a href="#" data-vp-filter={c.slug}>{c.name} <span class="vp-filter__item-count">{c.count}</span></a>
          </div>
        ))}
      </div>
    </div>

    <div class="vp-portfolio__items-wrap">
      <div class="vp-portfolio__items vp-portfolio__items-style-fade vp-portfolio__items-show-overlay-hover">
        {items.map((it, i) => (
          <article
            class="vp-portfolio__item-wrap"
            data-vp-filter={it.categorySlugs.join(' ')}
            data-w={it.w}
            data-h={it.h}
          >
            <figure class="vp-portfolio__item">
              <div class="vp-portfolio__item-img-wrap">
                <div class="vp-portfolio__item-img">
                  <a href={it.detailUrl} aria-label={it.title}>
                    <Picture
                      src={it.image}
                      formats={['avif', 'webp']}
                      fallbackFormat="webp"
                      widths={[480]}
                      layout="none"
                      alt=""
                      loading={i < 8 ? 'eager' : 'lazy'}
                      fetchpriority={i < 4 ? 'high' : undefined}
                    />
                  </a>
                </div>
              </div>
              <figcaption class="vp-portfolio__item-overlay vp-portfolio__item-overlay-text-align-center">
                <div class="vp-portfolio__item-meta-wrap vp-portfolio__custom-scrollbar">
                  <a href={it.detailUrl} tabindex="-1" class="vp-portfolio__item-meta" aria-label={it.title}>
                    <h2 class="vp-portfolio__item-meta-title">{it.title}</h2>
                    {it.number && (
                      <div class="vp-portfolio__item-meta-inline">
                        <div class="vp-portfolio__item-meta-part vp-portfolio__item-meta-date">
                          <span class="vp-portfolio__item-meta-part-text">{it.number}</span>
                        </div>
                      </div>
                    )}
                  </a>
                </div>
              </figcaption>
            </figure>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline src="/js/vp-justified.js"></script>

<style is:global>
  .vp-portfolio__item-img,
  .vp-portfolio__item-img > a,
  .vp-portfolio__item-img > a > picture,
  .vp-portfolio__item-img > a > picture > img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  /* Filter zentriert + umbrechend wie live (statt linksbündig full-width). */
  .vp-portfolio__filter-wrap .vp-filter,
  .vp-filter {
    justify-content: center;
    flex-wrap: wrap;
    row-gap: 10px;
    margin: 0 auto 1.75rem;
  }
</style>
