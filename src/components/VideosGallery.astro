---
// Videos-Seite — EXAKT wie im Original: der Automatic-YouTube-Gallery „Classic Slider"
// (großer Player oben + Slick-Karussell der 25 Playlist-Videos mit Pfeilen & Dots).
// Wir rendern den unveränderten, server-gerenderten ayg-Block von der Live-Seite und
// binden die echten Plugin-Assets ein (jQuery → Slick → ayg-Core → Theme-Slider). Die
// Plugin-Asset-Struktur ist unter /ayg-plugin/ gespiegelt, damit alle relativen url()
// (Spinner etc.) auflösen; `ayg_config` (sonst von WP inline gesetzt) wird lokalisiert
// bereitgestellt. Die Custom Elements <ayg-player>/<ayg-theme-slider> hydrieren 1:1.
import liveVideosDe from '../data/live-videos.json';
import liveVideosEn from '../data/live-videos-en.json';

interface Props {
  lang?: 'de' | 'en';
}
const { lang = 'de' } = Astro.props;
const gallery = (lang === 'en' ? liveVideosEn : liveVideosDe).html as string;

const aygConfig = {
  plugin_url: '/ayg-plugin/',
  plugin_version: '2.8.1',
  ajax_url: '',
  ajax_nonce: '',
  current_page_url: '',
  current_gallery_id: '',
  player_type: 'youtube',
  player_color: '#00b3ff',
  privacy_enhanced_mode: '0',
  origin: '',
  cookieconsent: '0',
  top_offset: '10',
  i18n: { show_more: 'Show More', show_less: 'Show Less' },
};
---

<link rel="stylesheet" href="/ayg-plugin/vendor/slick/slick.min.css" />
<link rel="stylesheet" href="/ayg-plugin/public/assets/css/public.min.css" />
<link rel="stylesheet" href="/ayg-plugin/premium/public/assets/css/public.min.css" />

<Fragment set:html={gallery} />

<script is:inline set:html={`var ayg_config = ${JSON.stringify(aygConfig)};`}></script>
<script is:inline src="/vendor/jquery.min.js"></script>
<script is:inline src="/ayg-plugin/vendor/slick/slick.min.js"></script>
<script is:inline src="/ayg-plugin/public/assets/js/public.min.js"></script>
<script is:inline src="/ayg-plugin/premium/public/assets/js/theme-slider.min.js"></script>
