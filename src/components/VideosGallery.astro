---
// Videos-Seite — Look wie das Original (großer Player oben + Thumbnail-Karussell mit
// Pfeilen & Punkten darunter, Klick auf Thumbnail wechselt oben), aber OHNE das
// WordPress-Plugin, jQuery oder Slick — schlank in Vanilla-JS. YouTube-Klick-Facade:
// das iframe lädt erst beim Klick (kein YouTube-Kontakt beim Seitenaufruf).
// Daten: src/data/videos.json. Styles bewusst is:global (.vg__*-Namespace), damit sie
// auch für die per JS erzeugten Elemente (Punkte, getauschte Facade) greifen.
import videos from '../data/videos.json';

interface Props {
  lang?: 'de' | 'en';
}
const { lang = 'de' } = Astro.props;
const t =
  lang === 'en'
    ? { play: 'Play video', prev: 'Previous', next: 'Next' }
    : { play: 'Video abspielen', prev: 'Zurück', next: 'Weiter' };
const first = videos[0];
const embed = (id: string) =>
  `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1&modestbranding=1`;
---

<section class="vg" data-play-label={t.play}>
  <div class="vg__featured">
    <div class="yt-facade vg__player" data-src={embed(first.id)} data-title={first.title} style="aspect-ratio: 16 / 9">
      <button type="button" class="yt-facade__btn" aria-label={`${t.play}: ${first.title}`}>
        <img
          class="yt-facade__poster"
          src={`https://i.ytimg.com/vi/${first.id}/maxresdefault.jpg`}
          alt={first.title}
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
        />
        <span class="yt-facade__play" aria-hidden="true"></span>
      </button>
    </div>
    <h2 class="vg__featured-title">{first.title}</h2>
  </div>

  <div class="vg__carousel">
    <button type="button" class="vg__nav vg__nav--prev" aria-label={t.prev}>&lsaquo;</button>
    <ul class="vg__track">
      {
        videos.map((v, i) => (
          <li class="vg__slide">
            <button
              type="button"
              class="vg__thumb"
              data-id={v.id}
              data-title={v.title}
              aria-label={`${t.play}: ${v.title}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <img
                src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                alt={v.title}
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
              />
              <span class="vg__thumb-play" aria-hidden="true" />
            </button>
            <p class="vg__slide-title">{v.title}</p>
          </li>
        ))
      }
    </ul>
    <button type="button" class="vg__nav vg__nav--next" aria-label={t.next}>&rsaquo;</button>
  </div>
  <div class="vg__dots" aria-hidden="true"></div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.vg');
  if (root) {
    const player = root.querySelector<HTMLElement>('.vg__player')!;
    const title = root.querySelector<HTMLElement>('.vg__featured-title')!;
    const track = root.querySelector<HTMLElement>('.vg__track')!;
    const dots = root.querySelector<HTMLElement>('.vg__dots')!;
    const prev = root.querySelector<HTMLButtonElement>('.vg__nav--prev')!;
    const next = root.querySelector<HTMLButtonElement>('.vg__nav--next')!;
    // Klick auf ein Thumbnail spielt oben SOFORT ab (wie das Original): iframe mit
    // autoplay laden. (Beim Seitenaufruf bleibt der große Player eine Facade — kein
    // YouTube-Kontakt vor der ersten Interaktion.)
    function feature(id: string, ttl: string) {
      const src =
        'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&playsinline=1&modestbranding=1';
      player.dataset.src = src;
      player.dataset.title = ttl;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = ttl;
      iframe.setAttribute('allow', 'autoplay; encrypted-media; fullscreen; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      player.replaceChildren(iframe);
      title.textContent = ttl;
    }

    track.querySelectorAll<HTMLButtonElement>('.vg__thumb').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        track.querySelectorAll('.vg__thumb').forEach((b) => b.removeAttribute('aria-current'));
        thumb.setAttribute('aria-current', 'true');
        feature(thumb.dataset.id!, thumb.dataset.title!);
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    const pageBy = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.9, behavior: 'smooth' });
    prev.addEventListener('click', () => pageBy(-1));
    next.addEventListener('click', () => pageBy(1));

    function buildDots() {
      const pages = Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth - 0.05));
      dots.replaceChildren();
      for (let i = 0; i < pages; i++) {
        const d = document.createElement('button');
        d.type = 'button';
        d.className = 'vg__dot';
        d.addEventListener('click', () => track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' }));
        dots.appendChild(d);
      }
      updateDots();
    }
    function updateDots() {
      const idx = Math.round(track.scrollLeft / track.clientWidth);
      dots.querySelectorAll('.vg__dot').forEach((d, i) => d.setAttribute('aria-current', String(i === idx)));
    }
    track.addEventListener('scroll', updateDots, { passive: true });
    let rt: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(buildDots, 150);
    });
    buildDots();
  }
</script>

<style is:global>
  .vg {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .vg__featured .yt-facade {
    border-radius: 2px;
  }
  .vg__featured-title {
    margin: 0.9rem 0 0;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 4vw, 1.9rem);
    font-weight: 400;
    color: var(--ink);
    line-height: 1.3;
  }
  /* Karussell: Pfeile flankieren den Track (überdecken nichts). */
  .vg__carousel {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .vg__track {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    gap: clamp(0.6rem, 2vw, 1rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.25rem;
  }
  .vg__track::-webkit-scrollbar {
    display: none;
  }
  .vg__slide {
    flex: 0 0 clamp(140px, 30%, 200px);
    scroll-snap-align: start;
    margin: 0;
    list-style: none;
  }
  .vg__thumb {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    border-radius: 2px;
    overflow: hidden;
    cursor: pointer;
    background: #000;
  }
  .vg__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .vg__thumb[aria-current='true'] {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .vg__thumb-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 28px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 7px;
    transition: background 0.2s;
  }
  .vg__thumb-play::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-40%, -50%);
    border-style: solid;
    border-width: 6px 0 6px 11px;
    border-color: transparent transparent transparent #fff;
  }
  .vg__thumb:hover .vg__thumb-play {
    background: #f00;
  }
  .vg__slide-title {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink);
    min-height: 2.55em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Pfeile — kleine runde Buttons, flankieren den Track. Auf Mobil aus (Wischen + Punkte). */
  .vg__nav {
    flex: none;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vg__nav:hover {
    background: rgba(0, 0, 0, 0.85);
  }
  /* Punkte */
  .vg__dots {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .vg__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #cfcfcf;
    cursor: pointer;
  }
  .vg__dot[aria-current='true'] {
    background: var(--ink);
  }
  @media (max-width: 720px) {
    .vg__nav {
      display: none;
    }
  }
</style>
