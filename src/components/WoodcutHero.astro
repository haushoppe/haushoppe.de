---
// Holzschnitt-Hero: Werkstatt-Loop (Olaf schneidet in die Holzplatte) mit Spruch. Reines Zitatband.
// Ausschnitt nach unten geschoben, damit Holzplatte + Schnitzwerkzeug sichtbar sind.
import CategoryHero from './CategoryHero.astro';
import clip from '../assets/holzschnitte/schnitzen-clip.mp4';
import poster from '../assets/holzschnitte/schnitzen-poster.jpg';
interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;
const quote = lang === 'en' ? 'Cut by hand, printed by hand.' : 'Von Hand geschnitten, von Hand gedruckt.';
---

<CategoryHero clip={clip} poster={poster} quote={quote} objectPosition="center 70%" testid="woodcut-hero" />
