---
// Schmales Hero-Band der Holzschnitt-Kategorieseite (zwischen Filter und Kacheln): schwarze Bühne,
// Werkstatt-Loop links (Olaf schneidet in die Holzplatte, cinematisch gegradet), rechte Kante weich
// nach Schwarz, Spruch rechts in weißer Serife. Klickt aufs Werk (Atlantis 4). Autoplay besorgt
// global hero-autoplay.js.
import clip from '../assets/holzschnitte/schnitzen-clip.mp4';
import poster from '../assets/holzschnitte/schnitzen-poster.jpg';
interface Props {
  lang: 'de' | 'en';
  href: string;
}
const { lang, href } = Astro.props;
const t =
  lang === 'en'
    ? { quote: 'Cut by hand, printed by hand.', more: 'View Atlantis 4' }
    : { quote: 'Von Hand geschnitten, von Hand gedruckt.', more: 'Atlantis 4 ansehen' };
---

<a class="wc-hero" href={href} data-testid="woodcut-hero">
  <span class="wc-hero__media">
    <video class="wc-hero__video" src={clip} autoplay muted loop playsinline preload="metadata" poster={poster.src} aria-hidden="true"></video>
    <img class="wc-hero__still" src={poster.src} alt="" width="1280" height="720" loading="lazy" decoding="async" />
  </span>
  <span class="wc-hero__quote">{t.quote}</span>
  <span class="visually-hidden">{t.more}</span>
</a>

<style>
  .wc-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 15rem;
    margin: 0 auto 1.75rem;
    padding: clamp(1.1rem, 3vw, 2.1rem);
    background: #030303;
    color: #fff;
    overflow: hidden;
    text-decoration: none;
  }
  .wc-hero__media {
    position: absolute;
    inset: 0 auto 0 0;
    width: 62%;
    z-index: 0;
    pointer-events: none;
  }
  .wc-hero__video,
  .wc-hero__still {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wc-hero__still {
    display: none;
  }
  /* Rechte Videokante weich nach Schwarz, damit der Spruch frei steht. */
  .wc-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, transparent 42%, rgba(3, 3, 3, 0.72) 78%, #030303 100%);
  }
  .wc-hero__quote {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 40%;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.6vw, 1.9rem);
    line-height: 1.25;
    color: #fff;
    text-wrap: balance;
  }
  @media (max-width: 720px) {
    .wc-hero {
      min-height: 13rem;
      align-items: flex-end;
      justify-content: flex-start;
    }
    .wc-hero__media {
      width: 100%;
    }
    .wc-hero__media::after {
      background: linear-gradient(180deg, rgba(3, 3, 3, 0.3) 0%, rgba(3, 3, 3, 0.8) 100%);
    }
    .wc-hero__quote {
      max-width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wc-hero__video {
      display: none;
    }
    .wc-hero__still {
      display: block;
    }
  }
</style>
