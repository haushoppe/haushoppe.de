---
// Inhalt einer Kunstwerk-Detailseite: normalerweise das große Bild, bei den 5 Ordinals
// stattdessen die Live-Inschrift (ordinalsbot-iframe) + Kauf-Link mit invertiertem Design.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ordinalData } from '../lib/ordinals';
import ArtworkMeta from './ArtworkMeta.astro';
import metaData from '../data/artwork-meta.json';
import { contact } from '../data/site';
import { SELF_ORIGIN } from '../lib/lang';
import { isWoodcut, woodcutPrice } from '../lib/pricing';

interface Props {
  art: any;
  image: ImageMetadata;
  lang?: 'de' | 'en';
  title?: string;
  Extra?: any; // gerenderter Zusatz-Content (Beschreibung/Video) aus der artworkExtra-Collection
}
const { art, image, lang = 'de', title, Extra } = Astro.props;
const ord = ordinalData(art);
// Strukturierte Werk-Beschriftung (Ordinals bekommen keine — eigener Sonderfall).
// Key = trid (für DE + EN identisch).
const meta = ord ? null : (metaData as Record<string, any>)[art.trid];
const t =
  lang === 'en'
    ? {
        eyebrow: 'REVEALED · Bitcoin Ordinal · Glitch Art · Johannes × Olaf',
        line: 'Painted by Olaf, glitched by Johannes. Inscribed forever.',
        buy: 'Buy on gamma.io',
      }
    : {
        eyebrow: 'REVEALED · Bitcoin-Ordinal · Glitch Art · Johannes × Olaf',
        line: 'Gemalt von Olaf, geglitcht von Johannes. Für die Ewigkeit inscribed.',
        buy: 'Bei gamma.io kaufen',
      };

// „Interesse anfragen" pro Werk: mailto mit vorausgefülltem Betreff + Text (Titel, Werk-Nummer und
// Link zur Werk-Seite), damit die Anfrage bei team@haushoppe.de eindeutig zuzuordnen ist. Empfänger
// kommt aus site.ts (eine Quelle). Ordinals bekommen keinen (eigener Kauf-Flow).
const rawTitle = ((lang === 'en' ? meta?.en?.title || meta?.title : meta?.title) || title || art.title || '').trim();
const num = (meta?.number || '').trim();
const numSuffix = num ? ` (${num})` : '';
// Werk-Referenz für Betreff/Text: „Titel“ (Nummer). Fehlt der Titel (unbetitelte Werke), nur die
// Nummer statt eines leeren „“; fehlt auch die, generisch „dieses Werk“.
const named = rawTitle
  ? lang === 'en'
    ? `"${rawTitle}"${numSuffix}`
    : `„${rawTitle}“${numSuffix}`
  : num
    ? lang === 'en'
      ? `artwork ${num}`
      : `Werk ${num}`
    : lang === 'en'
      ? 'this artwork'
      : 'dieses Werk';
const workUrl = new URL(Astro.url.pathname, SELF_ORIGIN).href;
// Holzschnitte haben einen festen Preis: in die Mail aufnehmen und statt „Preis erfahren" nach der
// Verfügbarkeit fragen. Andere Werke (Gemälde) bleiben ohne Preis (Anfrage zu Verfügbarkeit UND Preis).
const woodcut = isWoodcut(meta);
const price = woodcut ? woodcutPrice(lang) : null;
const bodyLead = woodcut
  ? lang === 'en'
    ? `I'm interested in ${named} and would be glad to hear about availability.`
    : `Ich interessiere mich für ${named} und bitte um Rückmeldung zur Verfügbarkeit.`
  : lang === 'en'
    ? `I'm interested in ${named} and would like to know more about availability and price.`
    : `Ich interessiere mich für ${named} und würde gern mehr zu Verfügbarkeit und Preis erfahren.`;
const inquire = {
  label: lang === 'en' ? 'Enquire' : 'Interesse anfragen',
  aria: lang === 'en' ? `Enquire about ${named}` : `Interesse an ${named} anfragen`,
  subject: lang === 'en' ? `Interest in ${named}` : `Interesse an ${named}`,
  body: [
    bodyLead,
    ...(price ? ['', lang === 'en' ? `Price: ${price.amount} (${price.note})` : `Preis: ${price.amount} (${price.note})`] : []),
    '',
    workUrl,
  ].join('\r\n'),
};
const inquireHref = `mailto:${contact.email}?subject=${encodeURIComponent(inquire.subject)}&body=${encodeURIComponent(inquire.body)}`;
---

{
  ord ? (
    <div class="entry-content clear ordinal-content" itemprop="text" data-testid="ordinal-stage">
      <div class="ordinal-inner">
        <p class="ordinal-eyebrow">{t.eyebrow}</p>
        {title && (
          <h1 class="ordinal-title" itemprop="headline">
            {title}
          </h1>
        )}
        <div class="ordinal-frame">
          <iframe
            src={ord.iframe}
            title={art.title}
            loading="lazy"
            referrerpolicy="no-referrer"
            sandbox="allow-scripts allow-same-origin"
          />
        </div>
        <p class="ordinal-caption">{t.line}</p>
        {ord.buy && (
          <a class="ordinal-buy" href={ord.buy} target="_blank" rel="noopener" data-testid="ordinal-buy">
            {t.buy}
          </a>
        )}
      </div>
    </div>
  ) : (
    <div class="entry-content clear" itemprop="text">
      <figure class="wp-block-image size-large art-figure" data-testid="artwork-image">
        <Picture
          src={image}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 960, 1440]}
          sizes="(max-width: 1000px) 92vw, 900px"
          alt={art.title}
          loading="eager"
        />
        {meta && <ArtworkMeta meta={meta} lang={lang} />}
      </figure>
      <p class="art-inquire-wrap">
        <a class="art-inquire" href={inquireHref} aria-label={inquire.aria} data-testid="inquire-link">
          <svg class="art-inquire__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" stroke="currentColor" stroke-width="1.6" />
            <path d="M3.5 6.5l8.5 6 8.5-6" stroke="currentColor" stroke-width="1.6" />
          </svg>
          <span>{inquire.label}</span>
        </a>
      </p>
      {Extra && (
        <div class="art-extra">
          <Extra />
        </div>
      )}
    </div>
  )
}

<style is:global>
  /* Zusatz-Content (Werkbeschreibung / Video / Auszeichnung) unter dem Bild — lesbare Prosa-Spalte. */
  .art-extra {
    max-width: 900px;
    margin: 1.5rem auto 0;
    font-size: 1.02rem;
    line-height: 1.7;
    color: #2a2a2a;
  }
  .art-extra > :first-child {
    margin-top: 0;
  }
  .art-extra p {
    margin: 0 0 1rem;
  }
  .art-extra p:last-child {
    margin-bottom: 0;
  }
  .art-extra h2,
  .art-extra h3 {
    font-family: var(--serif);
    font-weight: 400;
    margin: 1.5rem 0 0.5rem;
  }
  .art-extra a {
    color: #000;
    text-decoration: underline;
  }
  .art-extra .yt-facade {
    margin: 1.25rem 0 0;
  }
  /* „Interesse anfragen" pro Werk — dezenter mailto-Link unter der Beschriftung. */
  .art-inquire-wrap {
    text-align: center;
    margin: 1.1rem 0 0;
  }
  .art-inquire {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 0.2em;
    color: var(--muted);
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .art-inquire__icon {
    width: 1.1em;
    height: 1.1em;
    flex: none;
    opacity: 0.85;
  }
  .art-inquire span {
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }
  .art-inquire:hover,
  .art-inquire:focus-visible {
    color: var(--ink);
  }
  .art-inquire:hover span,
  .art-inquire:focus-visible span {
    border-bottom-color: currentColor;
  }
  /* Ordinals: durchgehend schwarze Bühne für die On-Chain-Inschrift (full-bleed, wie eine
     dunkle Galeriewand). Titel + Inschrift + CTA gestapelt und zentriert. */
  .ordinal-content {
    background: #000;
    color: #f4f4f4;
    padding: clamp(2.5rem, 6vw, 5rem) var(--pad);
  }
  .ordinal-inner {
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
  }
  .ordinal-eyebrow {
    margin: 0 0 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9a9a9a;
  }
  .ordinal-title {
    margin: 0 0 clamp(1.75rem, 4vw, 2.75rem);
    font-family: var(--serif);
    font-weight: 400;
    line-height: 1.2;
    color: #fff;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    text-wrap: balance;
  }
  .ordinal-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 820px;
    margin: 0 auto;
    background: #000;
  }
  .ordinal-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .ordinal-caption {
    margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
    max-width: 560px;
    color: #b4b4b4;
    line-height: 1.6;
  }
  /* Eckige CTA (kein Border-Radius): Outline → Hover invertiert. */
  .ordinal-buy {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.5rem;
    padding: 0.75em 1.5em;
    border: 1px solid #f4f4f4;
    color: #f4f4f4;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .ordinal-buy:hover,
  .ordinal-buy:focus-visible {
    background: #f4f4f4;
    color: #000;
  }
</style>
