---
// Inhalt einer Kunstwerk-Detailseite: normalerweise das große Bild, bei den 5 Ordinals
// stattdessen die Live-Inschrift (ordinalsbot-iframe) + Kauf-Link mit invertiertem Design.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ordinalData } from '../lib/ordinals';
import ArtworkMeta from './ArtworkMeta.astro';
import metaData from '../data/artwork-meta.json';

interface Props {
  art: any;
  image: ImageMetadata;
  lang?: 'de' | 'en';
  title?: string;
  Extra?: any; // gerenderter Zusatz-Content (Beschreibung/Video) aus der artworkExtra-Collection
}
const { art, image, lang = 'de', title, Extra } = Astro.props;
const ord = ordinalData(art);
// Strukturierte Werk-Beschriftung (Ordinals bekommen keine — eigener Sonderfall).
// Key = trid (für DE + EN identisch).
const meta = ord ? null : (metaData as Record<string, any>)[art.trid];
const t =
  lang === 'en'
    ? {
        eyebrow: 'REVEALED · Bitcoin Ordinal · Glitch Art · Johannes × Olaf',
        line: 'Painted by Olaf, glitched by Johannes. Inscribed forever.',
        buy: 'Buy on gamma.io',
      }
    : {
        eyebrow: 'REVEALED · Bitcoin-Ordinal · Glitch Art · Johannes × Olaf',
        line: 'Gemalt von Olaf, geglitcht von Johannes. Für die Ewigkeit inscribed.',
        buy: 'Bei gamma.io kaufen',
      };
---

{
  ord ? (
    <div class="entry-content clear ordinal-content" itemprop="text">
      <div class="ordinal-inner">
        <p class="ordinal-eyebrow">{t.eyebrow}</p>
        {title && (
          <h1 class="ordinal-title" itemprop="headline">
            {title}
          </h1>
        )}
        <div class="ordinal-frame">
          <iframe
            src={ord.iframe}
            title={art.title}
            loading="lazy"
            referrerpolicy="no-referrer"
            sandbox="allow-scripts allow-same-origin"
          />
        </div>
        <p class="ordinal-caption">{t.line}</p>
        {ord.buy && (
          <a class="ordinal-buy" href={ord.buy} target="_blank" rel="noopener">
            {t.buy}
          </a>
        )}
      </div>
    </div>
  ) : (
    <div class="entry-content clear" itemprop="text">
      <figure class="wp-block-image size-large art-figure">
        <Picture
          src={image}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 960, 1440]}
          sizes="(max-width: 1000px) 92vw, 900px"
          alt={art.title}
          loading="eager"
        />
        {meta && <ArtworkMeta meta={meta} lang={lang} />}
      </figure>
      {art.award && (
        <p class="art-award">
          <span class="art-award__label">{lang === 'en' ? 'Award' : 'Auszeichnung'}</span>
          <Fragment set:html={art.award} />
        </p>
      )}
      {Extra && (
        <div class="art-extra">
          <Extra />
        </div>
      )}
    </div>
  )
}

<style is:global>
  /* Auszeichnung/Preis eines Werks (z. B. „Die geschlossene Tür" 2015): dezente Notiz unter dem
     Bild, linksbündig zur Bildbreite, mit Akzentkante. Nur Werke mit award-Feld zeigen sie. */
  .art-award {
    max-width: 900px;
    margin: 1.25rem auto 0;
    padding: 0.85rem 1.1rem;
    border-left: 3px solid var(--rule, #000);
    background: #f7f7f7;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #333;
  }
  .art-award__label {
    display: inline-block;
    margin-right: 0.5em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: #000;
  }
  .art-award a {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* Zusatz-Content (Werkbeschreibung / Video) unter dem Bild — lesbare Prosa-Spalte. */
  .art-extra {
    max-width: 900px;
    margin: 1.5rem auto 0;
    font-size: 1.02rem;
    line-height: 1.7;
    color: #2a2a2a;
  }
  .art-extra > :first-child {
    margin-top: 0;
  }
  .art-extra p {
    margin: 0 0 1rem;
  }
  .art-extra p:last-child {
    margin-bottom: 0;
  }
  .art-extra h2,
  .art-extra h3 {
    font-family: var(--serif);
    font-weight: 400;
    margin: 1.5rem 0 0.5rem;
  }
  .art-extra a {
    color: #000;
    text-decoration: underline;
  }
  .art-extra .yt-facade {
    margin: 1.25rem 0 0;
  }
  /* Ordinals: durchgehend schwarze Bühne für die On-Chain-Inschrift (full-bleed, wie eine
     dunkle Galeriewand). Titel + Inschrift + CTA gestapelt und zentriert. */
  .ordinal-content {
    background: #000;
    color: #f4f4f4;
    padding: clamp(2.5rem, 6vw, 5rem) var(--pad);
  }
  .ordinal-inner {
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
  }
  .ordinal-eyebrow {
    margin: 0 0 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9a9a9a;
  }
  .ordinal-title {
    margin: 0 0 clamp(1.75rem, 4vw, 2.75rem);
    font-family: var(--serif);
    font-weight: 400;
    line-height: 1.2;
    color: #fff;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    text-wrap: balance;
  }
  .ordinal-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 820px;
    margin: 0 auto;
    background: #000;
  }
  .ordinal-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .ordinal-caption {
    margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
    max-width: 560px;
    color: #b4b4b4;
    line-height: 1.6;
  }
  /* Eckige CTA (kein Border-Radius): Outline → Hover invertiert. */
  .ordinal-buy {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.5rem;
    padding: 0.75em 1.5em;
    border: 1px solid #f4f4f4;
    color: #f4f4f4;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .ordinal-buy:hover,
  .ordinal-buy:focus-visible {
    background: #f4f4f4;
    color: #000;
  }
</style>
