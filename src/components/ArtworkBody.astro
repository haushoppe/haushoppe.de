---
// Inhalt einer Kunstwerk-Detailseite: normalerweise das große Bild, bei den 5 Ordinals
// stattdessen die Live-Inschrift (ordinalsbot-iframe) + Kauf-Link mit invertiertem Design.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { ordinalData } from '../lib/ordinals';
import ArtworkMeta from './ArtworkMeta.astro';
import { contact } from '../data/site';
import { SELF_ORIGIN } from '../lib/lang';
import { isWoodcut, woodcutPrice } from '../lib/pricing';
import WoodcutBuy from './WoodcutBuy.astro';

interface Props {
  art: CollectionEntry<'artworks'>;
  image: ImageMetadata;
  lang?: 'de' | 'en';
  title?: string;
}
const { art, image, lang = 'de', title } = Astro.props;
// Der Prosa-Body des Werks kommt als DEFAULT-SLOT (nicht als Prop): nur so sammelt Astro die
// Styles/Scripts der darin genutzten Komponenten (Slideshow, YouTube) für die Werk-Seite ein.
// Als durchgereichter Prop gingen die scoped Styles verloren (Slideshow lag ohne CSS im Fluss).
const hasExtra = Astro.slots.has('default');
const ord = ordinalData(art);
const side = art.data[lang];
// Strukturierte Werk-Beschriftung (Ordinals bekommen keine — eigener Sonderfall), bereits für die
// aktive Sprache aufgelöst.
const meta = ord
  ? null
  : {
      artist: art.data.artist,
      title: side.captionTitle,
      year: art.data.year,
      technique: side.technique,
      dimensions: side.dimensions,
      number: art.data.number,
      edition: side.edition,
    };
const t =
  lang === 'en'
    ? {
        eyebrow: 'REVEALED · Bitcoin Ordinal · Glitch Art · Johannes × Olaf',
        line: 'Painted by Olaf, glitched by Johannes. Inscribed forever.',
        buy: 'Buy on gamma.io',
      }
    : {
        eyebrow: 'REVEALED · Bitcoin-Ordinal · Glitch Art · Johannes × Olaf',
        line: 'Gemalt von Olaf, geglitcht von Johannes. Für die Ewigkeit inscribed.',
        buy: 'Bei gamma.io kaufen',
      };

// „Interesse anfragen" pro Werk: mailto mit vorausgefülltem Betreff + Text (Titel, Werk-Nummer und
// Link zur Werk-Seite), damit die Anfrage bei team@haushoppe.de eindeutig zuzuordnen ist. Empfänger
// kommt aus site.ts (eine Quelle). Ordinals bekommen keinen (eigener Kauf-Flow).
const rawTitle = (side.captionTitle || title || side.title || '').trim();
const num = (art.data.number || '').trim();
const numSuffix = num ? ` (${num})` : '';
// Werk-Referenz für Betreff/Text: „Titel“ (Nummer). Fehlt der Titel (unbetitelte Werke), nur die
// Nummer statt eines leeren „“; fehlt auch die, generisch „dieses Werk“.
const named = rawTitle
  ? lang === 'en'
    ? `"${rawTitle}"${numSuffix}`
    : `„${rawTitle}“${numSuffix}`
  : num
    ? lang === 'en'
      ? `artwork ${num}`
      : `Werk ${num}`
    : lang === 'en'
      ? 'this artwork'
      : 'dieses Werk';
const workUrl = new URL(Astro.url.pathname, SELF_ORIGIN).href;
// Slug für die PayPal-Kaufbox (Kennzeichnung der Bestellung) — aus dem Werk oder dem Pfad.
const slug = (side.slug || Astro.url.pathname.split('/').filter(Boolean).pop() || '').trim();
// Holzschnitte haben einen festen Preis: in die Mail aufnehmen und statt „Preis erfahren" nach der
// Verfügbarkeit fragen. Andere Werke (Gemälde) bleiben ohne Preis (Anfrage zu Verfügbarkeit UND Preis).
// Erkennung sprachneutral über die DE-Technik + Werk-Nummer.
const woodcut = isWoodcut({ technique: art.data.de.technique, number: art.data.number });
const price = woodcut ? woodcutPrice(lang) : null;
const bodyLead = woodcut
  ? lang === 'en'
    ? `I'm interested in ${named} and would be glad to hear about availability.`
    : `Ich interessiere mich für ${named} und bitte um Rückmeldung zur Verfügbarkeit.`
  : lang === 'en'
    ? `I'm interested in ${named} and would like to know more about availability and price.`
    : `Ich interessiere mich für ${named} und würde gern mehr zu Verfügbarkeit und Preis erfahren.`;
const inquire = {
  label: lang === 'en' ? 'Enquire' : 'Unverbindlich anfragen',
  aria: lang === 'en' ? `Enquire about ${named}` : `Zu ${named} unverbindlich anfragen`,
  subject: lang === 'en' ? `Interest in ${named}` : `Interesse an ${named}`,
  body: [
    bodyLead,
    ...(price ? ['', lang === 'en' ? `Price: ${price.amount} (${price.note})` : `Preis: ${price.amount} (${price.note})`] : []),
    '',
    workUrl,
  ].join('\r\n'),
};
// E-Mail NICHT als Klartext-mailto ins HTML (sonst greift Cloudflares Email-Obfuscation und
// injiziert ihr eigenes Script). Adresse geteilt in data-Attribute; ein kleines is:inline-Skript
// baut den mailto-Link mit Betreff/Text erst im Client. Ohne JS führt der Button zur Kontaktseite.
const [mailUser, mailDomain] = contact.email.split('@');
const inquireQuery = `?subject=${encodeURIComponent(inquire.subject)}&body=${encodeURIComponent(inquire.body)}`;
const contactHref = lang === 'en' ? '/contact/' : '/kontakt/';
---

{
  ord ? (
    <div class="entry-content clear ordinal-content" itemprop="text" data-testid="ordinal-stage">
      <div class="ordinal-inner">
        <p class="ordinal-eyebrow">{t.eyebrow}</p>
        {title && (
          <h1 class="ordinal-title" itemprop="headline">
            {title}
          </h1>
        )}
        <div class="ordinal-frame">
          <iframe
            src={ord.iframe}
            title={side.title}
            loading="lazy"
            referrerpolicy="no-referrer"
            sandbox="allow-scripts allow-same-origin"
          />
        </div>
        <p class="ordinal-caption">{t.line}</p>
        {ord.buy && (
          <a class="ordinal-buy" href={ord.buy} target="_blank" rel="noopener" data-testid="ordinal-buy">
            {t.buy}
          </a>
        )}
      </div>
    </div>
  ) : (
    <div class="entry-content clear" itemprop="text">
      {title && (
        <header class="entry-header">
          <h1 class="entry-title">{title}</h1>
        </header>
      )}
      <figure class="wp-block-image size-large art-figure" data-testid="artwork-image">
        <Picture
          src={image}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 960, 1440]}
          sizes="(max-width: 1120px) 92vw, 1056px"
          alt={title || side.title}
          loading="eager"
        />
        {meta && <ArtworkMeta meta={meta} />}
      </figure>
      {hasExtra && (
        <div class="art-extra">
          <slot />
        </div>
      )}
      {price && (
        <p class="art-buy-price" data-testid="artwork-price">
          {price.amount} <span class="art-buy-price__note">{price.note}</span>
        </p>
      )}
      {woodcut && <WoodcutBuy slug={slug} lang={lang} title={rawTitle} />}
      <p class="art-inquire-wrap">
        <a class="art-inquire" href={contactHref} data-inq-user={mailUser} data-inq-domain={mailDomain} data-inq-query={inquireQuery} aria-label={inquire.aria} data-testid="inquire-link">
          <svg class="art-inquire__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" stroke="currentColor" stroke-width="1.6" />
            <path d="M3.5 6.5l8.5 6 8.5-6" stroke="currentColor" stroke-width="1.6" />
          </svg>
          <span>{inquire.label}</span>
        </a>
      </p>
    </div>
  )
}

<script is:inline>
  // Baut den „Interesse anfragen"-mailto (Adresse aus data-Attributen, kein Klartext im HTML) im
  // Client. Läuft synchron beim Parsen (href steht vor dem load-Event) UND nach View-Transitions.
  (function () {
    function reveal() {
      document.querySelectorAll('a.art-inquire[data-inq-user]').forEach(function (a) {
        var u = a.dataset.inqUser,
          d = a.dataset.inqDomain;
        if (u && d) a.href = 'mailto:' + u + '@' + d + (a.dataset.inqQuery || '');
      });
    }
    reveal();
    if (!window.__inqReveal) {
      window.__inqReveal = true;
      document.addEventListener('astro:page-load', reveal);
    }
  })();
</script>

<style is:global>
  /* Der Werk-Block (Titel, Bild, Beschriftung, Kaufbox) schrumpft auf seine breiteste Zeile und
     zentriert sich als Ganzes: Titel und Beschriftung teilen die linke Bildkante, das Bild sitzt
     mittig auf der Seite. Große Bilder füllen die volle Breite (kein Unterschied), kleine Scans
     wirken zentriert deutlich besser als links gestrandet. Ordinals (dunkle Vollbild-Bühne) ausgenommen. */
  .entry-content:not(.ordinal-content) {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  /* Sehr kleine Scans (wenige Werke) bekommen einen Boden, damit sie nicht mikroskopisch wirken;
     hochauflösende Bilder liegen längst darüber und bleiben unberührt. */
  .art-figure img {
    min-width: 14rem;
  }
  /* Zusatz-Content (Werkbeschreibung / Video / Auszeichnung) unter dem Bild — lesbare Prosa-Spalte. */
  .art-extra {
    max-width: var(--container);
    margin: 1.5rem auto 0;
    font-size: 1.02rem;
    line-height: 1.7;
    color: #2a2a2a;
  }
  .art-extra > :first-child {
    margin-top: 0;
  }
  .art-extra p {
    margin: 0 0 1rem;
  }
  .art-extra p:last-child {
    margin-bottom: 0;
  }
  .art-extra h2,
  .art-extra h3 {
    font-family: var(--serif);
    font-weight: 400;
    margin: 1.5rem 0 0.5rem;
  }
  /* Fließtext auf lesbare Zeilenlänge begrenzen und zentrieren; Medien (Slideshow, Video)
     bleiben in voller Spaltenbreite. */
  .art-extra > p,
  .art-extra > h2,
  .art-extra > h3,
  .art-extra > ul,
  .art-extra > ol {
    max-width: 42rem;
    margin-inline: auto;
  }
  .art-extra a {
    color: #000;
    text-decoration: underline;
  }
  .art-extra .yt-facade {
    margin: 1.25rem 0 0;
  }
  /* Doku-Reihe: die fünf Film-Teile als kompaktes, 2-spaltiges Vorschau-Raster
     (statt fünf voll breiter Player). Mobil einspaltig. */
  .art-extra .doku-reihe {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .art-extra .doku-reihe .yt-facade {
    margin: 0;
  }
  /* „Demnächst"-Platzhalter (Teil 6) im gleichen 16:9-Format wie die Video-Facades. */
  .art-extra .doku-reihe .doku-soon {
    aspect-ratio: 16 / 9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: #eeeeee;
    border: 1px dashed #c4c4c4;
    text-align: center;
  }
  .art-extra .doku-reihe .doku-soon__nr {
    font-size: var(--fs-md);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6a6a6a;
  }
  .art-extra .doku-reihe .doku-soon__txt {
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9a9a9a;
  }
  @media (max-width: 560px) {
    .art-extra .doku-reihe {
      grid-template-columns: 1fr;
    }
  }
  /* „Interesse anfragen" pro Werk — dominanter mailto-CTA unter der Beschriftung (bei
     Holzschnitten zusätzlich zur PayPal-Kaufbox). */
  /* Preis-Zeile über der Kaufbox (Werke mit Zusatztext: Kaufteil steht unter der Story). */
  .art-buy-price {
    margin: 1.75rem 0 0;
    text-align: center;
    color: #3a3a3a;
    font-size: 1.02rem;
  }
  .art-buy-price__note {
    color: #6b6b6b;
    font-size: var(--fs-xs);
  }
  .art-inquire-wrap {
    text-align: center;
    margin: 1.5rem 0 0;
  }
  /* Dominanter CTA-Button (bei Gemälden der Haupt-CTA, bei Holzschnitten neben dem Kauf-Button):
     eckige Volltonfläche, invertiert beim Hover. */
  .art-inquire {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.85em 1.7em;
    background: var(--ink);
    color: #fff;
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid var(--ink);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .art-inquire__icon {
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }
  .art-inquire:hover,
  .art-inquire:focus-visible {
    background: #fff;
    color: var(--ink);
  }
  /* Ordinals: durchgehend schwarze Bühne für die On-Chain-Inschrift (full-bleed, wie eine
     dunkle Galeriewand). Titel + Inschrift + CTA gestapelt und zentriert. */
  .ordinal-content {
    background: #000;
    color: #f4f4f4;
    padding: clamp(2.5rem, 6vw, 5rem) var(--pad);
  }
  .ordinal-inner {
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
  }
  .ordinal-eyebrow {
    margin: 0 0 0.9rem;
    font-size: var(--fs-2xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9a9a9a;
  }
  .ordinal-title {
    margin: 0 0 clamp(1.75rem, 4vw, 2.75rem);
    font-family: var(--serif);
    font-weight: 400;
    line-height: 1.2;
    color: #fff;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    text-wrap: balance;
  }
  .ordinal-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 820px;
    margin: 0 auto;
    background: #000;
  }
  .ordinal-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .ordinal-caption {
    margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
    max-width: 560px;
    color: #b4b4b4;
    line-height: 1.6;
  }
  /* Eckige CTA (kein Border-Radius): Outline → Hover invertiert. */
  .ordinal-buy {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.5rem;
    padding: 0.75em 1.5em;
    border: 1px solid #f4f4f4;
    color: #f4f4f4;
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .ordinal-buy:hover,
  .ordinal-buy:focus-visible {
    background: #f4f4f4;
    color: #000;
  }
</style>
