---
// Inhalt einer Kunstwerk-Detailseite: normalerweise das große Bild, bei den 5 Ordinals
// stattdessen die Live-Inschrift (ordinalsbot-iframe) + Kauf-Link mit invertiertem Design.
import { ordinalData } from '../lib/ordinals';
import { artworkCaption } from '../lib/caption';

interface Props {
  art: any;
  img: { src: string; w: number; h: number };
  lang?: 'de' | 'en';
}
const { art, img, lang = 'de' } = Astro.props;
const ord = ordinalData(art);
// Bildunterschrift (Titel+Künstler · Technik/Maße · interne Nummer) aus dem WP-Content.
const cap = ord ? null : artworkCaption(art.content || '');
const t =
  lang === 'en'
    ? { line: 'This art has been eternally engraved on the Bitcoin blockchain.', buy: 'Buy it on', gamma: 'Gamma' }
    : { line: 'Dieses Werk ist für immer in die Bitcoin-Blockchain eingraviert.', buy: 'Erhältlich auf', gamma: 'Gamma' };
---

{
  ord ? (
    <div class="entry-content clear ordinal-content" itemprop="text">
      <div class="ordinal-frame">
        <iframe
          src={ord.iframe}
          title={art.title}
          loading="lazy"
          referrerpolicy="no-referrer"
          sandbox="allow-scripts allow-same-origin"
        />
      </div>
      <p class="ordinal-caption">
        {t.line}
        {ord.buy && (
          <>
            {' '}
            {t.buy}{' '}
            <a href={ord.buy} target="_blank" rel="noopener">
              {t.gamma}
            </a>
            .
          </>
        )}
      </p>
    </div>
  ) : (
    <div class="entry-content clear" itemprop="text">
      <figure class="wp-block-image size-large">
        <img width={img.w} height={img.h} src={img.src} alt={art.title} loading="eager" decoding="async" />
        {cap && (
          <figcaption class="art-caption">
            <span class="art-caption__title">{cap.line1}</span>
            {cap.line2 && <span class="art-caption__tech">{cap.line2}</span>}
            {cap.number && <span class="art-caption__num">{cap.number}</span>}
          </figcaption>
        )}
      </figure>
    </div>
  )
}

<style is:global>
  /* Ordinals: „geflipptes" Design — dunkle Bühne für die Live-Inschrift. */
  .ordinal-content {
    background: #0b0b0b;
    color: #f5f5f5;
    padding: clamp(1rem, 3vw, 2.5rem);
    border-radius: 4px;
  }
  .ordinal-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 640px;
    margin: 0 auto;
    background: #000;
  }
  .ordinal-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .ordinal-caption {
    text-align: center;
    margin: 1.5rem auto 0;
    max-width: 640px;
    color: #d8d8d8;
  }
  .ordinal-caption a {
    color: #fff;
    text-decoration: underline;
  }
  /* Bildunterschrift: Titel+Künstler · Technik/Maße · interne Nummer. */
  .art-caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.9rem;
    color: #6b6b6b;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .art-caption__title {
    color: #3a3a3a;
  }
  .art-caption__num {
    font-size: 0.82rem;
    color: #9a9a9a;
  }
</style>
