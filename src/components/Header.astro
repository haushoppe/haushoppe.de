---
// Sauberer Header (ersetzt das portierte Theme-Markup): Logo zentriert, darunter die
// Navigation als 700-px-Leiste mit schwarzen Linien oben/unten (wie live), Sprach-Flagge
// + Such-Icon rechts, mobil als Hamburger. Aktiver Menüpunkt + Sprach-Pendant server-seitig.
import { nav as navData, logo } from '../data/site';
import { OTHER_ORIGIN } from '../lib/lang';
import { normPath, altOf } from '../lib/paths';
import { getCollection } from 'astro:content';

interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;
// Standalone-Seiten mit placement:'nav' hinten ans Menü hängen (aktuelle Sprache).
const navPages = (await getCollection('pages'))
  .filter((p) => p.data.standalone && p.data.placement === 'nav' && p.data.path && p.id.endsWith(`-${lang}`))
  .map((p) => ({ href: `/${p.data.path}/`, label: p.data.navLabel || p.data.title }));
const items = [...navData[lang], ...navPages];

const path = normPath(Astro.url.pathname);
let activePath = path;
// Werk-Detail (/portfolio/…) UND Galerie-Kategorien (/werke/<kat>/, /artwork/<cat>/) zählen als „Werke".
if (/^\/portfolio\//.test(path) || /^\/(werke|artwork)\//.test(path)) {
  activePath = lang === 'en' ? '/artwork/' : '/werke/';
}

// Sprachwechsel: gleiches Werk/gleiche Seite auf der ANDEREN Domain (haushoppe.de ↔ haushoppe.art).
const altUrl = OTHER_ORIGIN + (altOf(path) || '/');
const flag = lang === 'en' ? 'de' : 'en';
const flagLabel = lang === 'en' ? 'Zur deutschen Seite wechseln' : 'Switch to the English site';
const searchLabel = lang === 'en' ? 'Search' : 'Suchen';
const homeHref = '/';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={homeHref} class="site-logo" aria-label={logo.alt}>
      <img src={logo.src} width={logo.width} height={logo.height} alt={logo.alt} decoding="async" />
    </a>
    <nav class="mainnav" aria-label={lang === 'en' ? 'Main menu' : 'Hauptmenü'}>
      <input type="checkbox" id="navtoggle" class="mainnav__toggle" hidden />
      <label for="navtoggle" class="mainnav__burger" aria-label="Menü"><span></span></label>
      <ul class="mainnav__list">
        {
          items.map((it) => (
            <li>
              <a
                href={it.href}
                class:list={['mainnav__link', it.href === activePath && 'is-active']}
                aria-current={it.href === activePath ? 'page' : undefined}
                data-text={it.label}
              >
                <span class="mainnav__label">{it.label}</span>
              </a>
            </li>
          ))
        }
        <li class="mainnav__extra">
          <a class="mainnav__lang" href={altUrl} aria-label={flagLabel}>
            <img
              src={`/wp-content/plugins/sitepress-multilingual-cms/res/flags/${flag}.png`}
              width="18"
              height="12"
              alt={flag === 'en' ? 'English' : 'Deutsch'}
              loading="lazy"
            />
          </a>
          <button type="button" class="mainnav__search" data-search-trigger aria-label={searchLabel}>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="7" stroke="currentColor" stroke-width="2"></circle>
              <path d="M20 20l-4.5-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    /* Luft oben wie im Original (vor der Logo-Vergrößerung). */
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }
  .site-header__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .site-logo {
    display: block;
    /* Luft Logo → erster schwarzer Streifen. */
    padding-bottom: 26px;
  }
  .site-logo img {
    /* Vektor-Nachbau des Original-Logos (viewBox 490×66 ~7.42:1): 360px → ~48px Höhe. */
    width: 360px;
    height: auto;
    max-width: 100%;
  }
  /* Nav-Leiste: zentriert, schwarze Linien oben+unten (wie live). */
  .mainnav {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 20px;
    width: 100%;
    max-width: 780px;
  }
  .mainnav__list {
    display: flex;
    justify-content: center;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    /* Zeilenhöhe wie live (~45px), Text mittig → ~12px Luft zu den Streifen. */
    min-height: 46px;
  }
  .mainnav__list > li:not(.mainnav__extra) {
    display: flex;
    align-items: stretch;
  }
  .mainnav__link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* 12px (statt 16) horizontal: mit dem 7. Menüpunkt („Camping") passt die Zeile sonst
       nicht in die 700px-Nav-Leiste (bräche in eine zweite Zeile um). */
    padding: 0 12px;
    font-weight: 400;
    color: #000;
    line-height: 1.2;
  }
  /* Tap-/Fokus-Feedback grau statt Browser-Blau (Android Chrome). */
  .mainnav__link,
  .mainnav__lang,
  .mainnav__search {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0.1);
  }
  /* Kein Verrutschen der Nav beim Fettschalten des aktiven Punkts: eine unsichtbare, fett
     gesetzte Kopie des Labels reserviert immer die Bold-Breite (height:0 → belegt keinen Platz,
     ändert nur die Mindestbreite). */
  .mainnav__link::after {
    content: attr(data-text);
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 700;
    pointer-events: none;
    user-select: none;
  }
  /* Ästhetischer Hover (Muster von haushoppe-its.de): ein 1px-Unterstrich wächst beim Hovern von
     links auf volle Textbreite — nur unter dem Text (background-size-Animation, kein Layout-Ruck). */
  .mainnav__label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.3s ease;
  }
  .mainnav__link:hover .mainnav__label,
  .mainnav__link:focus-visible .mainnav__label {
    background-size: 100% 1px;
  }
  .mainnav__link:hover,
  .mainnav__link.is-active {
    color: #000;
  }
  /* Aktive Seite markiert — fett, wie im alten System (.current_page_item > a). */
  .mainnav__link.is-active {
    font-weight: 700;
  }
  .mainnav__extra {
    display: flex;
    align-items: center;
    gap: 4px;
    padding-left: 8px;
  }
  .mainnav__lang {
    display: inline-flex;
    padding: 6px;
  }
  .mainnav__lang img {
    display: block;
    width: 18px;
    height: auto;
  }
  .mainnav__search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: none;
    color: #000;
    cursor: pointer;
    padding: 6px;
  }
  .mainnav__search:hover {
    color: var(--muted);
  }
  /* Hamburger nur mobil */
  .mainnav__burger {
    display: none;
  }
  /* Mobil: Logo links, Burger rechts (eine Zeile), Menü als Dropdown — wie live. */
  @media (max-width: 720px) {
    .site-header {
      padding-top: 0;
      position: relative;
      z-index: 50; /* über dem Menü-Scrim (40) — Header + offenes Menü bleiben klar, Rest dimmt */
      background: #fff;
    }
    .site-header__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-block: 0.85rem;
      border-bottom: 1px solid var(--rule);
    }
    .site-logo {
      padding-bottom: 0;
    }
    .site-logo img {
      width: 330px;
      max-width: calc(100vw - 90px);
    }
    .mainnav {
      border: 0;
      margin: 0;
      max-width: none;
      width: auto;
    }
    .mainnav__burger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      cursor: pointer;
    }
    .mainnav__burger span {
      position: relative;
    }
    .mainnav__burger span,
    .mainnav__burger span::before,
    .mainnav__burger span::after {
      content: '';
      display: block;
      width: 26px;
      height: 2px;
      background: #000;
    }
    .mainnav__burger span::before {
      position: absolute;
      top: -8px;
      left: 0;
    }
    .mainnav__burger span::after {
      position: absolute;
      top: 8px;
      left: 0;
    }
    .mainnav__list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      border-bottom: 1px solid var(--rule);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
      padding: 0;
      z-index: 60;
    }
    .mainnav__toggle:checked ~ .mainnav__list {
      display: flex;
    }
    /* Jeder Punkt: klar abgegrenzter, daumengroßer Tipp-Bereich, durch eine leichte Linie getrennt. */
    .mainnav__list > li + li {
      border-top: 1px solid rgba(0, 0, 0, 0.1);
    }
    .mainnav__link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 3.25rem;
      padding: 0 1.25rem;
      font-size: 1.05rem;
    }
    .mainnav__link.is-active {
      font-weight: 600;
    }
    /* Grauer Press-Zustand für die Menüreihen (statt blauem Tap-Highlight). */
    .mainnav__link:active {
      background: rgba(0, 0, 0, 0.06);
    }
    .mainnav__extra {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.75rem;
      min-height: 3.25rem;
      padding: 0;
    }
    .mainnav__lang,
    .mainnav__search {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>
