---
// Sauberer Header (ersetzt das portierte Astra-Markup): Logo zentriert, darunter die
// Navigation als 700-px-Leiste mit schwarzen Linien oben/unten (wie live), Sprach-Flagge
// + Such-Icon rechts, mobil als Hamburger. Aktiver Menüpunkt + Sprach-Pendant server-seitig.
import { nav as navData, logo } from '../data/site';
import langAlt from '../data/lang-alt.json';

interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;
const items = navData[lang];
const ALT = langAlt as Record<string, string>;

let path = Astro.url.pathname;
if (path !== '/' && !path.endsWith('/')) path += '/';
let activePath = path;
if (/^\/(en\/)?portfolio\//.test(path)) activePath = lang === 'en' ? '/en/artwork/' : '/werke/';

const altUrl = ALT[path] || (lang === 'en' ? '/' : '/en/');
const flag = lang === 'en' ? 'de' : 'en';
const flagLabel = lang === 'en' ? 'Zur deutschen Seite wechseln' : 'Switch to the English site';
const searchLabel = lang === 'en' ? 'Search' : 'Suchen';
const homeHref = lang === 'en' ? '/en/' : '/';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={homeHref} class="site-logo" aria-label={logo.alt}>
      <img src={logo.src} width={logo.width} height={logo.height} alt={logo.alt} decoding="async" />
    </a>
    <nav class="mainnav" aria-label={lang === 'en' ? 'Main menu' : 'Hauptmenü'}>
      <input type="checkbox" id="navtoggle" class="mainnav__toggle" hidden />
      <label for="navtoggle" class="mainnav__burger" aria-label="Menü"><span></span></label>
      <ul class="mainnav__list">
        {
          items.map((it) => (
            <li>
              <a
                href={it.href}
                class:list={['mainnav__link', it.href === activePath && 'is-active']}
                aria-current={it.href === activePath ? 'page' : undefined}
              >
                {it.label}
              </a>
            </li>
          ))
        }
        <li class="mainnav__extra">
          <a class="mainnav__lang" href={altUrl} aria-label={flagLabel}>
            <img
              src={`/wp-content/plugins/sitepress-multilingual-cms/res/flags/${flag}.png`}
              width="18"
              height="12"
              alt={flag === 'en' ? 'English' : 'Deutsch'}
              loading="lazy"
            />
          </a>
          <button type="button" class="mainnav__search" data-search-trigger aria-label={searchLabel}>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="7" stroke="currentColor" stroke-width="2"></circle>
              <path d="M20 20l-4.5-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }
  .site-header__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .site-logo {
    display: block;
    padding-bottom: 16px;
  }
  .site-logo img {
    width: 350px;
    height: auto;
    max-width: 100%;
  }
  /* Nav-Leiste: zentriert, schwarze Linien oben+unten (wie live). */
  .mainnav {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-top: -10px;
    margin-bottom: 20px;
    width: 100%;
    max-width: 700px;
  }
  .mainnav__list {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    min-height: 64px;
  }
  .mainnav__link {
    display: block;
    padding: 0.5rem 16px;
    font-weight: 700;
    color: #000;
    line-height: 1.2;
  }
  .mainnav__link:hover,
  .mainnav__link.is-active {
    color: #000;
  }
  .mainnav__extra {
    display: flex;
    align-items: center;
    gap: 4px;
    padding-left: 8px;
  }
  .mainnav__lang {
    display: inline-flex;
    padding: 6px;
  }
  .mainnav__lang img {
    display: block;
    width: 18px;
    height: auto;
  }
  .mainnav__search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: none;
    color: #000;
    cursor: pointer;
    padding: 6px;
  }
  .mainnav__search:hover {
    color: var(--muted);
  }
  /* Hamburger nur mobil */
  .mainnav__burger {
    display: none;
  }
  @media (max-width: 720px) {
    .mainnav {
      max-width: 100%;
      position: relative;
    }
    .mainnav__burger {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 52px;
      cursor: pointer;
      gap: 6px;
    }
    .mainnav__burger span,
    .mainnav__burger span::before,
    .mainnav__burger span::after {
      content: '';
      display: block;
      width: 26px;
      height: 2px;
      background: #000;
      position: relative;
    }
    .mainnav__burger span::before {
      position: absolute;
      top: -8px;
    }
    .mainnav__burger span::after {
      position: absolute;
      top: 8px;
    }
    .mainnav__list {
      display: none;
      flex-direction: column;
      align-items: center;
      padding-bottom: 0.75rem;
    }
    .mainnav__toggle:checked ~ .mainnav__list {
      display: flex;
    }
    .mainnav__link {
      padding: 0.6rem 1rem;
    }
    .mainnav__extra {
      padding: 0.4rem 0 0.2rem;
    }
  }
</style>
