---
// Startseiten-Inhalt UNTER dem HomeHero: 2 Spalten (Willkommenstext + Signatur | Werk).
// Das frühere Klick-Video entfällt — die Startseite eröffnet mit dem autoplayenden HomeHero.
// Inhalt kommt als `content`-Objekt aus index.astro (editierbar).
import Img from './Img.astro';
interface Content {
  video: { id: string; title: string; ratio: number };
  h1: string;
  welcome: { greeting: string; name: string };
  signature: { image: string; alt: string };
  featured: { image: string; alt: string; href: string; caption: string; award: string };
}
// Der Intro-Fließtext kommt als <slot/> (aus der MDX-Seite), Struktur aus `content`.
interface Props {
  content: Content;
}
const { content } = Astro.props;
---

<div class="home">
  <div class="home-cols">
    <figure class="home-featured">
      {
        content.featured.href ? (
          <a href={content.featured.href}>
            <Img name={content.featured.image} alt={content.featured.alt} widths={[400, 700, 1000]} sizes="(max-width: 720px) 90vw, 560px" />
          </a>
        ) : (
          <Img name={content.featured.image} alt={content.featured.alt} widths={[400, 700, 1000]} sizes="(max-width: 720px) 90vw, 560px" />
        )
      }
      <figcaption>
        {content.featured.href ? <a href={content.featured.href} set:html={content.featured.caption} /> : <span set:html={content.featured.caption} />}
      </figcaption>
      {content.featured.award && <p class="home-award" set:html={content.featured.award} />}
    </figure>
    <div class="home-text">
      <slot />
      <p class="home-signature">
        {content.welcome.greeting}<br />
        <Img name={content.signature.image} alt={content.signature.alt} widths={[300]} sizes="300px" /><br />
        {content.welcome.name}
      </p>
    </div>
  </div>
</div>

<style>
  .home {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--pad);
    /* Luft zum Hero darüber (der full-bleed Hero stößt sonst direkt an den Content). */
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  /* Desktop: Werk rechts, Willkommenstext links. Mobil: Werk, dann Text. */
  .home-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'text img';
    column-gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .home-text {
    grid-area: text;
  }
  .home-signature {
    margin-top: 1.5rem;
  }
  .home-signature :global(img) {
    display: block;
    width: 300px;
    max-width: 70%;
    height: auto;
    margin: 0.5rem 0;
  }
  .home-signature :global(picture) {
    display: block;
  }
  .home-featured {
    grid-area: img;
    margin: 0;
  }
  .home-featured :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .home-featured :global(picture) {
    display: block;
  }
  .home-featured figcaption {
    margin: 0.6rem 0 1rem;
  }
  .home-award {
    margin: 0;
  }
  @media (max-width: 720px) {
    .home-cols {
      grid-template-columns: 1fr;
      grid-template-areas: 'img' 'text';
    }
    .home-text {
      margin-top: 1.25rem;
    }
  }
</style>
