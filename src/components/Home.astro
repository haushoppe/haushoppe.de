---
// Saubere Startseite (ersetzt die portierten Stackable-Blöcke): Hero-Video als
// Datenschutz-Klick-Facade, darunter 2 Spalten (Willkommenstext + Signatur | Werk + Links).
// Inhalt kommt als `content`-Objekt aus index.astro / en/index.astro (editierbar).
import Img from './Img.astro';
interface Content {
  video: { id: string; title: string; ratio: number };
  h1: string;
  welcome: { greeting: string; name: string };
  signature: { image: string; alt: string };
  featured: { image: string; alt: string; href: string; caption: string; award: string };
}
// Der Intro-Fließtext kommt als <slot/> (aus der MDX-Seite), Struktur aus `content`.
interface Props {
  content: Content;
}
const { content } = Astro.props;
const v = content.video;
const facadeSrc = `https://www.youtube-nocookie.com/embed/${v.id}?autoplay=1&rel=0&playsinline=1&modestbranding=1`;
const poster = `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`;
---

<div class="home">
  <div class="yt-facade home-hero" data-src={facadeSrc} style={`aspect-ratio:${100 / v.ratio}`}>
    <button type="button" class="yt-facade__btn" aria-label={`Video abspielen: ${v.title}`}>
      <img class="yt-facade__poster" src={poster} alt={v.title} width="1280" height="720" loading="eager" decoding="async" />
      <span class="yt-facade__play" aria-hidden="true"></span>
    </button>
  </div>

  <div class="home-cols">
    <h1 class="home-h1">{content.h1}</h1>
    <figure class="home-featured">
      {
        content.featured.href ? (
          <a href={content.featured.href}>
            <Img name={content.featured.image} alt={content.featured.alt} widths={[400, 700, 1000]} sizes="(max-width: 720px) 90vw, 560px" />
          </a>
        ) : (
          <Img name={content.featured.image} alt={content.featured.alt} widths={[400, 700, 1000]} sizes="(max-width: 720px) 90vw, 560px" />
        )
      }
      <figcaption>
        {content.featured.href ? <a href={content.featured.href} set:html={content.featured.caption} /> : <span set:html={content.featured.caption} />}
      </figcaption>
      {content.featured.award && <p class="home-award" set:html={content.featured.award} />}
    </figure>
    <div class="home-text">
      <slot />
      <p class="home-signature">
        {content.welcome.greeting}<br />
        <Img name={content.signature.image} alt={content.signature.alt} widths={[300]} sizes="300px" /><br />
        {content.welcome.name}
      </p>
    </div>
  </div>
</div>

<style>
  .home {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--pad);
  }
  .home-hero {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  /* Desktop: H1 oben-links, Text darunter-links, Werk rechts (über beide Zeilen).
     Mobil: H1, dann Werk, dann Text (wie live). */
  .home-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'h1 img' 'text img';
    column-gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .home-h1 {
    grid-area: h1;
    margin: 0 0 1.2rem;
  }
  .home-text {
    grid-area: text;
  }
  .home-signature {
    margin-top: 1.5rem;
  }
  .home-signature :global(img) {
    display: block;
    width: 300px;
    max-width: 70%;
    height: auto;
    margin: 0.5rem 0;
  }
  .home-signature :global(picture) {
    display: block;
  }
  .home-featured {
    grid-area: img;
    margin: 0;
  }
  .home-featured :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .home-featured :global(picture) {
    display: block;
  }
  .home-featured figcaption {
    margin: 0.6rem 0 1rem;
  }
  .home-award {
    margin: 0;
  }
  @media (max-width: 720px) {
    .home-cols {
      grid-template-columns: 1fr;
      grid-template-areas: 'h1' 'img' 'text';
    }
    .home-h1 {
      margin-bottom: 1rem;
    }
    .home-text {
      margin-top: 1.25rem;
    }
  }
</style>
