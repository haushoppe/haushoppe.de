---
// Ein Akkordeon-Eintrag (natives <details>, kein JS) für die MDX-Seite „Kunst Erwerben".
// Titel als Prop, Panel-Inhalt als <slot/> (Markdown/HTML aus der MDX). Styling: AcquireArt.astro.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="acq-item">
  <summary><span>{title}</span></summary>
  <div class="acq-panel"><slot /></div>
</details>
