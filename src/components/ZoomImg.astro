---
// Optimiertes Inhaltsbild (AVIF/WebP + responsive) mit Lightbox-Anschluss: liefert zusätzlich
// `data-full` (große WebP-Version), damit die globale Lightbox scharf vergrößert. Wie <Img>,
// nur mit direktem ImageMetadata-`src` statt Namensauflösung aus src/assets/content.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
}
const { src, alt, widths = [400, 800], sizes = '(max-width: 700px) 90vw, 460px' } = Astro.props;
const w = widths.filter((x) => x <= src.width);
if (!w.length) w.push(src.width);
const full = await getImage({ src, format: 'webp', width: Math.min(src.width, 1600) });
---

<Picture src={src} formats={['avif', 'webp']} fallbackFormat="webp" widths={w} sizes={sizes} alt={alt} loading="lazy" decoding="async" data-full={full.src} />
