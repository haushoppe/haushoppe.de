---
// Konsistente Werk-Beschriftung aus strukturierten Feldern (aus der artworks-Collection, bereits
// für die aktive Sprache aufgelöst). Pflicht: Titel · Jahr · Technik · Maße · interne Nummer;
// optional: Auflage (nur Drucke). Der Preis steht separat im Kaufteil (ArtworkBody).
export interface ArtworkMetaData {
  artist: string;
  title: string; // bereinigter Beschriftungs-Titel (captionTitle)
  year: string;
  technique: string;
  dimensions: string; // „Maße" — Gemälde „90 × 170 cm", Druck „Motivgröße … Blattformat …"
  number: string;
  edition?: string; // Auflage (nur Drucke)
}

interface Props {
  meta: ArtworkMetaData;
}
const { meta } = Astro.props;

// Maße dimensional eindeutig: „79 × 110 cm" → „79 cm × 110 cm" (idempotent). „?" = unbekannt → weg.
const rawDim = (meta.dimensions || '').trim().replace(/(\d+)\s*×\s*(\d+)\s*cm/g, '$1 cm × $2 cm');
const dimensions = rawDim === '?' ? '' : rawDim;
const edition = (meta.edition || '').trim();
// Technik + Maße als eine saubere Zeile (kein JSX-Whitespace).
const techLine = [meta.technique, dimensions].filter(Boolean).join(', ');
---

<figcaption class="art-meta">
  <span class="art-meta__title">{meta.artist} · „{meta.title}“ · {meta.year}</span>
  {techLine && <span class="art-meta__tech">{techLine}</span>}
  {edition && <span class="art-meta__edition">{edition}</span>}
  {meta.number && <span class="art-meta__num" data-testid="artwork-number">{meta.number}</span>}
</figcaption>

<style>
  .art-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.9rem;
    color: #6b6b6b;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  .art-meta__title {
    color: #3a3a3a;
  }
  .art-meta__edition {
    font-size: var(--fs-sm);
  }
  /* Fester Holzschnitt-Preis — etwas kräftiger als die graue Beschriftung, mit kleiner MwSt/Versand-Notiz. */
  .art-meta__price {
    margin-top: 0.4rem;
    color: #3a3a3a;
    font-size: 1.02rem;
  }
  .art-meta__pricenote {
    color: #6b6b6b;
    font-size: var(--fs-xs);
  }
</style>
