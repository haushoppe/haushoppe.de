---
// Konsistente Werk-Beschriftung aus strukturierten Feldern (src/data/artwork-meta.json) —
// ersetzt das Raten aus dem uneinheitlichen WP-Content. Pflicht: Titel · Jahr · Technik ·
// Maße · interne Nummer; optional: Auflage (nur Drucke). Freier Text (Beschreibung, Quelle,
// Auszeichnung) lebt jetzt in der Content-Collection artwork-extra, nicht mehr hier.
export interface ArtworkMetaData {
  artist: string;
  title: string;
  year: string;
  technique: string;
  dimensions: string; // „Maße" — Gemälde „90 × 170 cm", Druck „Motivgröße … Blattformat …"
  number: string;
  edition?: string; // Auflage (nur Drucke)
  en?: { title?: string; technique?: string; dimensions?: string; edition?: string };
}

interface Props {
  meta: ArtworkMetaData;
  lang?: 'de' | 'en';
}
const { meta, lang = 'de' } = Astro.props;

// EN überschreibt nur die übersetzbaren Felder; Künstler/Jahr/Nummer bleiben identisch.
const en = lang === 'en' ? meta.en : undefined;
const title = en?.title || meta.title;
const technique = (en?.technique || meta.technique || '').trim();
// Maße sind sprachneutral: leeres EN fällt auf DE zurück. „?“ = unbekannt → nicht anzeigen.
// Maße dimensional eindeutig: „79 × 110 cm“ → „79 cm × 110 cm“ (idempotent, greift auch bei Handeingaben).
const rawDim = (en?.dimensions || meta.dimensions || '').trim().replace(/(\d+)\s*×\s*(\d+)\s*cm/g, '$1 cm × $2 cm');
const dimensions = rawDim === '?' ? '' : rawDim;
// leeres EN fällt auf DE zurück (wie Titel/Technik/Maße) — nicht ??, sonst bleibt EN leer statt DE.
const edition = (en?.edition || meta.edition || '').trim();
// Technik + Maße als eine saubere Zeile (kein JSX-Whitespace).
const techLine = [technique, dimensions].filter(Boolean).join(', ');
---

<figcaption class="art-meta">
  <span class="art-meta__title">{meta.artist} · „{title}“ · {meta.year}</span>
  {techLine && <span class="art-meta__tech">{techLine}</span>}
  {edition && <span class="art-meta__edition">{edition}</span>}
  {meta.number && <span class="art-meta__num">{meta.number}</span>}
</figcaption>

<style>
  .art-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.9rem;
    color: #6b6b6b;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .art-meta__title {
    color: #3a3a3a;
  }
  .art-meta__edition {
    font-size: 0.85rem;
  }
</style>
