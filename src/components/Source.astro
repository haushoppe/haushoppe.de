---
// Quellen-/Provenienz-Notiz eines Werks (z. B. Vorlage/Modell) — für die artworkExtra-Collection.
// Nutzung: <Source>Riae Tribal-Tattoo 2011</Source>  ·  EN: <Source label="Source">…</Source>
// <Source label="">…</Source> = ohne Label-Chip (nur die Notiz).
import { LANG } from '../lib/lang';
interface Props {
  label?: string;
}
// Label folgt der Build-Sprache (LANG) — so kann EINE sprach-neutrale MDX-Datei (z. B. eine
// Quellenangabe bei Werken mit gleichem DE/EN-Slug) in beiden Sprachen korrekt rendern.
const { label = LANG === 'en' ? 'Source' : 'Quelle' } = Astro.props;
---

<p class="art-source">
  {label && <span class="art-source__label">{label}</span>}
  <slot />
</p>

<style>
  .art-source {
    max-width: 900px;
    margin: 1rem auto 0;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: #777;
  }
  .art-source__label {
    margin-right: 0.45em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-2xs);
    color: #555;
  }
  .art-source :global(p) {
    display: inline;
    margin: 0;
  }
  .art-source :global(a) {
    color: inherit;
    text-decoration: underline;
  }
</style>
