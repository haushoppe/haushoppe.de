---
// Vollbreiter Seiten-Hero mit Textoverlay: großes Bild (astro:assets, AVIF/WebP responsiv),
// dunkler Scrim für Lesbarkeit, Überschrift (= H1 der Seite), Einladungssatz und optionaler
// CTA. Macht eine Standalone-Seite als echten Einstieg brauchbar. Bild kommt als ImageMetadata
// (aus src/assets/banners/ via bannerImage).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  lead?: string;
  ctaText?: string;
  ctaHref?: string;
}
const { image, alt, title, lead, ctaText, ctaHref } = Astro.props;
---

<section class="page-hero">
  <Picture
    src={image}
    formats={['avif', 'webp']}
    widths={[768, 1200, 1600]}
    sizes="100vw"
    alt={alt}
    loading="eager"
    decoding="async"
  />
  <div class="page-hero__scrim"></div>
  <div class="page-hero__inner">
    <h1 class="page-hero__title" data-testid="page-hero-title">{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    {ctaText && ctaHref && (
      <a class="page-hero__cta" href={ctaHref} data-testid="page-hero-cta">
        {ctaText}
      </a>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #1a1a1a;
  }
  .page-hero :global(picture) {
    position: absolute;
    inset: 0;
  }
  .page-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Scrim: Schwarz gezielt unten-links hinter dem Text konzentrieren (zwei Verläufe) —
     oben und rechts bleibt das Bild hell, statt das ganze Foto abzudunkeln. */
  .page-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.6) 20%, rgba(0, 0, 0, 0) 50%),
      linear-gradient(to right, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.15) 40%, rgba(0, 0, 0, 0) 68%);
  }
  /* Höhe exakt wie der Startseiten-Hero (feste rem-Höhe statt vh) — kein „Springen",
     beide Heros gleich hoch. Text sitzt unten. */
  .page-hero__inner {
    position: relative;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(1.75rem, 4vw, 3.25rem) var(--pad);
    color: #fff;
    min-height: 26rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  @media (min-width: 768px) {
    .page-hero__inner {
      min-height: 32rem;
    }
  }
  .page-hero__title {
    margin: 0 0 0.5rem;
    font-family: var(--serif);
    font-weight: 400;
    color: #fff;
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    line-height: 1.12;
    text-wrap: balance;
    /* Zusätzlicher enger Schatten (neben dem weichen Glow), damit die weiße Schrift auch über
       hellen Bildpartien (z. B. Gras/Hecke im Camping-Hero) eine klare Kante behält. */
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55), 0 1px 14px rgba(0, 0, 0, 0.5);
  }
  .page-hero__lead {
    margin: 0 0 1.35rem;
    max-width: 48ch;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6), 0 2px 12px rgba(0, 0, 0, 0.55);
  }
  .page-hero__cta {
    display: inline-block;
    align-self: flex-start;
    padding: 0.72rem 1.5rem;
    background: #fff;
    color: #141414;
    font-weight: 600;
    text-decoration: none;
  }
  .page-hero__cta:hover {
    background: rgba(255, 255, 255, 0.85);
  }
</style>
