---
// Rahmen für die Vita: Hero + Titel (aus MDX-Frontmatter) + Layout-CSS. Inhalt (Lebenslauf,
// Ausstellungen … als Markdown-Listen) kommt als <slot/> aus content/pages/vita-<lang>.mdx.
interface Props {
  hero?: { src: string; alt: string };
  h1?: string;
}
const { hero, h1 } = Astro.props;
---

<div class="vita">
  {
    hero && (
      <div class="cp-hero">
        <img src={hero.src} alt={hero.alt} loading="eager" decoding="async" />
      </div>
    )
  }
  {h1 && <h1 class="entry-title">{h1}</h1>}
  <slot />
</div>

<style>
  .vita {
    max-width: 1100px;
    margin: 0 auto;
  }
  .cp-hero img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    display: block;
    border-radius: 2px;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .entry-title {
    margin: 0 0 1.5rem;
  }
  /* Abschnitts-Überschriften (## im MDX) */
  .vita :global(h2) {
    margin: 2.5rem 0 0.85rem;
  }
  .vita :global(h2:first-of-type) {
    margin-top: 0;
  }
  /* Legende / Fließtext-Blöcke */
  .vita :global(p) {
    margin: 0 0 0.9rem;
  }
  /* Listen (Vertretende Galerie, Museen) — echte Bullets */
  .vita :global(ul) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
  }
  .vita :global(li) {
    margin: 0 0 0.3rem;
    line-height: 1.55;
  }
  /* Tabellen: Lebenslauf (Jahr | Ereignis), Ausstellungen (Jahr | Ausstellung | Art) */
  .vita :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }
  .vita :global(th) {
    text-align: left;
    padding: 0.5rem 0.7rem;
    border-bottom: 2px solid var(--ink);
    font-weight: 700;
  }
  .vita :global(td) {
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid #e8e6e2;
    vertical-align: top;
  }
  /* Jahres-Spalte: schmal, Ziffern gleich breit */
  .vita :global(td:first-child) {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .vita :global(table) {
      font-size: 0.88rem;
    }
    .vita :global(th),
    .vita :global(td) {
      padding: 0.4rem 0.5rem;
    }
  }
</style>
