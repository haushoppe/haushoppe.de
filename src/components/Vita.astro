---
// Rahmen für die Vita: Hero + Titel (aus MDX-Frontmatter) + Layout-CSS. Inhalt (Lebenslauf,
// Ausstellungen … als Markdown-Listen) kommt als <slot/> aus content/pages/vita-<lang>.mdx.
interface Props {
  hero?: { src: string; alt: string };
  h1?: string;
}
const { hero, h1 } = Astro.props;
---

<div class="vita">
  {
    hero && (
      <div class="cp-hero">
        <img src={hero.src} alt={hero.alt} loading="eager" decoding="async" />
      </div>
    )
  }
  {h1 && <h1 class="entry-title">{h1}</h1>}
  <slot />
</div>

<style>
  .vita {
    max-width: 1100px;
    margin: 0 auto;
  }
  .cp-hero img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    display: block;
    border-radius: 2px;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .entry-title {
    margin: 0 0 1.5rem;
  }
  /* Abschnitts-Überschriften (## im MDX) */
  .vita :global(h2) {
    margin: 2.5rem 0 0.85rem;
  }
  .vita :global(h2:first-of-type) {
    margin-top: 0;
  }
  /* Legende / Fließtext-Blöcke */
  .vita :global(p) {
    margin: 0 0 0.9rem;
  }
  /* Listen (Lebenslauf, Ausstellungen): ohne Bullets; führendes <strong> = fixe Jahres-Spalte. */
  .vita :global(ul) {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .vita :global(li) {
    margin: 0 0 0.35rem;
    line-height: 1.55;
  }
  .vita :global(li strong) {
    display: inline-block;
    min-width: 5.5rem;
  }
  @media (max-width: 640px) {
    .vita :global(li strong) {
      display: block;
      min-width: 0;
    }
  }
</style>
