---
// Generischer Rahmen für Standalone-Prosa-Seiten (Impressum, Datenschutz, Presse …):
// Titel als H1 + MDX-Body. Inhalt: src/content/pages/<name>-<lang>.mdx (standalone: true).
interface Props {
  title: string;
  hideTitle?: boolean; // wenn ein PageHero die Überschrift trägt: kein zweites H1
}
const { title, hideTitle = false } = Astro.props;
---

<article class="page">
  {!hideTitle && <h1 class="page__title">{title}</h1>}
  <div class="page__body"><slot /></div>
</article>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) 1rem;
  }
  .page__title {
    margin: 0 0 1.25rem;
  }
  .page__body :global(h2) {
    margin: 1.8rem 0 0.6rem;
  }
  .page__body :global(h3) {
    margin: 1.4rem 0 0.5rem;
  }
  .page__body :global(p),
  .page__body :global(ul),
  .page__body :global(ol) {
    margin: 0 0 1rem;
    line-height: 1.8;
  }
  /* Listen brauchen ihren Einzug zurück (sonst kleben die Bullets am linken Rand). */
  .page__body :global(ul),
  .page__body :global(ol) {
    padding-left: 1.5rem;
  }
  .page__body :global(a) {
    text-decoration: underline;
  }
  /* Hervorgehobene Notiz (z. B. Sicherheitshinweis) am Seitenende, mit Icon links. */
  .page__body :global(.cp-note) {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--ink);
    background: rgba(0, 0, 0, 0.05);
  }
  .page__body :global(.cp-note__icon) {
    flex: none;
    width: 60px;
    height: 60px;
  }
  .page__body :global(.cp-note p) {
    margin: 0;
  }
</style>
