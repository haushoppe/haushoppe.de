---
// Schmales Deko-Hero-Band einer Kategorieseite (zwischen Filter und Kacheln): schwarze Bühne, ein
// cinematisch gegradeter Werkstatt-Loop links, die rechte Kante weich nach Schwarz, ein Spruch
// rechts in weißer Serife. Reines Zitatband, nicht klickbar. Autoplay besorgt global
// hero-autoplay.js; bei prefers-reduced-motion steht das Poster-Standbild.
import type { ImageMetadata } from 'astro';
interface Props {
  clip: string;
  poster: ImageMetadata;
  quote: string;
  objectPosition?: string;
  testid: string;
}
const { clip, poster, quote, objectPosition = 'center 70%', testid } = Astro.props;
---

<figure class="cat-hero" data-testid={testid} style={`--cat-hero-pos: ${objectPosition}`}>
  <span class="cat-hero__media">
    <video class="cat-hero__video" src={clip} autoplay muted loop playsinline preload="metadata" poster={poster.src} aria-hidden="true"></video>
    <img class="cat-hero__still" src={poster.src} alt="" width={poster.width} height={poster.height} loading="lazy" decoding="async" />
  </span>
  <figcaption class="cat-hero__quote">{quote}</figcaption>
</figure>

<style>
  .cat-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 15rem;
    margin: 0 auto 1.75rem;
    padding: clamp(1.1rem, 3vw, 2.1rem);
    background: #030303;
    color: #fff;
    overflow: hidden;
  }
  .cat-hero__media {
    position: absolute;
    inset: 0 auto 0 0;
    width: 62%;
    z-index: 0;
    pointer-events: none;
  }
  .cat-hero__video,
  .cat-hero__still {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bildausschnitt je Kategorie justierbar, damit das Motiv (Werkzeug/Leinwand) sichtbar bleibt. */
    object-position: var(--cat-hero-pos);
    display: block;
  }
  .cat-hero__still {
    display: none;
  }
  /* Rechte Videokante weich nach Schwarz, damit der Spruch frei steht. */
  .cat-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, transparent 42%, rgba(3, 3, 3, 0.72) 78%, #030303 100%);
  }
  .cat-hero__quote {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 40%;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.6vw, 1.9rem);
    line-height: 1.25;
    color: #fff;
    text-wrap: balance;
  }
  @media (max-width: 720px) {
    .cat-hero {
      min-height: 13rem;
      align-items: flex-end;
      justify-content: flex-start;
    }
    .cat-hero__media {
      width: 100%;
    }
    .cat-hero__media::after {
      background: linear-gradient(180deg, rgba(3, 3, 3, 0.3) 0%, rgba(3, 3, 3, 0.8) 100%);
    }
    .cat-hero__quote {
      max-width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat-hero__video {
      display: none;
    }
    .cat-hero__still {
      display: block;
    }
  }
</style>
