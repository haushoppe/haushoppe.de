---
// Generischer Renderer für die einfachen Content-Seiten (Vita/Kontakt/Kunst-Erwerben/Videos)
// — Inhalt 1:1 aus dem Live-HTML (src/data/live-pages.json). YouTube-Videos werden später
// zur Datenschutz-Facade; aktuell noch die Original-Einbettungen.
import BaseLayout from '../layouts/BaseLayout.astro';
import livePages from '../data/live-pages.json';

const pages = livePages as Record<string, { title: string; article: string }>;

export function getStaticPaths() {
  const pages = livePages as Record<string, { title: string; article: string }>;
  return Object.entries(pages)
    .filter(([slug]) => slug !== 'videos') // /videos hat eine eigene Seite (Playlist-Grid)
    .map(([slug, data]) => ({ params: { page: slug }, props: { data } }));
}

const { data } = Astro.props as { data: { title: string; article: string } };
---

<BaseLayout title={data.title}>
  <Fragment set:html={data.article} />
</BaseLayout>
