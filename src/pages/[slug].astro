---
// Chrome-Seiten mit SPRACHSPEZIFISCHEM Slug (die übrigen — index/videos/vita/portfolio —
// haben eigene Dateien). Emittiert nur die Slugs der aktuellen Build-Sprache:
//   DE: /werke/ /kunst-erwerben/ /kontakt/     EN: /artwork/ /buy-fine-art/ /contact/
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import Kontakt from '../components/Kontakt.astro';
import AcquireArt from '../components/AcquireArt.astro';
import { galleryItems, galleryCategories } from '../lib/artworks';
import { loadPage } from '../lib/pages';
import Page from '../components/Page.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { bannerImage } from '../lib/banner-images';
import { LANG } from '../lib/lang';

export async function getStaticPaths() {
  const core =
    LANG === 'de'
      ? [
          { slug: 'werke', type: 'gallery' },
          { slug: 'kunst-erwerben', type: 'acquire' },
          { slug: 'kontakt', type: 'contact' },
        ]
      : [
          { slug: 'artwork', type: 'gallery' },
          { slug: 'buy-fine-art', type: 'acquire' },
          { slug: 'contact', type: 'contact' },
        ];
  // Standalone-Seiten (Impressum/Datenschutz/…) aus dem MDX-Frontmatter der aktuellen Sprache.
  const suffix = `-${LANG}`;
  const standalone = (await getCollection('pages'))
    .filter((p) => p.data.standalone && p.data.path && p.id.endsWith(suffix))
    .map((p) => ({ slug: p.data.path!, type: 'standalone', base: p.id.slice(0, -suffix.length) }));
  return [...core, ...standalone].map((p) => ({
    params: { slug: p.slug },
    props: { type: p.type, base: (p as any).base },
  }));
}

const { type, base } = Astro.props as {
  type: 'gallery' | 'acquire' | 'contact' | 'standalone';
  base?: string;
};

const META = {
  gallery: {
    de: { title: 'Werke - HAUS HOPPE', description: 'Gemälde und Holzschnitte von Olaf Hoppe.' },
    en: { title: 'Artwork - HAUS HOPPE', description: 'Paintings and woodcuts by Olaf Hoppe.' },
  },
  acquire: {
    de: { title: 'Kunst Erwerben - HAUS HOPPE', description: 'Kunst von Olaf Hoppe erwerben. Ratenzahlung, Leasing, Auftragswerke und individuelle Wünsche.' },
    en: { title: 'Acquire Art - HAUS HOPPE', description: 'Acquire art by Olaf Hoppe. Instalments, leasing, commissioned works and individual wishes.' },
  },
  contact: {
    de: { title: 'Kontakt - HAUS HOPPE', description: 'HAUS HOPPE – Galerie für Bildende Kunst, Olaf Hoppe. Öffnungszeiten, Kontakt und Anfahrt.' },
    en: { title: 'Contact - HAUS HOPPE', description: 'HAUS HOPPE – Galerie für Bildende Kunst, Olaf Hoppe. Opening hours, contact and directions.' },
  },
} as const;
// Standalone-Seite: Inhalt + Titel/Beschreibung aus dem MDX-Frontmatter.
let StandaloneContent: any = null;
let standaloneFm: any = null;
if (type === 'standalone' && base) {
  const loaded = await loadPage(base);
  StandaloneContent = loaded.Content;
  standaloneFm = loaded.data;
}

const meta =
  type === 'standalone'
    ? { title: `${standaloneFm.title} - HAUS HOPPE`, description: standaloneFm.description }
    : META[type as 'gallery' | 'acquire' | 'contact'][LANG];

const items = type === 'gallery' ? galleryItems(LANG) : [];
const cats = type === 'gallery' ? galleryCategories(LANG) : [];
const allLabel = LANG === 'de' ? 'Alle' : 'All';
const galleryBase = LANG === 'de' ? '/werke' : '/artwork';

// Kontakt & Kunst-Erwerben kommen aus MDX (content/pages/kontakt-<lang>.mdx / acquire-<lang>.mdx).
let MdxContent: any = null;
let acquireFm: any = null;
if (type === 'contact' || type === 'acquire') {
  const { Content, data } = await loadPage(type === 'contact' ? 'kontakt' : 'acquire');
  MdxContent = Content;
  if (type === 'acquire') acquireFm = data;
}
// Social-Preview: Kunst-Erwerben -> Hero-Bild, Kontakt -> Galerie-Foto. Sonst Marken-Karte (Default).
const ogName = type === 'acquire' ? acquireFm?.hero?.name : type === 'contact' ? 'haushoppe-stage' : undefined;
const ogSrc = ogName ? bannerImage(ogName) : undefined;
const ogImage = ogSrc ? (await getImage({ src: ogSrc, format: 'jpeg', width: 1200 })).src : undefined;
---

<BaseLayout title={meta.title} description={meta.description} image={ogImage}>
  {type === 'gallery' && <Gallery items={items} cats={cats} allLabel={allLabel} base={galleryBase} activeCat="*" heading={LANG === 'de' ? 'Werke' : 'Artwork'} total={items.length} />}
  {type === 'contact' && MdxContent && (
    <Kontakt>
      <MdxContent />
    </Kontakt>
  )}
  {type === 'acquire' && MdxContent && (
    <AcquireArt content={acquireFm}>
      <MdxContent />
    </AcquireArt>
  )}
  {type === 'standalone' && StandaloneContent && (
    <Fragment>
      {standaloneFm.hero && (
        <PageHero
          image={bannerImage(standaloneFm.hero.name)!}
          alt={standaloneFm.hero.alt}
          title={standaloneFm.title}
          lead={standaloneFm.hero.lead}
          ctaText={standaloneFm.hero.ctaText}
          ctaHref={standaloneFm.hero.ctaHref}
        />
      )}
      <Page title={standaloneFm.title} hideTitle={!!standaloneFm.hero}>
        <StandaloneContent />
      </Page>
    </Fragment>
  )}
</BaseLayout>
