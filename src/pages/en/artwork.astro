---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { galleryItems, galleryCategories } from '../../lib/artworks';

const items = galleryItems('en');
const cats = galleryCategories('en');
---

<BaseLayout lang="en" title="Artwork - HAUS HOPPE" description="Paintings and woodcuts by Olaf Hoppe.">
  <article class="page type-page ast-article-single">
    <div class="entry-content clear" itemprop="text">
      <Gallery items={items} cats={cats} allLabel="All" />
    </div>
  </article>
</BaseLayout>
