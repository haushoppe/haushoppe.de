---
import BaseLayout from '../../layouts/BaseLayout.astro';
import livePages from '../../data/live-pages-en.json';

export function getStaticPaths() {
  const pages = livePages as Record<string, { title: string; article: string }>;
  return Object.entries(pages)
    // alle Content-Seiten haben inzwischen eigene, sauber gebaute Astro-Seiten
    .filter(([slug]) => !['videos', 'buy-fine-art', 'vita', 'contact'].includes(slug))
    .map(([slug, data]) => ({ params: { page: slug }, props: { data } }));
}

const { data } = Astro.props as { data: { title: string; article: string } };
---

<BaseLayout lang="en" title={data.title}>
  <Fragment set:html={data.article} />
</BaseLayout>
