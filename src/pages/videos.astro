---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideosGallery from '../components/VideosGallery.astro';
import { LANG } from '../lib/lang';

const meta =
  LANG === 'de'
    ? { title: 'Videos', description: 'Videos rund um Olaf Hoppe und HAUS HOPPE. Holzschnitt, Malerei und mehr.' }
    : { title: 'Videos', description: 'Videos about Olaf Hoppe and HAUS HOPPE. Woodcut, painting and more.' };
---

<BaseLayout title={meta.title} description={meta.description} layout="boxed" image={`/og/videos-${LANG}.jpg`}>
  <h1 class="visually-hidden">Videos</h1>
  <VideosGallery lang={LANG} />
</BaseLayout>
