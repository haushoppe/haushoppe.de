---
// Galerie-Kategorieseiten: ECHTE URLs statt Client-Filter (/werke/<kat>/ bzw. /artwork/<cat>/).
// Sichtbarer Seitenwechsel, ohne JS voll sichtbar + crawlbar; mit ClientRouter sanfter Übergang.
// Emittiert nur die Kategorien der aktuellen Build-Sprache (LANG bestimmt Wurzel + Slugs).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import GlitchArtBanner from '../../components/GlitchArtBanner.astro';
import WoodcutHero from '../../components/WoodcutHero.astro';
import { galleryItems, galleryCategories } from '../../lib/artworks';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';
import { LANG, SELF_ORIGIN } from '../../lib/lang';

export async function getStaticPaths() {
  const slug = LANG === 'de' ? 'werke' : 'artwork';
  return (await galleryCategories(LANG)).map((c) => ({
    params: { slug, category: c.slug },
    props: { cat: c },
  }));
}

const { cat } = Astro.props as { cat: { slug: string; name: string; count: number } };
const base = LANG === 'de' ? '/werke' : '/artwork';
const allLabel = LANG === 'de' ? 'Alle' : 'All';
const cats = await galleryCategories(LANG);
const allItems = await galleryItems(LANG);
const items = allItems.filter((it) => it.categorySlugs.includes(cat.slug));
// Digitale Kunst (DE) / Digital Art (EN): eigene REVEALED-Collection-Seite, dunkles Theme + Logo + Ausstellungs-Video.
const isDigitalArt = cat.slug === 'digitale-kunst' || cat.slug === 'digital-art';
// Holzschnitte: breiter Druckmaschinen-Hero (Atlantis 4) zwischen Filter und Kacheln.
const isWoodcut = cat.slug === 'holzschnitte' || cat.slug === 'woodcuts';
const atlantis4 = items.find((it) => /atlantis-4/.test(it.detailUrl));
const description =
  LANG === 'de'
    ? `${cat.name} von Olaf Hoppe. HAUS HOPPE, Galerie für Bildende Kunst.`
    : `${cat.name} by Olaf Hoppe. HAUS HOPPE fine art gallery.`;
// Strukturierte Daten: Breadcrumb (Start → Werke → Kategorie) + ItemList (sichtbare Werk-Reihenfolge).
const jsonLd = [
  breadcrumbJsonLd([
    { name: LANG === 'de' ? 'Start' : 'Home', url: `${SELF_ORIGIN}/` },
    { name: LANG === 'de' ? 'Werke' : 'Artwork', url: `${SELF_ORIGIN}${base}/` },
    { name: cat.name, url: `${SELF_ORIGIN}${base}/${cat.slug}/` },
  ]),
  itemListJsonLd(items.map((it) => ({ name: it.title, url: SELF_ORIGIN + it.detailUrl }))),
];
---

<BaseLayout title={cat.name} description={description} jsonLd={jsonLd} inverted={isDigitalArt}>
  <Gallery items={items} cats={cats} allLabel={allLabel} base={base} activeCat={cat.slug} heading={cat.name} total={allItems.length} dark={isDigitalArt}>
    {isWoodcut && atlantis4 && <WoodcutHero slot="hero" lang={LANG} href={atlantis4.detailUrl} />}
  </Gallery>
  {isDigitalArt && <GlitchArtBanner lang={LANG} />}
</BaseLayout>
