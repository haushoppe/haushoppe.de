---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import { galleryItems, galleryCategories } from '../lib/artworks';

const items = galleryItems('de');
const cats = galleryCategories('de');
---

<BaseLayout title="Werke - HAUS HOPPE" description="Gemälde und Holzschnitte von Olaf Hoppe.">
  <Gallery items={items} cats={cats} allLabel="Alle" />
</BaseLayout>
