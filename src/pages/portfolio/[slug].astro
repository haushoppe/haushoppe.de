---
// Kunstwerk-Detailseite /portfolio/<slug>/ — 1:1 wie WP (CreativeWork: Titel + großes Bild).
// Sprache = Domain: derselbe Pfad in DE (haushoppe.de) und EN (haushoppe.art), je eigener Slug.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkBody from '../../components/ArtworkBody.astro';
import artworksData from '../../data/artworks.json';
import type { ImageMetadata } from 'astro';
import { artworkImage, hasArtworkImage } from '../../lib/artwork-images';
import { ordinalData } from '../../lib/ordinals';
import { LANG } from '../../lib/lang';

export function getStaticPaths() {
  const arts = artworksData as any[];
  const list = arts.filter((a) => a.type === 'portfolio' && a.lang === LANG && hasArtworkImage(a.id));
  // Prev/Next-Kette nur über die „normalen" Werke — Ordinals sind ein eigener dunkler
  // Sonderfall und werden übersprungen. Zyklisch, damit man endlos durchblättern kann.
  const chain = list.filter((a) => ordinalData(a) == null);
  const ref = (x: any, a: any) => (x && x.id !== a.id ? { slug: x.slug, title: x.title } : null);
  const around = (a: any) => {
    if (ordinalData(a) != null) return { prev: null, next: null };
    const i = chain.findIndex((x) => x.id === a.id);
    return { prev: ref(chain[(i - 1 + chain.length) % chain.length], a), next: ref(chain[(i + 1) % chain.length], a) };
  };
  return list.map((a) => ({ params: { slug: a.slug }, props: { art: a, image: artworkImage(a.id), ...around(a) } }));
}

const { art, image, prev, next } = Astro.props as {
  art: any;
  image: ImageMetadata;
  prev: { slug: string; title: string } | null;
  next: { slug: string; title: string } | null;
};
const desc = LANG === 'de' ? `${art.title} — Werk von Olaf Hoppe.` : `${art.title} — artwork by Olaf Hoppe.`;
// Ordinals: full-bleed schwarze Bühne (kein weißer Artikel-Kasten, Titel steht in der Bühne).
const isOrdinal = ordinalData(art) != null;
// Auf der Ordinal-Detailseite steht die Kollab schon im Eyebrow (Johannes × Olaf) — daher
// das „(Johannes x Olaf)" aus dem angezeigten Titel entfernen. In der Galerie bleibt es.
const displayTitle = isOrdinal ? art.title.replace(/\s*\(Johannes\s*[x×]\s*Olaf\)/i, '') : art.title;
---

<BaseLayout title={`${displayTitle} - HAUS HOPPE`} description={desc} layout={isOrdinal ? 'bleed' : 'article'} inverted={isOrdinal}>
  <article class:list={['art-single', isOrdinal && 'art-single--ordinal']} itemtype="https://schema.org/CreativeWork" itemscope>
    {
      !isOrdinal && (
        <header class="entry-header">
          <h1 class="entry-title" itemprop="headline">{art.title}</h1>
        </header>
      )
    }
    <ArtworkBody art={art} image={image} lang={LANG} title={displayTitle} />
    {
      !isOrdinal && (prev || next) && (
        <nav class="art-nav" aria-label={LANG === 'de' ? 'Weitere Werke' : 'More artworks'}>
          {prev ? (
            <a class="art-nav__link art-nav__prev" href={`/portfolio/${prev.slug}/`}>
              <span class="art-nav__arrow" aria-hidden="true">‹</span>
              <span class="art-nav__txt">
                <span class="art-nav__cap">{LANG === 'de' ? 'Vorheriges Werk' : 'Previous'}</span>
                <span class="art-nav__title">{prev.title}</span>
              </span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="art-nav__link art-nav__next" href={`/portfolio/${next.slug}/`}>
              <span class="art-nav__txt">
                <span class="art-nav__cap">{LANG === 'de' ? 'Nächstes Werk' : 'Next'}</span>
                <span class="art-nav__title">{next.title}</span>
              </span>
              <span class="art-nav__arrow" aria-hidden="true">›</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .art-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 900px;
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .art-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    max-width: 48%;
    color: #000;
    text-decoration: none;
  }
  .art-nav__next {
    margin-left: auto;
    text-align: right;
  }
  .art-nav__arrow {
    flex: none;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--muted);
  }
  .art-nav__txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .art-nav__cap {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .art-nav__title {
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .art-nav__link:hover .art-nav__title {
    text-decoration: underline;
  }
</style>
