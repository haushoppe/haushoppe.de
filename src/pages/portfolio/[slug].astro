---
// Kunstwerk-Detailseite /portfolio/<slug>/ (CreativeWork: Titel + großes Bild).
// Sprache = Domain: derselbe Pfad in DE (haushoppe.de) und EN (haushoppe.art), je eigener Slug.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkBody from '../../components/ArtworkBody.astro';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import { galleryItems, type Art } from '../../lib/artworks';
import { ordinalData } from '../../lib/ordinals';
import { artworkJsonLd, breadcrumbJsonLd, woodcutOffers } from '../../lib/seo';
import { isWoodcut } from '../../lib/pricing';
import { catSlug, catName } from '../../lib/categories';
import { smartQuotes } from '../../lib/text';
import { LANG, SELF_ORIGIN } from '../../lib/lang';

export async function getStaticPaths() {
  // Alle Werke mit Bild bekommen eine Detailseite (auch versteckte — per Direkt-URL erreichbar,
  // via noindex nicht indexiert).
  const arts = (await getCollection('artworks')).filter((a) => a.data.image);
  // Prev/Next in EXAKT der Galerie-Reihenfolge (chronologisch), inklusive Ordinals — zyklisch,
  // damit man endlos durchblättern kann. Versteckte Werke stehen nicht in der Galerie → kein Prev/Next.
  const artIds = new Set(arts.map((a) => a.id));
  const chain = (await galleryItems(LANG)).filter((it) => artIds.has(it.id));
  const idx = new Map(chain.map((it, i) => [it.id, i]));
  // Zweite Kette OHNE Ordinals — fürs Lightbox-Blättern (Ordinals haben kein Zoom-Bild).
  const ordinalIds = new Set(arts.filter((a) => ordinalData(a) != null).map((a) => a.id));
  const imgOrder = chain.filter((it) => !ordinalIds.has(it.id));
  const imgIdx = new Map(imgOrder.map((it, i) => [it.id, i]));
  const around = (a: Art) => {
    const i = idx.get(a.id);
    const full =
      i == null || chain.length < 2
        ? { prev: null, next: null }
        : {
            prev: { href: chain[(i - 1 + chain.length) % chain.length].detailUrl, title: chain[(i - 1 + chain.length) % chain.length].title },
            next: { href: chain[(i + 1) % chain.length].detailUrl, title: chain[(i + 1) % chain.length].title },
          };
    const j = imgIdx.get(a.id);
    const hasImgChain = j != null && imgOrder.length > 1;
    return {
      ...full,
      lbPrev: hasImgChain ? imgOrder[(j - 1 + imgOrder.length) % imgOrder.length].detailUrl : null,
      lbNext: hasImgChain ? imgOrder[(j + 1) % imgOrder.length].detailUrl : null,
    };
  };
  return arts.map((a) => ({
    params: { slug: a.data[LANG].slug },
    props: { art: a, image: a.data.image, ...around(a) },
  }));
}

const { art, image, prev, next, lbPrev, lbNext } = Astro.props as {
  art: Art;
  image: import('astro').ImageMetadata;
  prev: { href: string; title: string } | null;
  next: { href: string; title: string } | null;
  lbPrev: string | null;
  lbNext: string | null;
};
const side = art.data[LANG];
// Titel typografisch säubern (DE „…“, EN “…”); unbetitelte Werke heißen in der Anzeige
// „Ohne Titel" — sonst stünden leere h1/Seitentitel da.
const title = smartQuotes(side.title, LANG) || (LANG === 'en' ? 'Untitled' : 'Ohne Titel');
const desc = LANG === 'de' ? `${title}, Werk von Olaf Hoppe.` : `${title}, artwork by Olaf Hoppe.`;
// Ordinals: full-bleed schwarze Bühne (kein weißer Artikel-Kasten, Titel steht in der Bühne).
const isOrdinal = ordinalData(art) != null;
// Auf der Ordinal-Detailseite steht die Kollab schon im Eyebrow (Johannes × Olaf) — daher
// das „(Johannes x Olaf)" aus dem angezeigten Titel entfernen. In der Galerie bleibt es.
const displayTitle = isOrdinal ? title.replace(/\s*\(Johannes\s*[x×]\s*Olaf\)/i, '') : title;

// Optionaler Prosa-Body des Werks (Beschreibung/Video) — nur wenn für diese Sprache vorhanden.
// Die <De>/<En>-Blöcke im Body prunen die jeweils andere Sprache zur Build-Zeit weg.
const hasProse = LANG === 'de' ? art.data.prose?.de : art.data.prose?.en;
const ExtraContent = hasProse ? (await render(art)).Content : undefined;

// Breadcrumb: Start → Werke → Kategorie → Werk.
const gBase = LANG === 'de' ? '/werke' : '/artwork';
const cat = art.data.category;
const breadcrumb = breadcrumbJsonLd([
  { name: LANG === 'de' ? 'Start' : 'Home', url: `${SELF_ORIGIN}/` },
  { name: LANG === 'de' ? 'Werke' : 'Artwork', url: `${SELF_ORIGIN}${gBase}/` },
  { name: catName(cat, LANG), url: `${SELF_ORIGIN}${gBase}/${catSlug(cat, LANG)}/` },
  { name: title, url: `${SELF_ORIGIN}/portfolio/${side.slug}/` },
]);

// Social-Preview (das Werk als Bild) + angereichertes VisualArtwork-JSON-LD. Jedes Werk mit
// Detailseite hat ein Bild (auch Ordinals: ihr Galerie-Thumbnail), also für alle erzeugen.
const og = await getImage({ src: image, format: 'jpeg', width: 1200 });
const ogImage = og.src;
const artJsonLd = artworkJsonLd({
  origin: SELF_ORIGIN,
  title,
  image: new URL(og.src, SELF_ORIGIN).href,
  url: `${SELF_ORIGIN}/portfolio/${side.slug}/`,
  technique: side.technique,
  year: art.data.year,
  category: cat,
  // Holzschnitte sind online kaufbar -> Kauf-Angebote (ungerahmt/gerahmt) mit ins JSON-LD.
  offers: isWoodcut(cat) ? woodcutOffers(LANG, `${SELF_ORIGIN}/portfolio/${side.slug}/`) : undefined,
});
const jsonLd = [artJsonLd, breadcrumb];
---

<BaseLayout title={displayTitle} description={desc} layout={isOrdinal ? 'bleed' : 'article'} inverted={isOrdinal} type="article" image={ogImage} jsonLd={jsonLd} noindex={art.data.hidden}>
  <article
    class:list={['art-single', isOrdinal && 'art-single--ordinal']}
    data-lb-prev={lbPrev}
    data-lb-next={lbNext}
    itemtype="https://schema.org/CreativeWork"
    itemscope
  >
    {ExtraContent ? (
      <ArtworkBody art={art} image={image} lang={LANG} title={displayTitle}>
        <ExtraContent />
      </ArtworkBody>
    ) : (
      <ArtworkBody art={art} image={image} lang={LANG} title={displayTitle} />
    )}
    {
      (prev || next) && (
        <nav class="art-nav" aria-label={LANG === 'de' ? 'Weitere Werke' : 'More artworks'}>
          {prev ? (
            <a rel="prev" class="art-nav__link art-nav__prev" href={prev.href} data-testid="artwork-nav">
              <span class="art-nav__arrow" aria-hidden="true">‹</span>
              <span class="art-nav__txt">
                <span class="art-nav__cap">{LANG === 'de' ? 'Vorheriges Werk' : 'Previous'}</span>
                <span class="art-nav__title">{prev.title}</span>
              </span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a rel="next" class="art-nav__link art-nav__next" href={next.href} data-testid="artwork-nav">
              <span class="art-nav__txt">
                <span class="art-nav__cap">{LANG === 'de' ? 'Nächstes Werk' : 'Next'}</span>
                <span class="art-nav__title">{next.title}</span>
              </span>
              <span class="art-nav__arrow" aria-hidden="true">›</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .art-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--container);
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    padding: 1.25rem var(--pad) 0;
    border-top: 1px solid var(--rule);
  }
  .art-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    max-width: 48%;
    color: #000;
    text-decoration: none;
  }
  .art-nav__next {
    margin-left: auto;
    text-align: right;
  }
  .art-nav__arrow {
    flex: none;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--muted);
  }
  .art-nav__txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .art-nav__cap {
    font-size: var(--fs-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .art-nav__title {
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .art-nav__link:hover .art-nav__title {
    text-decoration: underline;
  }
  /* Ordinal-Detailseiten sind dunkel (body.theme-invert): Nav hell + Abstand nach unten,
     da die schwarze Bühne bis zum Footer durchläuft. */
  :global(body.theme-invert) .art-nav {
    border-top-color: rgba(255, 255, 255, 0.22);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  :global(body.theme-invert) .art-nav__link {
    color: #f4f4f4;
  }
  /* Dunkle Seiten: Pfeile/Label vom dunklen #666 auf den gedämpften Ton heben (lesbar auf Schwarz,
     ein Grauton weniger), Nachbar-Titel serifenlos wie der Ordinal-Titel. */
  :global(body.theme-invert) .art-nav__arrow,
  :global(body.theme-invert) .art-nav__cap {
    color: #b4b4b4;
  }
  :global(body.theme-invert) .art-nav__title {
    font-family: var(--sans);
  }
</style>
