---
// Eigene 404-Seite (statt Cloudflares Generik-404). Astro baut daraus 404.html, das Cloudflare
// Pages automatisch bei nicht gefundenen Pfaden ausliefert. Sprache = Domain (LANG).
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANG } from '../lib/lang';

const t =
  LANG === 'en'
    ? { title: 'Page not found', text: 'The page you are looking for does not exist or has moved.', works: 'View works', worksHref: '/artwork/', home: 'Home', homeHref: '/' }
    : { title: 'Seite nicht gefunden', text: 'Die gewünschte Seite existiert nicht (mehr) oder wurde verschoben.', works: 'Zu den Werken', worksHref: '/werke/', home: 'Startseite', homeHref: '/' };
---

<BaseLayout title={`${t.title} - HAUS HOPPE`} description={t.text}>
  <section class="notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1 class="notfound__title">{t.title}</h1>
    <p class="notfound__text">{t.text}</p>
    <div class="notfound__cta">
      <a class="notfound__btn" href={t.worksHref}>{t.works}</a>
      <a class="notfound__btn notfound__btn--ghost" href={t.homeHref}>{t.home}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(2rem, 7vw, 5rem) var(--pad);
    text-align: center;
  }
  .notfound__code {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 12vw, 7rem);
    line-height: 1;
    margin: 0;
    color: #cfcfcf;
    letter-spacing: -0.02em;
  }
  .notfound__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin: 0.25rem 0 1rem;
  }
  .notfound__text {
    color: #666;
    line-height: 1.6;
    margin: 0 0 2rem;
  }
  .notfound__cta {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .notfound__btn {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .notfound__btn--ghost {
    background: transparent;
    color: #000;
    border: 1px solid #000;
  }
</style>
