---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/Home.astro';
import { loadPage } from '../lib/pages';

// Startseite: Struktur (Video, Werk, Signatur) aus dem MDX-Frontmatter, Intro-Prosa aus dem
// MDX-Body (content/pages/home-<lang>.mdx). Sprache = Domain (LANG).
const { entry, Content, data: fm } = await loadPage('home');
// Klare Meldung statt kryptischem „Cannot read properties of undefined“, falls ein Pflicht-
// Frontmatter-Block der Startseite fehlt (Home.astro braucht diese Felder).
for (const req of ['video', 'h1', 'welcome', 'featured']) {
  if (!fm[req]) throw new Error(`${entry.id}.mdx: Frontmatter-Feld „${req}“ fehlt (Pflicht auf der Startseite).`);
}
---

<BaseLayout title={fm.title} description={fm.description}>
  <Home content={fm as any}>
    <Content />
  </Home>
</BaseLayout>
