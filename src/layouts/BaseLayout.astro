---
// Basis-Layout mit sauberen Header/Footer-Komponenten (statt portiertem Astra-Chrome).
// wp-design.css bleibt vorerst geladen (Galerie/Detailseiten), global.css gewinnt bei
// Konflikten; wird schrittweise durch schlankes CSS ersetzt.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import { LANG, DE_ORIGIN, EN_ORIGIN, SELF_ORIGIN } from '../lib/lang';
import { normPath, altOf } from '../lib/paths';
import '../styles/wp-design.css';
import '../styles/global.css';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/700.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'de' | 'en';
  // Inhaltsbreite: undefined = volle Breite (Content/Galerie), 'boxed' = 1200 zentriert
  // (Videos), 'article' = 1200 + weißer Kasten (Werk-Detail).
  layout?: 'boxed' | 'article';
}
const { title = 'HAUS HOPPE - Galerie für Bildende Kunst', description = '', lang = LANG, layout } = Astro.props;

// canonical + hreflang über die zwei Domains (Sprache = Domain, kein /en/-Pfad).
const path = normPath(Astro.url.pathname);
const otherPath = altOf(path) || path;
const dePath = lang === 'de' ? path : otherPath;
const enPath = lang === 'en' ? path : otherPath;
const canonical = SELF_ORIGIN + path;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={DE_ORIGIN + dePath} />
    <link rel="alternate" hreflang="en" href={EN_ORIGIN + enPath} />
    <link rel="alternate" hreflang="x-default" href={DE_ORIGIN + dePath} />
    <link rel="icon" href="/media/2020/11/cropped-logo-haushoppe-490.png" />
  </head>
  <body>
    <Header lang={lang} />
    <main class:list={['site-main', layout && `site-main--${layout}`]} data-pagefind-body>
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline src="/js/yt-facade.js"></script>
    <Search lang={lang} />
  </body>
</html>

<style is:global>
  /* YouTube-Klick-Facade (ersetzt die ayg-player-Custom-Elemente). */
  .yt-facade { position: relative; width: 100%; overflow: hidden; background: #000; }
  .yt-facade__btn { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; background: none; cursor: pointer; display: block; }
  .yt-facade__poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .yt-facade__play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 68px; height: 48px; background: rgba(0, 0, 0, 0.75); border-radius: 12px; transition: background 0.2s; }
  .yt-facade__play::before { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-40%, -50%); border-style: solid; border-width: 11px 0 11px 19px; border-color: transparent transparent transparent #fff; }
  .yt-facade__btn:hover .yt-facade__play { background: #f00; }
</style>
