---
// Basis-Layout mit Header/Footer-Komponenten. Styling aus global.css (Tailwind v4 inkl.
// Preflight) + Komponenten-CSS.
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import Lightbox from '../components/Lightbox.astro';
import { LANG, DE_ORIGIN, EN_ORIGIN, SELF_ORIGIN } from '../lib/lang';
import { normPath, altOf } from '../lib/paths';
import { galleryJsonLd } from '../lib/seo';
// Display-Schrift als Datei importieren -> gehashte URL, exakt die, die auch das @font-face nutzt
// (gleicher Content-Hash), damit der Preload keinen Doppel-Download auslöst.
import merriweather400 from '@fontsource/merriweather/files/merriweather-latin-400-normal.woff2';
import '../styles/global.css';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/700.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'de' | 'en';
  // Inhaltsbreite: undefined = volle Breite (Content/Galerie), 'boxed' = 1200 zentriert
  // (Videos), 'article' = 1200 + weißer Kasten (Werk-Detail), 'bleed' = volle Breite ohne
  // vertikales Padding (Ordinals: durchgehend schwarze Bühne bis Nav/Footer).
  layout?: 'boxed' | 'article' | 'bleed';
  // Ordinal-Seiten: „geflippter" dunkler Modus (dunkler Header + schwarzer Body), damit die
  // On-Chain-Inschrift vollflächig schwarz steht. Die Sprach-Flagge bleibt bewusst bunt.
  inverted?: boolean;
  // Social-Preview-Bild (absolut oder site-relativ). Ohne Angabe: /og-default.jpg.
  image?: string;
  // og:type (z. B. 'website' oder 'article').
  type?: string;
  // Strukturierte Daten (JSON-LD). Ohne Angabe: die Galerie als ArtGallery/LocalBusiness.
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  // "versteckt": Seite bleibt per Direkt-URL erreichbar, wird aber nicht indexiert (robots noindex)
  // und nicht in die Volltextsuche (pagefind) aufgenommen.
  noindex?: boolean;
}
const {
  title = 'HAUS HOPPE - Galerie für Bildende Kunst',
  description = '',
  lang = LANG,
  layout,
  inverted = false,
  image,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

// canonical + hreflang über die zwei Domains (Sprache = Domain, kein /en/-Pfad).
const path = normPath(Astro.url.pathname);
// Nur ECHTE Pendants als hreflang ausgeben: fehlt der Alt-Pfad (kein Sprach-Pendant), zeigt der
// Alternate sonst auf einen Cross-Domain-404. Dann lassen wir ihn weg (fail safe) — so kann eine
// neue Kategorie-/Standalone-Seite ohne Paar nie mehr still auf eine 404 verlinken.
const alt = await altOf(path);
const dePath = lang === 'de' ? path : alt;
const enPath = lang === 'en' ? path : alt;
const canonical = SELF_ORIGIN + path;
const xDefaultHref = dePath ? DE_ORIGIN + dePath : canonical;

// SEO/Social: Beschreibung nie leer, OG-Bild absolut, Locale je Sprache, Default-JSON-LD = Galerie.
const defaultDesc =
  lang === 'en'
    ? 'HAUS HOPPE – fine art gallery on the Baltic coast. Paintings and multi-coloured woodcuts by Olaf Hoppe.'
    : 'HAUS HOPPE – Galerie für Bildende Kunst an der Ostseeküste. Gemälde und mehrfarbige Holzschnitte von Olaf Hoppe.';
// Description auf ~160 Zeichen begrenzen (SERP-Snippet-Grenze), sauber am Wort abschneiden.
const rawDesc = description || defaultDesc;
const metaDesc = rawDesc.length <= 160 ? rawDesc : rawDesc.slice(0, 157).replace(/\s+\S*$/, '') + '…';
const siteName = lang === 'en' ? 'HAUS HOPPE – Fine Art Gallery' : 'HAUS HOPPE – Galerie für Bildende Kunst';
// Titel: Seiten übergeben den ROHEN Titel; hier den Marken-Suffix nur anhängen, solange der
// Gesamttitel die SERP-Grenze (~62 Zeichen) hält. Titel, die die Marke schon tragen
// (Startseite, Default), bleiben unangetastet.
const pageTitle = /HAUS HOPPE/i.test(title) ? title : `${title} – HAUS HOPPE`.length <= 62 ? `${title} – HAUS HOPPE` : title;
const ogLocale = lang === 'en' ? 'en_US' : 'de_DE';
const ogImageIsDefault = !image;
const ogImage = image ? new URL(image, SELF_ORIGIN).href : SELF_ORIGIN + '/og-default.png';
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [galleryJsonLd(SELF_ORIGIN, ogImage)];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={merriweather400} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="theme-color" content={inverted ? '#000000' : '#ffffff'} />
    <link rel="canonical" href={canonical} />
    {dePath && <link rel="alternate" hreflang="de" href={DE_ORIGIN + dePath} />}
    {enPath && <link rel="alternate" hreflang="en" href={EN_ORIGIN + enPath} />}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageIsDefault && <meta property="og:image:width" content="1200" />}
    {ogImageIsDefault && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Video-Poster (YouTube-Facades: Doku-Reihe, Videos-Seite) laden von i.ytimg.com —
        die Verbindung vorab aufbauen spart den Handshake beim ersten Poster. */}
    <link rel="preconnect" href="https://i.ytimg.com" />
    <ClientRouter />
    {/* "<" als Unicode-Escape serialisieren, damit kein Inhalts-String (z. B. ein Werktitel mit
        schließendem script-Tag) das Inline-Script vorzeitig beenden und Markup injizieren kann. */}
    {jsonLdItems.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
  </head>
  <body class:list={[inverted && 'theme-invert']}>
    <a href="#main" class="skip-link">{lang === 'en' ? 'Skip to content' : 'Zum Inhalt springen'}</a>
    <Header lang={lang} />
    {/* Backdrop hinter dem offenen Burger-Menü — dimmt den Rest der Seite; Klick schließt (steuert #navtoggle). */}
    <label for="navtoggle" class="nav-scrim" aria-hidden="true"></label>
    <main id="main" class:list={['site-main', layout && `site-main--${layout}`]} data-pagefind-body={noindex ? undefined : true}>
      <slot />
    </main>
    <Footer lang={lang} />
    <Search lang={lang} />
    <Lightbox lang={lang} />
    {/* Ein gebündeltes Modul für alle globalen Seiten-Skripte. Weil es aus astro:transitions/client
        importiert (gemeinsamer Chunk), EXTRAHIERT Astro es nach /_astro/<hash>.js statt es inline ins
        HTML zu legen — Content-Hash im Dateinamen = automatisches Cache-Busting, einmal geladen und
        über alle Seiten gecacht. Läuft genau EINMAL; die importierten Skripte registrieren ihre
        astro:page-load-Listener selbst und feuern nach JEDEM View-Transition-Wechsel neu. */}
    <script>
      import '../scripts/yt-facade.js';
      import '../scripts/gallery.js';
      import '../scripts/hero-autoplay.js';
      import { navigate } from 'astro:transitions/client';
      // Werk-zu-Werk-Navigation per Pfeiltasten UND Lightbox-Knöpfen (data-lb-nav). Geschlossene
      // Lightbox: durch ALLE Werke (rel=prev/next, chronologisch inkl. Ordinals). Offene Lightbox:
      // nur zwischen Werken MIT Bild (data-lb-prev/next auf .art-single, Ordinals übersprungen) —
      // die Lightbox blättert dann mit. Einmalig registriert (document bleibt über View-Transitions
      // bestehen). navigate() statt location.href, damit der sanfte Übergang greift.
      if (!window.__arrowNav) {
        window.__arrowNav = true;
        function go(right) {
          var lb = document.getElementById('lightbox');
          var url;
          if (lb && !lb.hidden) {
            // Lokale Bildgruppe (Detail-Ausschnitte) hat Vorrang: blättert in der Lightbox,
            // ohne das Werk zu wechseln.
            if (lb.__lbStep && lb.__lbStep(right)) return;
            var host = document.querySelector('[data-lb-' + (right ? 'next' : 'prev') + ']');
            url = host && host.getAttribute('data-lb-' + (right ? 'next' : 'prev'));
          } else {
            var rel = document.querySelector(right ? 'a[rel~="next"]' : 'a[rel~="prev"]');
            url = rel && rel.getAttribute('href');
          }
          if (url) navigate(url);
        }
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
          var act = document.activeElement;
          if (act && (/^(INPUT|TEXTAREA|SELECT)$/.test(act.tagName) || act.isContentEditable)) return;
          e.preventDefault();
          go(e.key === 'ArrowRight');
        });
        document.addEventListener('click', function (e) {
          var btn = e.target && e.target.closest ? e.target.closest('[data-lb-nav]') : null;
          if (btn) go(btn.getAttribute('data-lb-nav') === 'next');
        });
        // Mobil: horizontales Wischen in der OFFENEN Lightbox blättert wie die Pfeile durch die
        // Werke (Seiten ohne Werk-Kette: go() findet kein Ziel, Wischen bleibt folgenlos). Ein
        // Tap schließt weiterhin — nach einem echten Swipe feuert der Browser keinen click.
        var tx = 0;
        var ty = 0;
        document.addEventListener(
          'touchstart',
          function (e) {
            var lb = document.getElementById('lightbox');
            if (!lb || lb.hidden || !e.touches.length) return;
            tx = e.touches[0].clientX;
            ty = e.touches[0].clientY;
          },
          { passive: true },
        );
        document.addEventListener(
          'touchend',
          function (e) {
            var lb = document.getElementById('lightbox');
            if (!lb || lb.hidden || !e.changedTouches.length) return;
            var dx = e.changedTouches[0].clientX - tx;
            var dy = e.changedTouches[0].clientY - ty;
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(dx < 0);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>

<style is:global>
  /* Skip-Link: unsichtbar geparkt, erscheint nur bei Tastatur-Fokus (WCAG 2.4.1). */
  .skip-link {
    position: absolute;
    left: 8px;
    top: -48px;
    z-index: 200;
    background: #fff;
    color: #000;
    padding: 0.5rem 0.9rem;
    font-weight: 600;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 8px;
  }
  /* Ordinal-Seiten „geflippt": dunkler Header + schwarzer Body, damit die On-Chain-Bühne
     vollflächig schwarz steht (kein weißer Streifen, auch nicht über dem Footer). Die
     einzelnen Elemente werden gezielt hell gesetzt. Die Sprach-Flagge bleibt bewusst
     in Originalfarben — nur Logo/Navi/Suche werden hell. */
  body.theme-invert {
    background: #000;
    /* Material-Dark-Tokens (vererben über Style-Scope-Grenzen an Header/Gallery/ArtworkBody):
       Text als Emphasis-Stufen über Deckkraft statt fester Grautöne. */
    --on-dark-high: rgba(255, 255, 255, 0.87); /* Titel, Navi, Chip-Text */
    --on-dark-med: rgba(255, 255, 255, 0.6); /* Eyebrow, Caption, Credits */
    /* Zeilen-Trenner der offenen Mobilnavi hell (sonst schwarz auf schwarzem Panel = unsichtbar). */
    --nav-divider: rgba(255, 255, 255, 0.18);
  }
  body.theme-invert .site-header {
    background: #000;
  }
  body.theme-invert .site-logo img {
    filter: invert(1); /* schwarzes Logo → weiß */
  }
  body.theme-invert .mainnav {
    border-color: rgba(255, 255, 255, 0.35); /* die zwei Linien hell statt schwarz */
  }
  body.theme-invert .mainnav__link,
  body.theme-invert .mainnav__link:hover,
  body.theme-invert .mainnav__link.is-active,
  body.theme-invert .mainnav__search {
    color: var(--on-dark-high); /* auch der aktive „Werke"-Punkt hell (sonst schwarz auf schwarz) */
  }
  /* NEU-Pill: dunkle Schrift auf dem grauen Badge, damit sie auf dem dunklen Header wirkt. */
  body.theme-invert .mainnav__badge {
    color: #000;
  }
  /* Flagge NICHT anfassen — behält Originalfarben. */
  @media (max-width: 720px) {
    body.theme-invert .site-header__inner {
      border-bottom-color: rgba(255, 255, 255, 0.35);
    }
    /* .site-header davor: Astro scoped den Burger als Nachfahren-Selektor mit höherer
       Spezifität — sonst bleibt der Balken schwarz-auf-schwarz. */
    body.theme-invert .site-header .mainnav__burger-icon,
    body.theme-invert .site-header .mainnav__burger-icon::before,
    body.theme-invert .site-header .mainnav__burger-icon::after {
      background: #f4f4f4;
    }
    body.theme-invert .mainnav__list {
      background: #111;
      border-bottom-color: rgba(255, 255, 255, 0.35);
    }
  }
  /* YouTube-Klick-Facade: iframe erst beim Klick. */
  .yt-facade { position: relative; width: 100%; overflow: hidden; background: #000; }
  .yt-facade__btn { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; background: none; cursor: pointer; display: block; }
  .yt-facade__poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .yt-facade__play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 68px; height: 48px; background: rgba(0, 0, 0, 0.75); transition: background 0.2s; }
  .yt-facade__play::before { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-40%, -50%); border-style: solid; border-width: 11px 0 11px 19px; border-color: transparent transparent transparent #fff; }
  .yt-facade__btn:hover .yt-facade__play { background: #f00; }
</style>
