---
// Exaktes Astra-Chrome (Header/Footer/Body-Klasse) 1:1 aus dem Live-HTML + gebündelte
// WP-Design-CSS + selbst gehostete Merriweather. Seiteninhalt kommt in den <slot/>.
import chromeDe from '../data/live-chrome.json';
import chromeEn from '../data/live-chrome-en.json';
import { processChrome } from '../lib/nav';
import Search from '../components/Search.astro';
import '../styles/wp-design.css';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/700.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  lang?: 'de' | 'en';
}
const { title = 'HAUS HOPPE - Galerie für Bildende Kunst', description = '', bodyClass, lang = 'de' } = Astro.props;
const chrome = lang === 'en' ? chromeEn : chromeDe;
// Aktiven Menüpunkt setzen + Sprachumschalter aufs Pendant richten (Build-Zeit)
const { header } = processChrome(chrome.header, Astro.url.pathname, lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/media/2020/11/cropped-logo-haushoppe-490.png" />
  </head>
  <body class={bodyClass ?? chrome.bodyClass}>
    <div class="hfeed site" id="page">
      <Fragment set:html={header} />
      <div id="content" class="site-content">
        <div class="ast-container">
          <div id="primary" class="content-area primary">
            <main id="main" class="site-main" data-pagefind-body>
              <slot />
            </main>
          </div>
        </div>
      </div>
      <Fragment set:html={chrome.footer} />
    </div>
    <script is:inline src="/js/yt-facade.js"></script>
    <Search lang={lang} />
  </body>
</html>

<style is:global>
  /* YouTube-Klick-Facade (ersetzt die ayg-player-Custom-Elemente). */
  .yt-facade { position: relative; width: 100%; overflow: hidden; background: #000; }
  .yt-facade__btn { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; background: none; cursor: pointer; display: block; }
  .yt-facade__poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .yt-facade__play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 68px; height: 48px; background: rgba(0, 0, 0, 0.75); border-radius: 12px; transition: background 0.2s; }
  .yt-facade__play::before { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-40%, -50%); border-style: solid; border-width: 11px 0 11px 19px; border-color: transparent transparent transparent #fff; }
  .yt-facade__btn:hover .yt-facade__play { background: #f00; }
</style>
