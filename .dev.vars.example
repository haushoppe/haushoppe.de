# PayPal-Zugangsdaten für lokales `wrangler pages dev`.
# Kopiere diese Datei nach .dev.vars (wird NICHT committet) und trage Sandbox-Werte ein.
#
# In PRODUKTION werden die Werte pro Cloudflare-Projekt gesetzt (NICHT hier), für BEIDE Domains:
#   wrangler pages secret put PAYPAL_CLIENT_SECRET --project-name=haushoppe-de
#   wrangler pages secret put PAYPAL_CLIENT_SECRET --project-name=haushoppe-art
# PAYPAL_CLIENT_ID und PAYPAL_ENV können im Cloudflare-Dashboard als normale Variablen gesetzt
# werden (Client-ID ist per Design öffentlich); das Secret bleibt verschlüsselt.

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Turnstile (Bot-Schutz fürs Widerruf-Formular). Unten stehen die offiziellen Cloudflare-TESTKEYS
# (Widget rendert sichtbar und besteht immer) — für lokales `wrangler pages dev` einfach so lassen.
# In PRODUKTION liegen die echten Keys des Widgets „haushoppe-widerruf" in beiden Pages-Projekten.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
