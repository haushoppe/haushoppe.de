{
  "name": "haushoppe-art-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data && npm run check && npm run build:de && npm run build:art",
    "data": "npm run meta && npm run lang-alt",
    "check": "node scripts/check-i18n.mjs",
    "build:de": "SITE_LANG=de astro build && pagefind --site dist-de",
    "build:art": "SITE_LANG=en astro build && pagefind --site dist-art",
    "preview": "astro preview",
    "preview:art": "SITE_LANG=en astro preview",
    "images": "node scripts/gen-images.mjs",
    "astro": "astro",
    "meta": "node scripts/gen-artwork-meta.mjs",
    "lang-alt": "node scripts/gen-lang-alt.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/merriweather": "^5.2.11",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1",
    "purgecss": "^8.0.0",
    "sharp": "^0.34.4"
  }
}
